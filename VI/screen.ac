    add [1]
    dac cuR
    law 1
    dac cuC
    jsp scCup
    jsp scEl
    dzm i [outCol:TERM_BANK]
    jmp i stX

// scExArm -- ex's output, from now on, to the status line (scOutC).
// AC is clobbered, IO preserved.
scExArm, dac oaX
    law 1
    dac soState
    dzm soMore
    dac i [exOut:TERM_BANK]
    jmp i oaX

// scOutC -- a character of ex's output, in IO, as putc gives it. The first
// goes to the status line; a new line is held; when more follows it, the
// region is reset and the screen scrolls, every row now unknown. AC is 1
// when putc is to send the character, 0 when it is held; IO is clobbered.
scOutC, dac ocX
