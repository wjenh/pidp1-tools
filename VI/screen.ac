    idx rnM
    jmp rnL
rnE, lac rnM
    jmp i rnX

// --- entering and leaving, ex's output

// scEnter -- visual mode's screen: the options read, the screen cleared,
// every row unknown. AC and IO are clobbered.
scEnter, dac enX
    dzm scW
