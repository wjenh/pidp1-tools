eqY, law 1
    jmp i eqX
eqN, cla
    jmp i eqX

// shSA, shWA -- the address of row IO's key: shown (ROW_KEYS), or wanted
// (scWant). AC is the address; IO is clobbered.
shSA, dac saX
    dio saT
    lac saT
    add saT
    add saT
    add [ROW_KEYS]
    jmp i saX
shWA, dac waX
    dio saT
    lac saT
    add saT
    add saT
    add [scWant:SCR_BANK]
    jmp i waX

// shCp -- the key at shQ copied to shP. AC is clobbered, IO preserved.
shCp, dac cpX
    lac i shQ
    dac i shP
    idx shQ
    idx shP
    lac i shQ
    dac i shP
    idx shQ
    idx shP
    lac i shQ
    dac i shP
    jmp i cpX

// scShift -- rows that moved, moved on the screen: at the first row r that
// differs, the least s for which the rows shown from r+s are those wanted
// from r (lines deleted or scrolled off the top), or those wanted from r+s
// are those shown from r (lines inserted, scrolled on at the top), over a
// run of rows of lines: 1 row at the window's top or on a VT102, else 2. A
// VT102 deletes or inserts s lines at row r; a VT100 narrows the region to
// rows r to the window's end, then scrolls it with IND at its bottom or RI
// at its top. The keys move as the rows did; the rows left blank are
// unknown. AC and IO are clobbered.
scShift, dac shX
    dzm shR
shFind, lac shR
    SKIP_NEXT_IF_DIFFERENT scW
    jmp i shX               // every row as wanted
    lio shR
    jsp shSA
    dac eqA
    lio shR
    jsp shWA
    dac eqB
    jsp scEq
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp shGot
    idx shR
    jmp shFind
shGot, law 2
    dac shT
    lac shR
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp shT1
    lac scVt2
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp shS0
shT1, law 1
    dac shT
shS0, law 1
    dac shS
shSL, lac shR
    add shS
    sub scW
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i shX               // nothing moved
    lac shR                 // deleted: shown from r+s, wanted from r
    add shS
    dac shA
    lac shR
    dac shB
    jsp shRun
    sub shT
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp shUp
    lac shR                 // inserted: shown from r, wanted from r+s
    dac shA
    add shS
    dac shB
    jsp shRun
    sub shT
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp shDn
    idx shS
    jmp shSL

// rows r+s on move up s
shUp, lac scVt2
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp shUp1
    lac shR
    add [1]
    dac cuR
    law 1
    dac cuC
    jsp scCup
    jsp scCsi
    lio shS
    jsp scDec
    lio ['M']
    jsp i [rawc:TERM_BANK]
    jmp shUpK
shUp1, lac shR
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp shUp2
    add [1]
    dac rsT
    lac scW
    dac rsB
    jsp scRgnSet
shUp2, lac scW
    dac cuR
    law 1
    dac cuC
    jsp scCup
    lac shS
    dac shN
shUpL, lio [CH_ESC]
    jsp i [rawc:TERM_BANK]
    lio ['D']
    jsp i [rawc:TERM_BANK]
    lac shN
    sub [1]
    dac shN
    SKIP_NEXT_IF_AC_ZERO
    jmp shUpL
    lac shR
    SKIP_NEXT_IF_AC_ZERO
    jsp scWinRgn
shUpK, lac shR
    dac shI
shUpKL, lac shI
    add shS
    sub scW
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp shZ
    lio shI
    jsp shSA
    dac shP
    lac shI
    add shS
    lia
    jsp shSA
    dac shQ
    jsp shCp
    idx shI
    jmp shUpKL
// the rows from shI to the window's end unknown
shZ, lac shI
    sub scW
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i shX
    lio shI
    jsp shSA
    dac shP
    dzm i shP
    idx shI
    jmp shZ

// rows r on move down s
shDn, lac scVt2
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp shDn1
    lac shR
    add [1]
    dac cuR
    law 1
    dac cuC
    jsp scCup
    jsp scCsi
    lio shS
    jsp scDec
    lio ['L']
    jsp i [rawc:TERM_BANK]
    jmp shDnK
shDn1, lac shR
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp shDn2
    add [1]
    dac rsT
    lac scW
    dac rsB
    jsp scRgnSet
shDn2, lac shR
    add [1]
    dac cuR
    law 1
    dac cuC
    jsp scCup
    lac shS
    dac shN
shDnL, lio [CH_ESC]
    jsp i [rawc:TERM_BANK]
    lio ['M']
    jsp i [rawc:TERM_BANK]
    lac shN
    sub [1]
    dac shN
    SKIP_NEXT_IF_AC_ZERO
    jmp shDnL
    lac shR
    SKIP_NEXT_IF_AC_ZERO
    jsp scWinRgn
// the keys, from the window's end up: row i takes row i-s's
shDnK, lac scW
    sub [1]
    dac shI
shDnKL, lac shI
    sub shR
    sub shS
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp shDnZ
    lio shI
    jsp shSA
    dac shP
    lac shI
    sub shS
    lia
    jsp shSA
    dac shQ
    jsp shCp
    lac shI
    sub [1]
    dac shI
    jmp shDnKL
shDnZ, lac shR
    dac shI
    add shS
    dac shM
shDnZL, lac shI
    SKIP_NEXT_IF_DIFFERENT shM
    jmp i shX
    lio shI
    jsp shSA
    dac shP
    dzm i shP
    idx shI
    jmp shDnZL

// shRun -- how many rows from shown row shA and wanted row shB on are the
// same, each a row of a line. AC is the count; IO is clobbered.
shRun, dac rnX
    dzm rnM
rnL, lac shA
    add rnM
    dac rnA
    sub scW
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp rnE
    lac shB
    add rnM
    dac rnB
    sub scW
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp rnE
