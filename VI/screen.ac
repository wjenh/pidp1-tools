    add scN
    sub [1]
    dac ftL
    lio DOT
    jsp scFit
    dac dnT
    jsp scThird
    sub dnT
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp dnCx
dnRoll, lac scN
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp dn3
    jmp dn4
dn3, lac DOT                // rolled: the line scN on at the bottom
    add scN
    dac DOT
    lio DOT
    jsp scRows
    cma
    add scW
    dac bkC
    lio DOT
    jsp scBack
    dac scTop
dn4, lac scScr
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i dnX
    lac DOT                 // back ind lines, no higher than the top
    sub scInd
    dac DOT
    sub scTop
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp dn5
    jmp i dnX
dn5, lac scTop
    dac DOT
    jmp i dnX
dnCx0, lac DOT
    add scN
    dac DOT
    cla
    dac scN
dnCx, lac DOT
    add scN
    lia
    law CH_DOT
    dac scCtx
    jsp scContext
    jmp i dnX
scBeep0, jsp i [ringBell:TERM_BANK]
    jmp i dnX

// scUp -- 3.7's vup(scN, scInd, scScr): dot up scN lines, no further than
// line 1, as scDown, the lines scrolled on at the window's top; with scScr
// dot then goes down scInd lines, no lower than the last line shown. At line
// 1 already, the bell. AC and IO are clobbered.
scUp, dac upX
    jsp scOpts
    jsp scLayout
    lac DOT
    SKIP_NEXT_IF_DIFFERENT [1]
    jmp upBeep
    lac DOT                 // no further than line 1
    sub [1]
    dac upT
    sub scN
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp up1
    add scInd
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    cla
    dac scInd
    lac upT
    dac scN
up1, lac scDotR
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp upCx0
    lac DOT                 // vcline
    sub scTop
    dac upT
    lac scScr
    SKIP_NEXT_IF_AC_ZERO
    jmp up2
    lac upT
    sub scN
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp up2
    lac DOT                 // within the window
    sub scN
    dac DOT
    jmp i upX
up2, lac scN                // dot to the top
    sub upT
    dac scN
    lac scTop
    dac DOT
    lac scScr
    SKIP_NEXT_IF_AC_ZERO
    jmp upRoll
    lac scN
    sub scW
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp upCx
    lac DOT                 // vfit(dot - cnt, cnt)
    sub [1]
    dac ftL
    lac DOT
    sub scN
    lia
    jsp scFit
    dac upT
    jsp scThird
    sub upT
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp upCx
upRoll, lac DOT             // rolled back: the line scN up at the top
    sub scN
    dac DOT
    dac scTop
    lac scScr
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i upX
    jsp scLayout            // down ind lines, no lower than the last shown
    lac DOT
    add scInd
    dac DOT
    lac scTop
    add scCnt
    sub [1]
    dac upT
    sub DOT
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i upX
    lac upT
    dac DOT
    jmp i upX
upCx0, lac DOT
    sub scN
    dac DOT
    dzm scN
    dzm scInd
upCx, lio scW               // an ind over half the window is a third
    law 2
    dac dvD
    jsp scDiv
    sub scInd
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp up3
    jsp scThirdW
    dac scInd
up3, lac DOT
    add scInd
    sub scN
    lia
    law CH_DOT
    dac scCtx
    jsp scContext
    jmp i upX
upBeep, jsp i [ringBell:TERM_BANK]
    jmp i upX

// scThirdW -- the window's third. AC is that; IO is clobbered.
scThirdW, dac twX
    lio scW
    law 3
    dac dvD
    jsp scDiv
    jmp i twX

// scHold -- dot to line IO, which stays where it is when shown, else goes
// to the window's middle (3.7's HOLDWIG). AC and IO are clobbered.
scHold, dac hoX
    dio hoV
    jsp scOpts
    jsp scLayout
    lac hoV
    sub scTop
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp hoCx
    lac scTop               // past the last line wholly shown: the middle
    add scCnt
    sub hoV
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp .+2
    jmp hoCx
    lac hoV
    dac DOT
    jmp i hoX
hoCx, law CH_DOT
    dac scCtx
    lio hoV
    jsp scContext
    jmp i hoX

