    SKIP_NEXT_IF_AC_ZERO
    jmp ocLf
    lio [CH_ESC]
    jsp i [rawc:TERM_BANK]
    lio ['7']
    jsp i [rawc:TERM_BANK]
    jsp scCsi
    lio ['r']
    jsp i [rawc:TERM_BANK]
    lio [CH_ESC]
    jsp i [rawc:TERM_BANK]
    lio ['8']
    jsp i [rawc:TERM_BANK]
