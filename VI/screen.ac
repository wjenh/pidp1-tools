// screen.ac -- vi's screen on a VT100 or VT102: the
// window's rows kept by keys, the update that sends only what changed, the
// scrolling region, ex's output on the status line, and 3.7's rules for the
// window's top (ex_vwind.c: vmoveto's context, vup, vdown, vback, vfit).
//
// The window is rows 1 to scW (lines less one), inside the VT100's
// scrolling region; row scW+1 is the status line. scTop is the line on the
// window's first row; a line takes as many rows as its width needs, a ~ row
// is past the end, and @ rows fill the bottom when the next line does not
// fit. 3.7's vcnt (the lines wholly shown) and vcline (dot's place among
// them) follow from scTop and dot. A line partly scrolled off the top is not
// kept, as 3.7 keeps it: the top is always a line's first row.
//
// The update (scRefresh), unless keys wait to be read (scRfNow regardless,
// for a line insert mode opens): the rows wanted, as
// keys (vi.ah's ROW_KEYS), from scTop down; then, at the first row that
// differs, rows that moved are moved (IL and DL on a VT102, else the region
// narrowed to them and RI or IND); then each row whose key differs from what
// it shows is painted (CUP, EL, its text); then the cursor is placed. A
// line's width comes from its record: its length when the record is plain,
// else from its text, cached in the record's second header word (compaction's
// forwarding word, otherwise unused) while tabstop is 8: REC_MARK set, 0200000
// for list, and the text's columns.
//
// A character is shown as 3.7 shows it: a TAB as blanks to the next stop
// (^I under list), another control character or DEL as ^ and its letter;
// number puts the line's number in 6 columns and 2 blanks before it, list a $
// after it. The cursor is on the last column of its character, after the
// number on an empty line, as 3.7's vsetcurs.
//
// While exOut is set, putc gives each character of ex's output to scOutC:
// the first goes to the status line, a new line is held until more follows;
// when a second line starts, the region is reset so the whole screen
// scrolls, and scExDone reports it, for [Hit return to continue] (scHitRet).
//
// Routines are entered by jsp with the extend window open and return by jmp
// i; their arguments are named words. In bank SCR_BANK. Needs vi.ah,
// <AIDS/skipmacros.ah>, termio.ac and keys.ac (bank TERM_BANK), lines.ac
// (bank 0), options.ac (bank EX_BANK) and vmain.ac's vCurs and vPeek (bank
// VI_BANK).

local giL, gi1, gnTab, gnPend, gnChar, gnLo, gnGot, gnT, gnCtl, gnEnd, \
    gnNone, gnOut, wdL1, wdL2, wdW, wdHit, wdSum, wdFull, wdF, rwOne, coL, \
    coEnd, fcL, fcG, fcE, op1, op2, op3, op4, op5, op6, unL, scRgnSet, \
    scWinRgn, scCup, cuOne, scEl, scCsi, scDec, sdL, sdO, lyLoop, lyRec, \
    lyRk, lyDot, lyTil, lyAt, lyAtL, lyPut, rf0, rf1, rfBl, rfCx, rfLy, rfLoop, \
    rfNext, rfCur, \
    scPaint, ppText, ppSkL, ppOut, ppFl, ppG, ppSpL, ppC1, ppB, scEq, eqY, \
    eqN, shSA, shWA, shCp, scShift, shFind, shGot, shT1, shS0, shSL, shUp, \
    shUp1, shUp2, shUpL, shUpK, shUpKL, shZ, shDn, shDn1, shDn2, shDnL, \
    shDnK, shDnKL, shDnZ, shDnZL, shRun, rnL, rnE, ocTx, ocPos, ocFl, ocLf, \
    scCrLf, clfX, \
    edL, edY, edN, bkL, bk1, bkE, cxUp, cxBot, cxMid, cxSet, scFit, ftJ, ftE, \
    scThird, dn1, dn2, dnRoll, dn3, dn4, dn5, dnCx0, dnCx, scBeep0, up1, up2, \
    upRoll, upCx0, upCx, up3, upBeep, hoCx, giX, giP, giD, giV, gnX, gnG, \
    gnC, dvX, dvD, wdX, wdR, wdH, wdT, wdP, wdK, rwX, coX, fcX, fcCol, fcCp, \
    opX, opChg, clX, unX, unP, unN, rsX, rsT, rsB, csX, cuX, cuR, cuC, elX, \
    csiX, sdX, sdV, sdN, sdP, lyX, lyR, lyL, lyP, lyD, lyK, lyRc, lyKey, \
    lyKey1, lyKey2, lyKX, rfX, rfR, rfS, rfW, rfP, rfLen, rfCol, ppX, ppR, \
    ppK, ppSk, ppN, ppSp, ppC, eqX, eqA, eqB, saX, saT, waX, cpX, shX, shR, \
    shS, shT, shA, shB, shI, shM, shN, shP, shQ, rnX, rnM, rnA, rnB, rnC, \
    enX, quX, stX, oaX, ocX, ocC, ocP, ocF, edX, hrX, hrK, bkX, bkT, bkD, \
    cxX, cxA, cxD, ftX, ftT, ftC, tdX, dnX, dnT, upX, upT, twX, hoX, hoV, \
    rwP, rwW, rfC1, spL, rkL, rkS, spX, spT, rkX, rkP, rkN, ivX, shwL, shwG, \
    shwX, shwLn, shwR, shwC

// --- the glyphs of a line

// gsInit -- start the glyphs of the record whose address is in IO: with
// gsLine not 0, number's prefix first, showing gsLine; with gsDolOn set and
// list on, list's $ last. AC and IO are clobbered.
gsInit, dac giX
    dio gsP
    lac i gsP
    and [REC_LEN]
    dac gsN
    dac gsLen
    lac gsP
    add [REC_HDR]
    dac gsP
    dzm gsHalf
    dzm gsI
    dzm gsTab
    dzm gsPend
    dzm gsCol
    dzm gsTc
    dzm gsPreN
    lac scList
    dac gsLst
    and gsDolOn
    dac gsDol
    lac scTs
    dac gsTs
    lac gsLine
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i giX
// the prefix: the number right-justified in NUM_W columns, blanks to NUM_COLS
    lac [gsPre:SCR_BANK]
    dac giP
    law NUM_COLS
    dac giD
giL, law CH_SP
    dac i giP
    idx giP
    lac giD
    sub [1]
    dac giD
    SKIP_NEXT_IF_AC_ZERO
    jmp giL
    lac [gsPre:SCR_BANK]
    add [NUM_W-1]
    dac giP
    lac gsLine
    dac giV
gi1, lio giV
    law 0d10
    dac dvD
    jsp scDiv
    dac giV
    lai
    add [CH_0]
    dac i giP
    lac giP
    sub [1]
    dac giP
    lac giV
    SKIP_NEXT_IF_AC_ZERO
    jmp gi1
    lac [gsPre:SCR_BANK]
    dac gsPreP
    law NUM_COLS
    dac gsPreN
    jmp i giX

// gsNext -- the next glyph. AC is its character, or -1 past the end; gsCh is
// the index of the character it shows (-1 for the prefix, the length for
// $), gsLast 1 when it is that character's last glyph; gsCol counts the
// glyphs given. IO is clobbered.
gsNext, dac gnX
    lac gsPreN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp gnTab
    sub [1]
    dac gsPreN
    lac [0777776]
    dac gsCh
    dzm gsLast
    lac i gsPreP
    dac gnG
    idx gsPreP
    lac gnG
    jmp gnOut
// the blanks of a TAB
gnTab, lac gsTab
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp gnPend
    sub [1]
    dac gsTab
    dzm gsLast
    SKIP_NEXT_IF_AC_NOT_ZERO
    idx gsLast
    law CH_SP
    jmp gnOut
// the letter of a ^X
gnPend, lac gsPend
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp gnChar
    dac gnG
    dzm gsPend
    law 1
    dac gsLast
    lac gnG
    jmp gnOut
// the next character: the high half of a word, then the low
gnChar, lac gsN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp gnEnd
    sub [1]
    dac gsN
    lac gsI
    dac gsCh
    idx gsI
    lac gsHalf
    SKIP_NEXT_IF_AC_ZERO
    jmp gnLo
    lac i gsP
    rar 9s
    and [PK_LO]
    dac gnC
    law 1
    dac gsHalf
    jmp gnGot
gnLo, lac i gsP
    and [PK_LO]
    dac gnC
    dzm gsHalf
    idx gsP
gnGot, lac gnC
    SKIP_NEXT_IF_DIFFERENT [CH_TAB]
    jmp gnT
    SKIP_NEXT_IF_DIFFERENT [CH_DEL]
    jmp gnCtl
    sub [CH_SP]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp gnCtl
    law 1
    dac gsLast
    lac gnC
    jmp gnOut
// a TAB: blanks to the next stop, or ^I under list
gnT, lac gsLst
    SKIP_NEXT_IF_AC_ZERO
    jmp gnCtl
    lac gsTs
    sub gsTc
    sub [1]
    dac gsTab
    dzm gsLast
    SKIP_NEXT_IF_AC_NOT_ZERO
    idx gsLast
    law CH_SP
    jmp gnOut
gnCtl, lac gnC
    xor [0100]
    dac gsPend
    dzm gsLast
    law CH_CARET
    jmp gnOut
// the end: list's $, then nothing
gnEnd, lac gsDol
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp gnNone
    dzm gsDol
    lac gsI
    dac gsCh
    law 1
    dac gsLast
    law CH_DOLLAR
    jmp gnOut
gnNone, lac [0777776]
    jmp i gnX
// each glyph is a column: gsTc keeps the column within a tab stop
gnOut, dac gnG
    idx gsCol
    idx gsTc
    sub gsTs
    SKIP_NEXT_IF_AC_NEGATIVE
    dzm gsTc
    lac gnG
    jmp i gnX

// scDiv -- the number in IO, 0 to 0377777, divided by dvD. AC is the
// quotient, IO the remainder.
scDiv, dac dvX
    cla
    scl 1s
    div dvD
    hlt                     // no overflow: dvD is not 0
    jmp i dvX

// scWid -- the columns of the record whose address is in IO: number's
// prefix, its text, list's $. AC is the columns; IO is clobbered.
scWid, dac wdX
    dio wdR
    lac i wdR
    dac wdH
    and [REC_LEN]
    dac wdT
    lac wdH
    and [REC_PLAIN]
    SKIP_NEXT_IF_AC_ZERO
    jmp wdSum               // plain: its length
    lac scTs
    SKIP_NEXT_IF_SAME [TAB_STOP]
    jmp wdFull
// tabstop 8: the text's columns, cached for list on or off
    lac wdR
    add [1]
    dac wdP
    lac scList
    SKIP_NEXT_IF_AC_ZERO
    jmp wdL1
    lac [REC_MARK]
    jmp wdL2
wdL1, lac [REC_MARK 0200000]
wdL2, dac wdK
    lac i wdP
    and [REC_MARK 0200000]
    SKIP_NEXT_IF_DIFFERENT wdK
    jmp wdHit
    lio wdR
    dzm gsLine
    dzm gsDolOn
    jsp gsInit
wdW, jsp gsNext
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp wdW
    lac gsCol
    dac wdT
    ior wdK
    dac i wdP
    jmp wdSum
wdHit, lac i wdP
    and [0177777]
    dac wdT
wdSum, lac wdT
    add scPre
    add scList
    jmp i wdX
// another tabstop: the prefix moves the stops, so the whole line is walked
wdFull, lio wdR
    lac scPre
    dac gsLine
    law 1
    dac gsDolOn
    jsp gsInit
wdF, jsp gsNext
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp wdF
    lac gsCol
    jmp i wdX

// scRows -- 3.7's vdepth: the rows line IO takes, at least 1; while insert
// mode shows it, a column more for the cursor after the text.
// AC is the rows; IO is clobbered.
scRows, dac rwX
    jsp scPtr
    dac rwP
    lia
    jsp scWid
    dac rwW
    lac rwP
    sub [ED_REC]
    SKIP_NEXT_IF_AC_NOT_ZERO
    idx rwW
    lac rwW
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rwOne
    add scCols
    sub [1]
    lia
    lac scCols
    dac dvD
    jsp scDiv
    jmp i rwX
rwOne, law 1
    jmp i rwX

// scColOf -- 3.7's column(cursor): the columns line IO takes up to the end
// of its character scIdx, number's prefix included; scIdx -1 is the prefix
// alone, and an index past the end the whole line.
// AC is the column count; IO is clobbered.
scColOf, dac coX
    jsp scPtr
    lia
    lac scPre
    dac gsLine
    dzm gsDolOn
    jsp gsInit
    lac scIdx
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp coL
    lac scPre
    jmp i coX
coL, jsp gsNext
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp coEnd
    lac gsLast
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp coL
    lac gsCh
    SKIP_NEXT_IF_SAME scIdx
    jmp coL
coEnd, lac gsCol
    jmp i coX

// scShowAt -- the cursor on the last column of character scIdx of line IO,
// a line shown from scTop to dot, the screen up to date (showmatch's match,
// vinsert.ac's vaMat). AC and IO are clobbered.
scShowAt, dac shwX
    dio shwLn
    jsp scColOf
    sub [1]
    lia
    lac scCols
    dac dvD
    jsp scDiv
    add scDotR
    dac shwR
    dio shwC
shwL, lac shwLn             // up by the rows of the lines down to dot's
    SKIP_NEXT_IF_DIFFERENT DOT
    jmp shwG
    lio shwLn
    jsp scRows
    cma
    add shwR
    dac shwR
    idx shwLn
    jmp shwL
shwG, lac shwR
    add [1]
    dac cuR
    lac shwC
    add [1]
    dac cuC
    jsp scCup
    jmp i shwX

// scFindCol -- 3.7's vfindcol(scN) on line IO: the first character whose
// last column reaches scN, or the last character.
// AC is its index; IO is clobbered.
scFindCol, dac fcX
    jsp scPtr
    lia
    lac scPre
    dac gsLine
    dzm gsDolOn
    jsp gsInit
    lac scPre
    dac fcCol
    dzm fcCp
fcL, lac fcCp
    SKIP_NEXT_IF_DIFFERENT gsLen
    jmp fcE
    lac fcCol
    sub scN
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp fcE
fcG, jsp gsNext
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp fcE
    lac gsCh
    SKIP_NEXT_IF_SAME fcCp
    jmp fcG
    lac gsLast
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp fcG
    lac gsCol
    dac fcCol
    idx fcCp
    jmp fcL
fcE, lac fcCp
    SKIP_NEXT_IF_AC_ZERO
    sub [1]
    jmp i fcX

// scPtr -- lnPtr, except that while insert mode shows dot's line (scEdit)
// its record is ED_REC, the line as typed so far (vinsert.ac).
// AC is the record's address; IO is clobbered.
scPtr, dac spX
    dio spT
    lac scEdit
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp spL
    lac spT
    SKIP_NEXT_IF_SAME DOT
    jmp spL
    lac [ED_REC]
    jmp i spX
spL, lio spT
    jsp i [lnPtr:0]
    jmp i spX

// scRekey -- each row the screen shows from record scRkF now said to show
// scRkT: KEY_NONE (0) to have it painted again. AC and IO are clobbered.
scRekey, dac rkX
    lac [ROW_KEYS]
    dac rkP
    lac scW
    dac rkN
rkL, lac rkN
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp .+2
    jmp i rkX
    lac i rkP
    SKIP_NEXT_IF_SAME scRkF
    jmp rkS
    lac scRkT
    dac i rkP
rkS, lac rkP
    add [ROW_W]
    dac rkP
    lac rkN
    sub [1]
    dac rkN
    jmp rkL

// scInval -- the rows that show ED_REC painted again at the next update.
// AC and IO are clobbered.
scInval, dac ivX
    lac [ED_REC]
    dac scRkF
    dzm scRkT
    jsp scRekey
    jmp i ivX

// --- the options, the terminal's sequences

// scOpts -- the layout's options read again: the window's rows (lines less
// one), the columns, number, list, tabstop; and whether the terminal is a
// VT102. lines or columns changed clears the screen; the others make every
// row unknown. AC and IO are clobbered.
scOpts, dac opX
    dzm opChg
    lac i [oLines:EX_BANK]
    sub [1]
    SKIP_NEXT_IF_DIFFERENT scW
    jmp op1
    dac scW
    law 2
    dac opChg
op1, lac i [oColumns:EX_BANK]
    SKIP_NEXT_IF_DIFFERENT scCols
    jmp op2
    dac scCols
    law 2
    dac opChg
op2, lac i [oNumber:EX_BANK]
    SKIP_NEXT_IF_AC_ZERO
    law NUM_COLS
    SKIP_NEXT_IF_DIFFERENT scPre
    jmp op3
    dac scPre
    lac opChg
    SKIP_NEXT_IF_AC_NOT_ZERO
    law 1
    dac opChg
op3, lac i [oList:EX_BANK]
    SKIP_NEXT_IF_AC_ZERO
    law 1
    SKIP_NEXT_IF_DIFFERENT scList
    jmp op4
    dac scList
    lac opChg
    SKIP_NEXT_IF_AC_NOT_ZERO
    law 1
    dac opChg
op4, lac i [oTabStop:EX_BANK]
    SKIP_NEXT_IF_DIFFERENT scTs
    jmp op5
    dac scTs
    lac opChg
    SKIP_NEXT_IF_AC_NOT_ZERO
    law 1
    dac opChg
op5, dzm scVt2
    lac i [oTerm:EX_BANK]
    SKIP_NEXT_IF_DIFFERENT [TERM_VT102]
    idx scVt2
    lac opChg
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i opX
    SKIP_NEXT_IF_DIFFERENT [1]
    jmp op6
    jsp scClr
    jmp i opX
op6, jsp scUnk
    jmp i opX

// scClr -- the screen cleared, every row unknown, the region to be set
// again. AC and IO are clobbered.
scClr, dac clX
    jsp scCsi
    lio ['H']
    jsp i [rawc:TERM_BANK]
    jsp scCsi
    lio ['2']
    jsp i [rawc:TERM_BANK]
    lio ['J']
    jsp i [rawc:TERM_BANK]
    jsp scUnk
    dzm scRgn
    jmp i clX

// scUnk -- every row of the window unknown. AC is clobbered, IO preserved.
scUnk, dac unX
    lac [ROW_KEYS]
    dac unP
    law ROW_MAX
    dac unN
unL, dzm i unP
    lac unP
    add [ROW_W]
    dac unP
    lac unN
    sub [1]
    dac unN
    SKIP_NEXT_IF_AC_ZERO
    jmp unL
    jmp i unX

// scRgnSet -- the scrolling region, rows rsT to rsB; the cursor goes home.
// AC and IO are clobbered.
scRgnSet, dac rsX
    jsp scCsi
    lio rsT
    jsp scDec
    lio [CH_SEMI]
    jsp i [rawc:TERM_BANK]
    lio rsB
    jsp scDec
    lio ['r']
    jsp i [rawc:TERM_BANK]
    jmp i rsX

// scWinRgn -- the region the window's rows, 1 to scW. AC and IO are
// clobbered.
scWinRgn, dac csX
    law 1
    dac rsT
    lac scW
    dac rsB
    jsp scRgnSet
    law 1
    dac scRgn
    jmp i csX

// scCup -- the cursor to row cuR, column cuC, both from 1.
// AC and IO are clobbered.
scCup, dac cuX
    jsp scCsi
    lio cuR
    jsp scDec
    lac cuC
    SKIP_NEXT_IF_DIFFERENT [1]
    jmp cuOne
    lio [CH_SEMI]
    jsp i [rawc:TERM_BANK]
    lio cuC
    jsp scDec
cuOne, lio ['H']
    jsp i [rawc:TERM_BANK]
    jmp i cuX

// scEl -- erase to the line's end. AC and IO are clobbered.
scEl, dac elX
    jsp scCsi
    lio ['K']
    jsp i [rawc:TERM_BANK]
    jmp i elX

// scCsi -- ESC [. AC and IO are clobbered.
scCsi, dac csiX
    lio [CH_ESC]
    jsp i [rawc:TERM_BANK]
    lio [CH_LBRK]
    jsp i [rawc:TERM_BANK]
    jmp i csiX

// scDec -- the number in IO, 0 to 0377777, in decimal. AC and IO are
// clobbered.
scDec, dac sdX
    dio sdV
    dzm sdN
    lac [sdBuf:SCR_BANK]
    dac sdP
sdL, lio sdV
    law 0d10
    dac dvD
    jsp scDiv
    dac sdV
    lai
    add [CH_0]
    dac i sdP
    idx sdP
    idx sdN
    lac sdV
    SKIP_NEXT_IF_AC_ZERO
    jmp sdL
sdO, lac sdP
    sub [1]
    dac sdP
    lio i sdP
    jsp i [rawc:TERM_BANK]
    lac sdN
    sub [1]
    dac sdN
    SKIP_NEXT_IF_AC_ZERO
    jmp sdO
    jmp i sdX

// --- the layout and the update

// scLayout -- the keys wanted for the window's rows, from scTop down, into
// scWant; scCnt the lines wholly shown (3.7's vcnt); scDotR the row dot's
// line starts on, -1 when it is not shown. AC and IO are clobbered.
scLayout, dac lyX
    dzm lyR
    lac scTop
    dac lyL
    dzm scCnt
    lac [0777776]
    dac scDotR
    lac [scWant:SCR_BANK]
    dac lyP
lyLoop, lac lyR
    SKIP_NEXT_IF_DIFFERENT scW
    jmp i lyX
    lac lyL
    sub DOL
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp lyTil
    lio lyL
    jsp scRows
    dac lyD
    add lyR
    sub scW
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp lyAt
    lac lyL
    SKIP_NEXT_IF_DIFFERENT DOT
    jmp lyDot
lyRec, lio lyL
    jsp scPtr
    dac lyRc
    dzm lyK
lyRk, lac lyRc
    dac lyKey
    lac lyK
    dac lyKey1
    dzm lyKey2
    lac scPre
    SKIP_NEXT_IF_AC_ZERO
    lac lyL
    dac lyKey2
    jsp lyPut
    idx lyK
    SKIP_NEXT_IF_SAME lyD
    jmp lyRk
    idx lyL
    idx scCnt
    jmp lyLoop
lyDot, lac lyR
    dac scDotR
    jmp lyRec
lyTil, law KEY_TILDE
    dac lyKey
    dzm lyKey1
    dzm lyKey2
    jsp lyPut
    jmp lyLoop
// the next line does not fit: @ rows to the window's end
lyAt, law KEY_AT
    dac lyKey
    dzm lyKey1
