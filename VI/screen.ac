    dac soState
    cla
    jmp i ocX
ocTx, law 1
    jmp i ocX
// the first: the status line
ocPos, dac ocP
    jsp scStat
    law 2
    dac soState
    jmp i ocP
// a held new line, sent: the first time, the region reset (the cursor
// saved around it, as setting it homes the cursor)
