// exops.ac -- ex's line commands, as 3.7's ex_cmds.c and ex_cmdsub.c do
// them: a i c, d ya pu, co t m, j, < >, k mark, p l nu # =, z and ^D, u,
// q x wq w, ve; text input (ex_get.c's gettty, with autoindent), the
// printing of lines (ex_put.c), and the reports of lines changed (killcnt,
// netchange). A command is reached by jmp from the dispatch (excmd.ac) and
// goes back to exNext; the routines are entered by jsp and return by jmp i.
// In bank EX_BANK. Needs vi.ah, <AIDS/skipmacros.ah>, excmd.ac, exaddr.ac,
// options.ac, lines.ac and heap.ac (bank 0), termio.ac and messages.ac,
// files.ac (fiNoMore, fiXit, fiWq, fiWrite).

#define Z_EOF       0777                  // z's op for ^D: no character is it

local caGo, cdR, cyR, cyMem, cpN, cpP, cpR, cpGo, cmIsC, cmGo, cmMk, cmMk2, \
    cmT, cmHave, cmErr, cmE1, cmE2, stFull, cjC, cjGo, cjG, cjA, cjS, cjP, \
    cjCh, cjL, cjWh, cjSkip, cjCp, cjNext, cjEnd, cjOut, cjDel, cjMem, csC, \
    csN, csCnt, csGo, csW, csA, csL, csI, csS, csLt, csNew, csG, csCp, csP, \
    csCh, csPut, csPL, csMk, csNext, csEnd, csLong, ckC, ckOk, ckSet, cPr0, \
    cdE, cdNe, cdZ, zEof, zHadpr, czGo, czW, czEx, czC, czOp, czEo, czUp, \
    czRep, czNx, czDig, czLn, czDL, czDE, czNoD, czScr, czScr2, czSetL, \
    czSet, czS2, czDot, czDone, z2S, z2Eof, z2Pl, z2Def, z2Mid, z2M1, z2M2, \
    z2Up, z2U1, z2Fix, z2F1, z2F2, z2F3, z2Pr, z2Lines, z2AtE, z2AtZ, \
    z2Bot, z2Top, z2F4, z2F5, cuC, cuNet, cuErr, cuE1, cuE2, cuE3, cqEol, \
    cqGo, cqNm, aiflag, lastin, atX, atL, atMem, gtX, gtC, gtUp, gtOff, \
    gtAi, gtD, gtCase, gtUp0, gtUnget, gtDot, gtNl, gtAiE, gtRd, gtLoop, gtN, \
    gtL, gtP, gtLong, gtEnd, gtS, gtD0, gtSm, gtSp, gtTb, gtSmN, gtInd, \
    gtCp, gtCh, gtFin, gtEof, gtLine, gtTbX, siX, siN, wcX, wcC, wcI, wcP, \
    wcL, wcSp, wcTb, wcN, ntX, ntC, ntGo, ntL, btX, btI, btGo, btL, idX, \
    idN, idK, idT, idT1, idS, idS1, idPut, idPC, ipX, idP, mlX, mlA, mlS, \
    mlL, mlAdd, spX, spN, sp40, spGo, spL, spE, spE2, d0X, ryX, kdX, kcX, \
    kcN, kcGo, kcP, kcL, kcE, kcD, kcEnd, ncX, ncI, ncW, ncMore, ncS, ncDo, \
    pxX, pxL, pxLoop, pxN, plA, plB, plMove, p1X, p1N, p1Txt, p1K, p1L, \
    p1P, p1E, pcX, pcC, pcCtl, pcTab, pcSelf, sbX, sbC, sbDo, appTty, \
    getTty, gtTab, setIn, whiteCnt, backTab, indent, mult, \
    delete0, yankReg, killed, killCnt, pLines, putCh, gtEf, \
    slobber, splitIt, stErr

// cAppend -- a: text after the line addressed.
cAppend, jsp setDot
    jsp exclam
    dac aiflag
    jsp newLine
    lac addr1
    dac LNA
    jsp i [lnDelNone:0]
    lio addr2
    jsp setIn
    lio addr2
    jmp caGo
// cInsert -- i: text before it.
cInsert, jsp setDot
    jsp nonZero
    jsp exclam
    dac aiflag
    jsp newLine
    lac addr1
    dac LNA
    jsp i [lnDelNone:0]
    lio addr2
    jsp setIn
    lac addr2
    sub [1]
    lia
// as 3.7's nochng, what is typed is not printed again
caGo, jsp appTty
    lac CHNG
    dac lchng
    jmp exNext

// cChange -- c: the lines deleted, text in their place.
cChange, jsp exclam
    dac aiflag
    jsp setCNL
    lio addr1
    jsp setIn
    jsp delete0
    lac addr1
    sub [1]
    lia
    jmp caGo

// cDelete -- d: the lines deleted, into a register first when one is named.
cDelete, jsp cmdReg
    dac cdR
    jsp setCNL
    lac cdR
    SKIP_NEXT_IF_AC_ZERO
    jsp yankReg
    jsp delete0
    lac addr1
    dac LNA
    jsp i [lnAppNone:0]
    jmp exNext

// cYank -- ya: the lines into a register, or into undo's list for pu.
cYank, jsp cmdReg
    dac cdR
    jsp setCount
    jsp eol
    lac cdR
    SKIP_NEXT_IF_AC_ZERO
    jmp cyR
    lac addr1
    dac LNA
    lac addr2
    dac LNB
    jsp i [lnSave:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp cyMem
    dzm i [undKind:0]       // UND_NONE: a yank is not undone
    jsp killed
    jmp exNext
cyR, jsp yankReg
    jmp exNext
cyMem, lac [mOutUndo:MSG_BANK]
    jmp exErr

// cPut -- pu: a register's lines, or undo's list, after the line.
cPut, jsp setDot
    jsp cmdReg
    dac cdR
    jsp eol
    law CP_LIST
    dac i [cpSrc:0]
    lac cdR
    SKIP_NEXT_IF_AC_ZERO
    jmp cpR
// undo's list: as 3.7's put, the change in lines reported
    lio i [undList:0]
    jsp i [lsLen:0]
    dac cpN
    dzm i [cpSlot:0]
    lac addr2
    dac LNA
    cli
    jsp i [lnAppStart:0]
    jsp i [lnCopyIn:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp stErr
    law UND_PUT
    dac i [undKind:0]
    lio cpN
    jsp netChange
    jmp exNext
// a register: as 3.7's putreg, its lines counted
cpR, lac addr1
    dac LNA
    jsp i [lnDelNone:0]
    jsp i [lnAppNone:0]
    lio cdR
    jsp i [rgSlot:0]
    dac i [cpSlot:0]
    dac cpP
    lac i cpP
    SKIP_NEXT_IF_AC_ZERO
    jmp cpGo
    lac cdR
    dac i [msgC:MSG_BANK]
    lac [mNoReg:MSG_BANK]
    jmp exErr
cpGo, lac addr2
    dac LNA
    cli
    jsp i [lnAppStart:0]
    jsp i [lnCopyIn:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp stErr
    lio i [cpCnt:0]
    jsp killCnt
    jmp exNext

// cCopy, cMove -- co and t, m: 3.7's move.
cCopy, jsp setDot
    law 1
    dac cmIsC
    jmp cmGo
// m: '' where the lines were, as 3.7's markpr; past the last line 3.7's
// table names no line, and the mark is left naming none
cMove, jsp setDot1
    dzm cmIsC
    lac addr2
    SKIP_NEXT_IF_SAME DOT
    jmp cmMk2
    lac addr1
    sub [1]
    jmp cmMk
cmMk2, lac addr2
    add [1]
    dac cmT
    sub DOL
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    dzm cmT
    lac cmT
cmMk, lia
    jsp i [lnMarkPrev:0]
cmGo, jsp nonZero
    jsp address
    dac cmT
    lai
    SKIP_NEXT_IF_AC_ZERO
    jmp cmHave
    lac [cmdName:EX_BANK]
    dac i [msgS:MSG_BANK]
    lac [mWhere:MSG_BANK]
    jmp exErr
cmHave, jsp newLine
    lac addr1
    dac LNA
    lac addr2
    dac LNB
    lac cmT
    dac LNT
    lio cmIsC
    jsp i [lnMove1:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp cmErr
    jsp killed
    jmp exNext
cmErr, SKIP_NEXT_IF_DIFFERENT [ST_NOTHING]
    jmp cmE1
    SKIP_NEXT_IF_DIFFERENT [ST_MOVED]
    jmp cmE2
    jmp stErr
cmE1, lac [mNothing:MSG_BANK]
    jmp exErr
cmE2, lac [mMoved:MSG_BANK]
    jmp exErr

// stErr -- ST_MEM or ST_FULL, in AC, as its error. Reached by jmp.
stErr, SKIP_NEXT_IF_DIFFERENT [ST_FULL]
    jmp stFull
    lac [mOutMem:MSG_BANK]
    jmp exErr
stFull, lac [mTooMany:MSG_BANK]
    jmp exErr

// cJoin -- j: the lines joined, with 3.7's blanks between them unless j!.
cJoin, jsp exclam
    dac cjC
    jsp setCount
    jsp nonZero
    jsp newLine
    lac given
    sub [2]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp cjGo
    lac addr2
    SKIP_NEXT_IF_DIFFERENT DOL
    jmp cjGo
    idx addr2
cjGo, dzm cjG               // GENBUF's length
    lac addr1
    dac cjA
cjL, lio cjA
    jsp i [lnPtr:0]
    lia
    jsp i [getLine:0]
    dzm cjS                 // the place in LINEBUF
    lac cjA
    SKIP_NEXT_IF_DIFFERENT addr1
    jmp cjCp
    lac cjC
    SKIP_NEXT_IF_AC_ZERO
    jmp cjCp
// after the first, unless j!: its leading blanks dropped, and when there is
// text on both sides, a blank between, two after a period, none before a )
cjWh, lac cjS
    add [LINEBUF]
    dac cjP
    lac i cjP
    SKIP_NEXT_IF_DIFFERENT [CH_SP]
    jmp cjSkip
    SKIP_NEXT_IF_DIFFERENT [CH_TAB]
    jmp cjSkip
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp cjCp
    dac cjCh
    lac cjG
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp cjCp
    add [GENBUF-1]
    dac cjP
    lac i cjP
    SKIP_NEXT_IF_DIFFERENT [CH_SP]
    jmp cjCp
    SKIP_NEXT_IF_DIFFERENT [CH_TAB]
    jmp cjCp
    lac cjCh
    SKIP_NEXT_IF_DIFFERENT [')']
    jmp cjCp
    lac cjG
    add [GENBUF]
    dac cjP
    law CH_SP
    dac i cjP
    idx cjG
    lac cjP
    sub [1]
    dac cjP
    lac i cjP
    SKIP_NEXT_IF_SAME [CH_DOT]
    jmp cjCp
    lac cjG
    add [GENBUF]
    dac cjP
    law CH_SP
    dac i cjP
    idx cjG
    jmp cjCp
cjSkip, idx cjS
    jmp cjWh
// the line's text, held to 3.7's length
cjCp, lac cjS
    add [LINEBUF]
    dac cjP
    lac i cjP
    dac cjCh
    lac cjG
    add [GENBUF]
    dac cjP
    lac cjCh
    dac i cjP
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp cjNext
    idx cjS
    idx cjG
    sub [LB_SIZE-1]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp cjCp
    lac [mJoinLong:MSG_BANK]
    jmp exErr
cjNext, lac cjA
    SKIP_NEXT_IF_DIFFERENT addr2
    jmp cjEnd
    idx cjA
    jmp cjL
// the lines deleted, then the joined line put in their place
cjEnd, jsp delete0
    lac cjG
    dac LBLEN
    dzm cjS
cjOut, lac cjS
    add [GENBUF]
    dac cjP
    lac i cjP
    dac cjCh
    lac cjS
    add [LINEBUF]
    dac cjP
    lac cjCh
    dac i cjP
    lac cjS
    SKIP_NEXT_IF_DIFFERENT cjG
    jmp cjDel
    idx cjS
    jmp cjOut
cjDel, lac addr1
    sub [1]
    dac LNA
    cli
    jsp i [lnAppStart:0]
    jsp i [putLine:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp cjMem
    lia
    jsp i [lnInsert:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp stErr
    jmp exNext
cjMem, law ST_MEM
    jmp stErr

// cShift -- < and >: the lines shifted by shiftwidth, once for each < or >.
cShift, lac cmdName
    dac csC
    law 1
    dac csN
csCnt, jsp peekChar
    SKIP_NEXT_IF_SAME csC
    jmp csGo
    jsp ignChar
    idx csN
    jmp csCnt
csGo, jsp setCNL
    lac addr1
    dac LNA
    lac addr2
    dac LNB
    jsp i [lnSave:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp cyMem
    law UND_CHANGE
    dac i [undKind:0]
    lac csN
    dac mlB
    lio oShiftW
    jsp mult
    dac csW                 // the columns to shift by
    lac addr1
    dac csA
csL, lac csA
    dac DOT
    lio csA
    jsp i [lnPtr:0]
    lia
    jsp i [getLine:0]
    jsp whiteCnt
    dac csI                 // the indent's columns
    dio csS                 // where the text starts
    lac csC
    SKIP_NEXT_IF_SAME [CH_GT]
    jmp csLt
    lac LBLEN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp csNext
    lac csI
    add csW
    jmp csNew
csLt, lac csI
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp csNext
    sub csW
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    cla
// the new indent in GENBUF, then the text, the whole into LINEBUF
csNew, dac csG
    lac [GENBUF]
    dac idDst
    lio csG
    jsp indent
    dac csG                 // GENBUF's length
    add LBLEN
    sub csS
    sub [LB_SIZE-2]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp csLong
csCp, lac csS
    add [LINEBUF]
    dac csP
    lac i csP
    dac csCh
    lac csG
    add [GENBUF]
    dac csP
    lac csCh
    dac i csP
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp csPut
    idx csS
    idx csG
    jmp csCp
csPut, lac csG
    dac LBLEN
    dzm csS
csPL, lac csS
    add [GENBUF]
    dac csP
    lac i csP
    dac csCh
    lac csS
    add [LINEBUF]
    dac csP
    lac csCh
    dac i csP
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp csMk
    idx csS
    jmp csPL
csMk, jsp i [putLine:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp cjMem
    dac i [lnR:0]
    lio csA
    jsp i [lnPutMark:0]
csNext, lac csA
    SKIP_NEXT_IF_DIFFERENT addr2
    jmp csEnd
    idx csA
    jmp csL
csEnd, jsp killed
    jmp exNext
csLong, lac [mShiftLong:MSG_BANK]
    jmp exErr

// cMarkK, cMark -- k and mark: 3.7's casek.
cMarkK,
cMark, jsp pastWh
    jsp getChar
    dac ckC
    lia
    jsp endCmd
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ckOk
    lac [cmdName:EX_BANK]
    dac i [msgS:MSG_BANK]
    lac [mMarkWhat:MSG_BANK]
    jmp exErr
ckOk, jsp newLine
    lio ckC
    jsp isLower
    SKIP_NEXT_IF_AC_ZERO
    jmp ckSet
    lac [mBadMark:MSG_BANK]
    jmp exErr
ckSet, jsp setDot
    jsp nonZero
    lac addr2
    dac LNA
    lac ckC
    sub ['a']
    lia
    jsp i [lnMarkSet:0]
    jmp exNext

// cPrint, cList, cNumber, cNumberIt -- p, l, nu and #: the lines in the
// flavor asked for, which lasts until the next command's flags.
cList, jsp setCNL
    law 1
    dac listf
    jmp cPr0
cNumber,
cNumberIt, jsp setCNL
    law 1
    dac numbf
    jmp cPr0
cPrint, jsp setCNL
cPr0, dzm pflag
// exPrint -- 3.7's print: label: the lines addressed typed, dot the last.
// exPrint1 skips the check that the first is not line 0.
exPrint, jsp nonZero
exPrint1, lac addr1
    dac plA
    lac addr2
    dac plB
    law 1
    dac plMove
    jsp pLines
    jmp exNext

// cEquals -- =: the line's number, the last's when none is given.
cEquals, jsp newLine
    jsp setAll
    lio addr2
    jsp i [putDec:TERM_BANK]
    jsp i [newline:TERM_BANK]
    jmp exNext

// cCtlD -- ^D alone on a command line: 3.7's EOF, the next scroll's worth
// of lines; after an address, a new line first, as ^D does not echo one.
cCtlD, lac addr2
    SKIP_NEXT_IF_DIFFERENT [ADDR_NONE]
    jmp cdE
    jsp i [newline:TERM_BANK]
cdE, lac DOL
    SKIP_NEXT_IF_AC_ZERO
    jmp cdZ
    lac addr2
    SKIP_NEXT_IF_SAME [ADDR_NONE]
    jmp cdNe
    jsp i [newline:TERM_BANK]
cdNe, jsp notEmpty
cdZ, law 1
    dac zEof
    lac hadpr
    dac zHadpr
    jmp czGo
// cZ -- z: a window of lines, 3.7's zop: z[!][+-^=.]...[count][flags].
cZ, dzm zEof
    dzm zHadpr
czGo, jsp notEmpty
    dzm czW                 // 3.7's zweight
    dzm czEx
    lac zEof
    SKIP_NEXT_IF_AC_ZERO
    jmp czEo
    jsp exclam
    dac czEx
    jsp getChar
    dac czC
    dac czOp
    SKIP_NEXT_IF_DIFFERENT [CH_CARET]
    jmp czUp
    SKIP_NEXT_IF_DIFFERENT [CH_MINUS]
    jmp czRep
    SKIP_NEXT_IF_DIFFERENT [CH_PLUS]
    jmp czRep
    SKIP_NEXT_IF_DIFFERENT [CH_EQ]
    jmp czNx
    SKIP_NEXT_IF_DIFFERENT [CH_DOT]
    jmp czNx
    dzm czOp
    jmp czDig
czEo, law Z_EOF
    dac czC
    dac czOp
    jmp czDig
czUp, law 1
    dac czW
czRep, jsp peekChar
    SKIP_NEXT_IF_SAME czOp
    jmp czNx
    jsp ignChar
    idx czW
    jmp czRep
czNx, jsp getChar
    dac czC
// a count: the window option, and the lines typed
czDig, lio czC
    jsp isDigit
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp czNoD
    lac czC
    sub ['0']
    dac czLn
czDL, jsp getChar
    dac czC
    lia
    jsp isDigit
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp czDE
    lac czLn
    sub [COUNT_CAP]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp czDL                // held
    lac czLn
    ral 2s
    add czLn
    ral 1s
    add czC
    sub ['0']
    dac czLn
    jmp czDL
czDE, lac czLn
    dac oWindow
    lac czOp
    SKIP_NEXT_IF_SAME [CH_EQ]
    jmp czSet
    lac czLn
    add [2]
    dac czLn
    jmp czSet
// no count: scroll for ^D, a screen less one for z!, else two scrolls
czNoD, lac czOp
    SKIP_NEXT_IF_DIFFERENT [Z_EOF]
    jmp czScr
    lac czEx
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp czScr2
    lac oLines
    sub [1]
    jmp czSetL
czScr, lac oScroll
    jmp czSetL
czScr2, lac oScroll
    ral 1s
czSetL, dac czLn
czSet, lac czC
    SKIP_NEXT_IF_DIFFERENT [Z_EOF]
    jmp czS2
    jsp unGetChar
    jsp newLine
// with no address and no op, the line after dot
czS2, lac addr2
    dac addr1
    SKIP_NEXT_IF_SAME [ADDR_NONE]
    jmp czDot
    lac czOp
    SKIP_NEXT_IF_AC_ZERO
    jmp czDot
    lac DOT
    sub DOL
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp czDot
    lac DOT
    add [1]
    dac addr1
    dac addr2
czDot, jsp setDot
// 3.7's zop2
    dzm z2S                 // the split line, 0 for none
    lac czOp
    SKIP_NEXT_IF_DIFFERENT [Z_EOF]
    jmp z2Eof
    SKIP_NEXT_IF_DIFFERENT [CH_PLUS]
    jmp z2Pl
    SKIP_NEXT_IF_DIFFERENT [CH_EQ]
    jmp z2Mid
    SKIP_NEXT_IF_DIFFERENT [CH_DOT]
    jmp z2Mid
    SKIP_NEXT_IF_DIFFERENT [CH_CARET]
    jmp z2Up
    SKIP_NEXT_IF_DIFFERENT [CH_MINUS]
    jmp z2Up
    jmp z2Def
z2Eof, lac addr2
    SKIP_NEXT_IF_DIFFERENT DOL
    jmp z2AtE
z2Pl, lac addr2
    SKIP_NEXT_IF_DIFFERENT DOL
    jmp z2AtZ
    lac czLn
    dac mlB
    lio czW
    jsp mult
    add addr2
    dac addr2
    sub DOL
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp z2Bot
    idx addr2
z2Def, lac addr2
    dac addr1
    add czLn
    sub [1]
    dac addr2
    dac DOT
    jmp z2Fix
z2Mid, lac czLn
    sub [1]
    sar 1s
    dac czLn
    lac czOp
    SKIP_NEXT_IF_SAME [CH_EQ]
    jmp z2M1
    lac czLn
    sub [1]
    dac czLn
z2M1, lac addr2
    sub czLn
    dac addr1
    lac czOp
    SKIP_NEXT_IF_SAME [CH_EQ]
    jmp z2M2
    lac addr2
    dac DOT
    dac z2S
z2M2, lac addr2
    add czLn
    dac addr2
    lac czOp
    SKIP_NEXT_IF_SAME [CH_DOT]
    jmp z2Fix
    jsp markDot
    lac addr2
    dac DOT
    jmp z2Fix
z2Up, lac czLn
    dac mlB
    lio czW
    jsp mult
    cma
    add addr2
    dac addr2
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp z2U1
    jmp z2Top
z2U1, sub czLn
    add [1]
    dac addr1
    lac addr2
    dac DOT
// the window kept within the buffer
z2Fix, lac addr1
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp z2F1
    law 1
    dac addr1
z2F1, lac addr2
    sub DOL
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp z2F2
    jmp z2F3
z2F2, lac DOL
    dac addr2
z2F3, lac DOT
    sub DOL
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp z2F4
    jmp z2F5
z2F4, lac DOL
    dac DOT
z2F5, lac addr2
    sub addr1
