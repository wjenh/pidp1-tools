// files.ac -- ex's files: the names, the
// volumes, reading and writing, w>>, the file commands e ex edit r f n args
// rew so rec w wq x format, autowrite, DR:EXRC at the greeting, the save of a
// lost caller's buffer and :recover, paper tape and the printer; for
// :ta (subst.ac), the tags files read and the tag's file compared.
// 3.7's ex_io.c and ex_cmds2.c are the model: filename, getargs, getone, rop,
// wop, edfile, getfile, putfile, iostats, source, next, nomore, erewind,
// makargs, pargs, ckaw.
//
// A name is dev:name.ext, the devices DT1: to DT8:, DR:, PC: and LP:, letters
// taken as upper case. name.ext is the library's name "NAME EXT", the two
// subnames with a blank between, as TECO's second set stores them, within
// LIB_MAX characters. No device is the current file's device, DR: when that
// is none or PC: or LP:. Every name kept (FN_CUR, FN_ALT, FN_FILE, FN_CUT,
// the argument list) is in the full form, so % and # expand to it.
//
// The drum's volume is mounted once for each caller; a tape's again for
// every command, so a tape changed on its drive is seen, except while a
// source file on that drive is being read. A file is read STG_BLKS blocks at
// a time through STG_BUF and split into lines at CR, an LF just after a CR
// dropped and a lone LF also ending a line; NUL and the eighth bit are
// dropped. It is written through the scratch file VI  OUT, renamed over the
// old one, or with no room for both in the old one's room.
//
// Handlers are reached by jmp from ex's dispatch (cmdTab, excmd.ac) or from
// exops.ac (fiWrite, fiWq, fiXit) and end by jmp i [exNext:EX_BANK]; an
// error is jmp i [exErr:EX_BANK] with its message's full address in AC.
// Routines are entered by jsp with the extend window open and return by jmp
// i. In bank FILE_BANK; its data words follow its code. Needs vi.ah,
// <AIDS/skipmacros.ah>, <FILESYSTEM/fs.ah>, <MICROTAPE/microtape.ah>,
// <DRUM/drum.ah>; fslib.ac (bank FS_BANK); messages.ac (bank MSG_BANK);
// ptape.ac and lpt.ac (this bank); lines.ac (bank 0); termio.ac (bank
// TERM_BANK); and in bank
// EX_BANK excmd.ac's input and helpers, exaddr.ac's setters and the
// options.

#define ADDR1        i [addr1:EX_BANK]
#define ADDR2        i [addr2:EX_BANK]
// getargs' limit: 3.7's genbuf, LBSIZE-2, less its "echo ".
#define GA_MAX       0d1018

local edF, edDo, fiQuick, rdF, fiBadNm, nxA, rwE, agL, ag1, ag2, ag3, agE, \
    agCur, acY, soPerm, soFail, soMsg, soNest, rcE, rc1, rc2, rc3, wq1, wq2, \
    wqQuit, nm1, fiFilename, fnNoF, fnCur, fnW, fnAD, fnArg, fnHas, fnAlt, \
    fnF, fnE, fnSet, fnPr, fnPr1, fnF1, fnF2, fnNone, fnF3, fiGetArgs, gaPl, \
    gaPw, gaArgs, gaL, gaPut, gaBsl, gaBq, gaHash, gaHs, gaPct, gaPc, gaFx, \
    gaFl, gaEnd, gaNone, gaPLong, gaOne, gaOvf, fiIsSp, isY, fiOne, g1Miss, \
    g1Go, g1Many, fiWord, wdS, wdE, wdR, wdNx, fnParse, npScan, npDev, npUnk, \
    npD2c, npD2P, npD2L, npD3c, npDvOk, npNoDev, npName, npNl, npE2, npSt, \
    npNDot, npLong, npBad, npNe, npNoNm, npPack, npPl, npFull, npFDr, npFPc, \
    npFLp, npF2, npFC, npFl, npFz, npGet, ngR, npPut, fiMkArgs, maL, maC, maE, \
    maOvf, fiErew, fiNext, nx1, nx2, nx3, fiRop, roNoEnt, roPerm, ftoX, \
    ftoNo, ftlX, ftfX, ftfOth, \
    roPc, roOpen, roMode, roNd, roRoS, roAd, roSd, roRd, roSt, roE, roClip, \
    roA, roOth, roIn, roPat, roUnd, fiTooBig, fiRdInit, fiAppend, apL, apFull, \
    fiGetLn, glL, glNoCR, glCR, glEnd1, glEnd, glEof, glNone, glLong, fiRdCh, \
    rcVol, rcHi, rcW, fiStats, stV, stC, stNl, fiInject, ijR, ijR2, ijP, \
    ijRest, ijB, ijCut, ijEnd, ijPut, fiWop, wp1, wpGt, wp2, wp3, \
    wpCur, wpC1, wpChk, wpEx, wpDev, wpCase, wpEd, wpEdf, wpNotEd, wpRoF, \
    wpCut, wpApp, wpRo, wpPerm, wpGo, wpNew, wpSt, wpRest, fiEdfile, efNot, \
    efPart, fiPutFile, pfNew, pfRet, pfPc, pfLp, fiLines, flL, flC, flE, \
    fiSize, szL, sz1, szE, fiNewVol, nv1, nvR27, nvWr, nvOk, nvSt0, nvSt, \
    nvFull, fiAppVol, avRoom, avFull, avSt, avSeek, wrInit, wcLo, wrEnd, wn1, \
    wrFlush, fiMount, mnOk, mnTape, mnT1, fiOpenN, fiCreate, fiErr, fiStMsg, \
    smNr, smLk, smBd, smEx, smNf, smDf, smFull, smTf, smRo, smDr, smNm, \
    soOpen, slL, slNc, slFull, slCR, slEnd, slLong, slEof, soCh, shL, shHi, \
    soLong, soCopy, scpL, scpX, soRn, soQ, soQ2, soK, \
    shW, shErr, fiInitBuf, fiNoChng, fiQName, strCpy, scL, strEq, seL, seYes, \
    seNo, inX, fnX, gaX, goX, isX, g1X, wdX, npX, ngX, npuX, maX, erX, nxX, \
    ckX, acX, nmX, roX, tbX, riX, apX, glX, rcX, stX, ijX, ipX, wpX, efX, pfX, \
    peX, pleX, flX, szX, nvX, avX, asX, wiX, wcX, weX, wnX, wfX, mnX, oiX, \
    cvX, smX, sxX, sooX, slX, shX, ibX, ncX, qnX, scX, seX, edC, fnComm, fnC, \
    fnI, gaP, gaN, gaC, gaF, isC, g1W, wdP, wdB, npP, npQ, npC, npD1, npD2, \
    npK, npDot, npN1, npN2, npB, npL, npI, ngC, maN, maD, maS, maT, nxC, agP, \
    agI, agT, roC, roRo, roAddr, glP, glN, glC, ijS, ijE, ijD, wqQ, woF, woC, \
    woE, woNe, woRo, woS1, woS2, pfBk, pfS, flPut, flEol, flN, flP, szN, szP, \
    nvCh, nvW, nvB, nvDir, nvS, crName, avOdd, avPos, avP1, avEnd, avS, wName, \
    wFail, wP, wHalf, wW, wcC, scS, scD, opName, opFd, smS, soM, slN, slP, \
    slC, slOver, soHnd, soLeft, soP, soW, soHalf, soCR, fiHnd, drMnt, mtUnit, \
    pDev, pUnit, rdDev, rbP, rbN, rbHalf, rbW, rlCR, cntln, cntch, fiFull, \
    fiEdited, fiCut, fiWasAlt, fiIsAlt, fiAltDot, fiOldADot, fiArgc0, fiArgc, \
    fiArgs, fiMorArgc, fiOvro, fiDenied, fiHush, fiFpat, fiOneV, g1In, g1V, \
    npVol, npV, npVd, fmMnt, fmL, fmGo, fmTape, fmOk, fmFail, fmFull, fmF, fmI

// fiInit -- no file names, no argument list, nothing sourced, no volume
// mounted: as vi starts and restarts (vi.am1's restart).
// AC is clobbered, IO preserved.
fiInit, dac inX
    dzm fiEdited
    dzm fiCut
    dzm fiWasAlt
    dzm fiIsAlt
    dzm fiAltDot
    dzm fiOldADot
    dzm fiArgc0
    dzm fiArgc
    dzm fiMorArgc
    dzm fiOvro
    dzm fiDenied
    dzm fiHush
    dzm fiFpat
    dzm soOn
    dzm drMnt
    dzm mtUnit
    dzm i [FN_CUR]
    dzm i [FN_ALT]
    dzm i [FN_FILE]
    dzm i [FN_CUT]
    jsp ptInit
    jmp i inX

// --- the commands

// cEdit -- e, ex, edit [!] [+cmd] [file]: 3.7's edit. With the buffer
// changed and no !, the name is still taken, as the alternate, before the
// error (3.7's 'E'); here only when there are lines, as quickly's test.
cEdit, law 'e'
    dac edC
    jsp i [exclam:EX_BANK]
    SKIP_NEXT_IF_AC_ZERO
    jmp edF
    lac CHNG
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp edF
    lac DOL
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp edF
    law 'E'
    dac edC
edF, lio edC
    jsp fiFilename
    lac edC
    SKIP_NEXT_IF_DIFFERENT ['E']
    jmp fiQuick
    jsp i [setNoAddr:EX_BANK]
// edDo -- 3.7's doecmd: the buffer emptied, the file read as an edit
edDo, jsp fiInitBuf
    dzm ADDR1
    dzm ADDR2
    lio ['e']
    jsp fiRop
    dzm CHNG
    jsp fiNoChng
    jmp i [exNext:EX_BANK]

// fiQuick -- 3.7's quickly's error: the buffer changed and not written.
fiQuick, lac [cmdName:EX_BANK]
    dac i [msgS:MSG_BANK]
    lac [mNoWrite:MSG_BANK]
    jmp i [exErr:EX_BANK]

// cRead -- r [file]: the file read after the line addressed. With no
// current file and an empty buffer, it is read as an edit. r !cmd is not
// here: "!" is no file's name.
cRead, law 'r'
    dac edC
    lac i [FN_CUR]
    SKIP_NEXT_IF_AC_ZERO
    jmp rdF
    lac DOL
    SKIP_NEXT_IF_AC_ZERO
    jmp rdF
    law 'e'
    dac edC
rdF, jsp i [pastWh:EX_BANK]
    jsp i [peekChar:EX_BANK]
    SKIP_NEXT_IF_DIFFERENT [CH_EXCL]
    jmp fiBadNm
    lio edC
    jsp fiFilename
    lio edC
    jsp fiRop
    jsp fiNoChng
    jmp i [exNext:EX_BANK]

fiBadNm, lac [mBadName:MSG_BANK]
    jmp i [exErr:EX_BANK]

// cFile -- f [file]: the file's state typed, or the current name changed.
cFile, jsp i [setNoAddr:EX_BANK]
    lio ['f']
    jsp fiFilename
    jsp i [newline:TERM_BANK]
    jmp i [exNext:EX_BANK]

// cFormat -- format[!] dev:, an empty directory written on
// the volume of DT1: to DT8:, or of DR: on TECO's tracks, by the library's
// format, which leaves vi's handle for it mounted there. Without !, a volume
// whose directory lists a file is refused, and so is another program's data
// (the library's refusal). The buffer and its names are not touched. Every
// outcome follows the device's quoted name, as a file's messages do.
cFormat, jsp i [setNoAddr:EX_BANK]
    jsp i [exclam:EX_BANK]
    dac fmF
    jsp fiOneV
    jsp i [eol:EX_BANK]
    lac pDev
    SKIP_NEXT_IF_DIFFERENT [FK_PC]
    jmp soPerm              // no volume: as so takes them, named there
    SKIP_NEXT_IF_DIFFERENT [FK_LP]
    jmp soPerm
    lio [FN_FILE]
    jsp fiQName
    jsp fiMount
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp fmMnt
    SKIP_NEXT_IF_SAME [FS_ENOFS]
    jmp fiErr               // not ready and the like
    jmp fmGo                // a blank volume, or another program's
// mounted, so this file system's: without !, any slot in use refuses it
fmMnt, lac fmF
    SKIP_NEXT_IF_AC_ZERO
    jmp fmGo
    dzm fmI
fmL, lac fiHnd
    dac fiPb+FS_PHANDLE
    lac fmI
    dac fiPb+FS_PINDEX
    lac [STG_BUF]
    dac fiPb+FS_PDEST
    lac [fiPb:.]
    farjda(fsEntry:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp fiErr
    lac i [STG_BUF]         // a free slot's first word is 0
    SKIP_NEXT_IF_AC_ZERO
    jmp fmFull
    idx fmI
    SKIP_NEXT_IF_SAME [FS_NENT]
    jmp fmL
// the library unmounts the handle first, so until it succeeds vi counts the
// volume as not mounted, and a failed format is mounted again next time
fmGo, lac fiHnd
    dac fiPb+FS_PHANDLE
    lac pDev
    SKIP_NEXT_IF_SAME [FK_DRUM]
    jmp fmTape
    dzm drMnt
    law DR_TRK0
    dac fiPb+DR_PFIRST
    law DR_NTRK
    dac fiPb+DR_PTRACKS
    lac fmF
    dac fiPb+DR_PFORCE
    lac [fiPb:.]
    farjda(drFormat:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp fmFail
    law 1
    dac drMnt
    jmp fmOk
fmTape, dzm mtUnit
    lac pUnit
    dac fiPb+MT_PDRIVE
    lac fmF
    dac fiPb+MT_PFORCE
    lac [fiPb:.]
    farjda(mtFormat:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp fmFail
    lac pUnit
    dac mtUnit
fmOk, lio [mFormatted:MSG_BANK]
    jsp i [msgPut:MSG_BANK]
    jsp i [newline:TERM_BANK]
    jmp i [exNext:EX_BANK]
fmFail, SKIP_NEXT_IF_SAME [FS_EFOREIGN]
    jmp fiErr
    lac [mFmForeign:MSG_BANK]
    jmp i [exErr:EX_BANK]
fmFull, lac [mFmFull:MSG_BANK]
    jmp i [exErr:EX_BANK]

// cNext -- n [!] [+cmd] [file ...]: the next file of the argument list, or
// a new list.
cNext, jsp i [setNoAddr:EX_BANK]
    jsp fiCkaw
    jsp i [exclam:EX_BANK]
    SKIP_NEXT_IF_AC_ZERO
    jmp nxA
    lac CHNG
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp nxA
    lac DOL
    SKIP_NEXT_IF_AC_ZERO
    jmp fiQuick
nxA, jsp fiGetArgs
    SKIP_NEXT_IF_AC_ZERO
    jsp fiMkArgs
    jsp fiNext
    lio ['e']
    jsp fiFilename
    jmp edDo

// cRewind -- rew [!]: the argument list from its first file.
cRewind, jsp i [setNoAddr:EX_BANK]
    jsp i [exclam:EX_BANK]
    SKIP_NEXT_IF_AC_ZERO
    jmp rwE
    jsp fiCkaw
    lac CHNG
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rwE
    lac DOL
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rwE
    lac [mRewChg:MSG_BANK]
    jmp i [exErr:EX_BANK]
rwE, jsp i [eol:EX_BANK]
    jsp fiErew
    jsp fiNext
    jsp i [unGetChar:EX_BANK]
    lio ['e']
    jsp fiFilename
    jmp edDo

// cArgs -- ar: the argument list, the current file in brackets.
cArgs, jsp i [setNoAddr:EX_BANK]
    jsp i [eol:EX_BANK]
    lac [ARG_BUF]
    dac agP
    dzm agI
agL, lac agI
    SKIP_NEXT_IF_DIFFERENT fiArgc0
    jmp agE
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ag1
    lio [CH_SP]
    jsp i [putc:TERM_BANK]
ag1, jsp agCur
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ag2
    lio ['[']
    jsp i [putc:TERM_BANK]
ag2, lac agP
    dac i [msgS:MSG_BANK]
    lio [mStr:MSG_BANK]
    jsp i [msgPut:MSG_BANK]
    jsp agCur
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ag3
    lio [']']
    jsp i [putc:TERM_BANK]
ag3, lac i agP              // past this name's 0
    dac agT
    idx agP
    lac agT
    SKIP_NEXT_IF_AC_ZERO
    jmp ag3
    idx agI
    jmp agL
agE, jsp i [newline:TERM_BANK]
    jmp i [exNext:EX_BANK]

// agCur -- whether name agI is the current one: agI + argc = argc0 - 1.
// AC is 1 or 0; IO is preserved.
agCur, dac acX
    lac agI
    add fiArgc
    add [1]
    SKIP_NEXT_IF_DIFFERENT fiArgc0
    jmp acY
    cla
    jmp i acX
acY, law 1
    jmp i acX

// cSource -- so file: the file's lines read as commands, then what followed
// so's line in CMDBUF (vi's CH_EOF, the rest of a command list), kept at
// SO_RST meanwhile. One at a time: a source within a source is refused.
cSource, jsp i [setNoAddr:EX_BANK]
    jsp fiOne
    jsp i [eol:EX_BANK]
    lac soOn
    SKIP_NEXT_IF_AC_ZERO
    jmp soNest
    lac i [cbEnd:EX_BANK]
    sub i [cbPos:EX_BANK]
    dac soRn
    sub [SO_RSTN+1]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp soLong
    lac pDev
    SKIP_NEXT_IF_DIFFERENT [FK_PC]
    jmp soPerm
    SKIP_NEXT_IF_DIFFERENT [FK_LP]
    jmp soPerm
    jsp fiMount
    SKIP_NEXT_IF_AC_ZERO
    jmp soFail
    lac [fiLib:.]
    dac opName
    jsp soOpen
    SKIP_NEXT_IF_AC_ZERO
    jmp soFail
    lac i [cbPos:EX_BANK]
    add [CMDBUF]
    dac soQ
    lac [SO_RST]
    dac soQ2
    lac soRn
    dac soK
    jsp soCopy
    lac i [cbEnd:EX_BANK]
    dac i [cbPos:EX_BANK]
    jmp i [exNext:EX_BANK]
soLong, lac [mInLong:MSG_BANK]
    jmp i [exErr:EX_BANK]
soPerm, lac [mPerm:MSG_BANK]
    jmp soMsg
soFail, lia
    jsp fiStMsg
soMsg, dac soM
    lio [FN_FILE]
    jsp fiQName
    lac soM
    jmp i [exErr:EX_BANK]
soNest, lac [mNested:MSG_BANK]
    jmp i [exErr:EX_BANK]

// cRecover -- rec [!]: the buffer a lost caller left, read from the
// drum's VI  SAVE in place of the buffer. The current name is kept; the
// buffer counts as changed.
cRecover, jsp i [setNoAddr:EX_BANK]
    jsp i [exclam:EX_BANK]
    SKIP_NEXT_IF_AC_ZERO
    jmp rcE
    lac CHNG
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rcE
    lac DOL
    SKIP_NEXT_IF_AC_ZERO
    jmp fiQuick
rcE, jsp i [eol:EX_BANK]
    law FK_DRUM
    dac pDev
    dac rdDev
    jsp fiMount
    SKIP_NEXT_IF_AC_ZERO
    jmp fiErr
    lac [nmSave:.]
    dac opName
    lac [FD_IO]
    dac opFd
    jsp fiOpenN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rc1
    SKIP_NEXT_IF_SAME [FS_ENOTFOUND]
    jmp fiErr
    lac [mNoEntR:MSG_BANK]
    jmp i [exErr:EX_BANK]
rc1, jsp fiInitBuf
    dzm ADDR1
    dzm ADDR2
    jsp fiRdInit
    jsp fiAppend
    lio [mRecov:MSG_BANK]
    jsp i [msgPut:MSG_BANK]
    lac fiFull
    SKIP_NEXT_IF_AC_ZERO
    jmp rc2
    jsp fiStats
    jmp rc3
rc2, jsp fiTooBig
rc3, dzm i [undKind:0]
    jsp fiNoChng
    jmp i [exNext:EX_BANK]

// fiWrite, fiWq, fiXit -- w, wq and x, from exops.ac: 3.7's wq. x with the
// buffer unchanged leaves at once. w !cmd is not here: "!" is no file's
// name.
fiXit, lac CHNG
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp wqQuit
fiWq, law 1
    jmp wq1
fiWrite, cla
wq1, dac wqQ
    jsp i [skipWh:EX_BANK]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp wq2
    jsp i [peekChar:EX_BANK]
    SKIP_NEXT_IF_DIFFERENT [CH_EXCL]
    jmp fiBadNm
wq2, jsp i [setAll:EX_BANK]
    law 1
    dac woF
    jsp fiWop
    jsp fiNoChng
    lac wqQ
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i [exNext:EX_BANK]
wqQuit, jsp fiNoMore
    jsp i [tmQuit:TERM_BANK]

// fiNoMore -- 3.7's nomore, before q (without !), wq and x leave: files of
// the argument list not yet edited stop the first try.
// AC and IO are clobbered.
fiNoMore, dac nmX
    lac fiArgc
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i nmX
    SKIP_NEXT_IF_DIFFERENT fiMorArgc
    jmp i nmX
    dac fiMorArgc
    dac i [msgN:MSG_BANK]
    lac [fiNul:.]
    dac i [msgS:MSG_BANK]
    lac fiArgc
    SKIP_NEXT_IF_DIFFERENT [1]
    jmp nm1
    lac [fiPlS:.]
    dac i [msgS:MSG_BANK]
nm1, lac [mMoreF:MSG_BANK]
    jmp i [exErr:EX_BANK]

// fiLost -- a lost caller (exBrk): a changed buffer with lines is written to
// the drum's VI  SAVE, quietly, in place of the last; then vi starts
// again for the next caller.
fiLost, lac CHNG
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i [restart:0]
    lac DOL
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i [restart:0]
    law 1
    dac fiHush
    dzm soOn
    dzm i [brkOn:TERM_BANK]
    law FK_DRUM
    dac pDev
    jsp fiMount
    SKIP_NEXT_IF_AC_ZERO
    jmp i [restart:0]
    lac [nmSave:.]
    dac wName
    dac opName
    lac [FD_IO]
    dac opFd
    jsp fiOpenN
    dzm woNe
    SKIP_NEXT_IF_AC_ZERO
    idx woNe
    law 1
    dac ADDR1
    lac DOL
    dac ADDR2
    jsp fiNewVol
    jmp i [restart:0]

// --- the names

// fiFilename -- 3.7's filename(comm), comm in IO: the name typed after the
// command, or with none the current file's, into FN_FILE (and pDev, fiLib),
// the current and alternate names kept as 3.7 keeps them; then the name
// typed, and for f the file's state.
// AC and IO are clobbered.
fiFilename, dac fnX
    dio fnComm
    dio fnC
    jsp i [getChar:EX_BANK]
    lia
    jsp i [endCmd:EX_BANK]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp fnArg
// no name: the current file's
    lac i [FN_CUR]
    SKIP_NEXT_IF_AC_ZERO
    jmp fnCur
    dzm i [FN_FILE]
    lac fnComm
    SKIP_NEXT_IF_SAME ['f']
    jmp fnNoF
    jmp fnW
fnNoF, lac [mNoFileT:MSG_BANK]
    jmp i [exErr:EX_BANK]
fnCur, lio [FN_CUR]
    jsp fnParse
fnW, lac fiIsAlt            // wasalt = isalt > 0 ? isalt-1 : 0
    SKIP_NEXT_IF_AC_ZERO
    sub [1]
    dac fiWasAlt
    dzm fiIsAlt
    lac fiAltDot
    dac fiOldADot
    lac fnC
    SKIP_NEXT_IF_DIFFERENT ['e']
    jmp fnAD
    SKIP_NEXT_IF_DIFFERENT ['E']
    jmp fnAD
    jmp fnPr
fnAD, lac DOT
    dac fiAltDot
    jmp fnPr
// a name
fnArg, jsp i [unGetChar:EX_BANK]
    jsp fiOne
    jsp i [eol:EX_BANK]
    lac i [FN_CUR]
    SKIP_NEXT_IF_AC_ZERO
    jmp fnHas
    lac fnC
    SKIP_NEXT_IF_DIFFERENT ['E']
    jmp fnHas
    SKIP_NEXT_IF_DIFFERENT ['e']
    jmp fnHas
    law 'e'                 // the first name named is the current file's
    dac fnC
    dzm fiEdited
fnHas, lac [FN_FILE]
    dac scS
    lac [FN_ALT]
    dac scD
    jsp strEq
    dac fiWasAlt
    lac fiAltDot
    dac fiOldADot
    lac fnC
    SKIP_NEXT_IF_DIFFERENT ['f']
    jmp fnF
    SKIP_NEXT_IF_DIFFERENT ['e']
    jmp fnE
// another command's name becomes the alternate
    SKIP_NEXT_IF_DIFFERENT ['E']
    jmp fnAlt
    lac DOT
    dac fiAltDot
fnAlt, lac [FN_FILE]
    dac scS
    lac [FN_ALT]
    dac scD
    jsp strCpy
    jmp fnPr
fnF, dzm fiEdited
fnE, lac i [FN_CUR]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp fnSet
    lac DOT
    dac fiAltDot
    lac [FN_CUR]
    dac scS
    lac [FN_ALT]
    dac scD
    jsp strCpy
fnSet, lac [FN_FILE]
    dac scS
    lac [FN_CUR]
    dac scD
    jsp strCpy
// typed, unless quiet or doomed
fnPr, lac fnComm
    SKIP_NEXT_IF_DIFFERENT ['E']
    jmp i fnX
    SKIP_NEXT_IF_DIFFERENT ['f']
    jmp fnPr1
    lac fiHush
    SKIP_NEXT_IF_AC_ZERO
    jmp i fnX
fnPr1, lac i [FN_FILE]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp fnNone
    lio [FN_FILE]
    jsp fiQName
    lac fnComm
    SKIP_NEXT_IF_SAME ['f']
    jmp i fnX
    lac i [oReadOnly:EX_BANK]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp fnF1
    lio [mRoTag:MSG_BANK]
    jsp i [msgPut:MSG_BANK]
fnF1, lac fiEdited
    SKIP_NEXT_IF_AC_ZERO
    jmp fnF2
    lio [mNotEd:MSG_BANK]
    jsp i [msgPut:MSG_BANK]
fnF2, lac CHNG
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp fnF3
    lio [mModif:MSG_BANK]
    jsp i [msgPut:MSG_BANK]
    jmp fnF3
fnNone, lio [mNoFileF:MSG_BANK]
    jsp i [msgPut:MSG_BANK]
    lac fnComm
    SKIP_NEXT_IF_SAME ['f']
    jmp i fnX
// f: the line, the lines, and how far through
fnF3, lac DOT
    dac i [msgN:MSG_BANK]
    lio [mLineOf:MSG_BANK]
    jsp i [msgPut:MSG_BANK]
    lac DOL
    dac i [msgN:MSG_BANK]
    lio [mPctA:MSG_BANK]
    jsp i [msgPut:MSG_BANK]
    lac DOL
    SKIP_NEXT_IF_AC_NOT_ZERO
    law 1
    dac fnI
    lac DOT
    mul [0d100]
    div fnI
    cla                     // no skip: not reached, the quotient is at most 100
    dac i [msgN:MSG_BANK]
    lio [mPctB:MSG_BANK]
    jsp i [msgPut:MSG_BANK]
    jmp i fnX

// fiGetArgs -- 3.7's getargs: a +cmd into FPAT (fiFpat set), then the words
// to the command's end into GENBUF, a character a word, % and # expanded, \
// before # % | taken as the character itself. AC is 0 when there are no
// words, else 1; IO is clobbered.
fiGetArgs, dac gaX
    jsp i [pastWh:EX_BANK]
    jsp i [peekChar:EX_BANK]
    SKIP_NEXT_IF_SAME [CH_PLUS]
    jmp gaArgs
    lac [FPAT]
    dac gaP
    dzm gaN
gaPl, jsp i [getChar:EX_BANK]
    dac gaC
    dac i gaP
    idx gaP
    idx gaN
    sub [FPAT_SIZE]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp gaPLong
    lac gaC
    SKIP_NEXT_IF_SAME [CH_BSL]
    jmp gaPw
    jsp i [peekChar:EX_BANK]
    lia
    jsp fiIsSp
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp gaPw
    jsp i [getChar:EX_BANK]
    dac gaC
gaPw, lio gaC
    jsp fiIsSp
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp gaPl
    jsp i [unGetChar:EX_BANK]
    lac gaP
    sub [1]
    dac gaP
    dzm i gaP
    law 1
    dac fiFpat
gaArgs, jsp i [skipEnd:EX_BANK]
    SKIP_NEXT_IF_AC_ZERO
    jmp gaNone
    lac [GENBUF]
    dac gaP
    dzm gaN
gaL, jsp i [getChar:EX_BANK]
    dac gaC
    lia
    jsp i [endCmd:EX_BANK]
    SKIP_NEXT_IF_AC_ZERO
    jmp gaEnd
    lac gaC
    SKIP_NEXT_IF_DIFFERENT [CH_BSL]
    jmp gaBsl
    SKIP_NEXT_IF_DIFFERENT [CH_HASH]
    jmp gaHash
    SKIP_NEXT_IF_DIFFERENT [CH_PCT]
    jmp gaPct
gaPut, jsp gaOne
    jmp gaL
gaBsl, jsp i [peekChar:EX_BANK]
    SKIP_NEXT_IF_DIFFERENT [CH_HASH]
    jmp gaBq
    SKIP_NEXT_IF_DIFFERENT [CH_PCT]
    jmp gaBq
    SKIP_NEXT_IF_DIFFERENT [CH_VBAR]
    jmp gaBq
    jmp gaPut
gaBq, jsp i [getChar:EX_BANK]
    dac gaC
    jmp gaPut
gaHash, lac i [FN_ALT]
    SKIP_NEXT_IF_AC_ZERO
    jmp gaHs
    lac [mNoAlt:MSG_BANK]
    jmp i [exErr:EX_BANK]
gaHs, lac [FN_ALT]
    jmp gaFx
gaPct, lac i [FN_CUR]
    SKIP_NEXT_IF_AC_ZERO
    jmp gaPc
    lac [mNoCurS:MSG_BANK]
    jmp i [exErr:EX_BANK]
gaPc, lac [FN_CUR]
gaFx, dac gaF
gaFl, lac i gaF
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp gaL
    dac gaC
    jsp gaOne
    idx gaF
    jmp gaFl
gaEnd, jsp i [unGetChar:EX_BANK]
    dzm i gaP
    law 1
    jmp i gaX
gaNone, cla
    jmp i gaX
gaPLong, lac [mPatLong:MSG_BANK]
    jmp i [exErr:EX_BANK]

// gaOne -- gaC into GENBUF, if it has room. AC and IO are clobbered.
gaOne, dac goX
    lac gaN
    sub [GA_MAX]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp gaOvf
    lac gaC
    dac i gaP
    idx gaP
    idx gaN
    jmp i goX
gaOvf, lac [mArgOvf:MSG_BANK]
    jmp i [exErr:EX_BANK]

// fiIsSp -- 3.7's isspace for the character in IO: a blank, TAB or LF.
// AC is 1 or 0; IO is preserved.
fiIsSp, dac isX
    dio isC
    lac isC
    SKIP_NEXT_IF_DIFFERENT [CH_SP]
    jmp isY
    SKIP_NEXT_IF_DIFFERENT [CH_TAB]
    jmp isY
    SKIP_NEXT_IF_DIFFERENT [CH_LF]
    jmp isY
    cla
    jmp i isX
isY, law 1
    jmp i isX

// fiOne -- 3.7's getone: one name, parsed into FN_FILE, pDev and fiLib.
// fiOneV -- the same for a device alone (format): DT1:, say, and nothing
// after its colon, its full form into FN_FILE.
// AC and IO are clobbered.
fiOneV, dac g1X
    law 1
    jmp g1In
fiOne, dac g1X
    cla
g1In, dac g1V
    jsp fiGetArgs
    SKIP_NEXT_IF_AC_ZERO
    jmp g1Go
g1Miss, lac [mMissFn:MSG_BANK]
    jmp i [exErr:EX_BANK]
g1Go, lac [GENBUF]
    dac wdP
    jsp fiWord
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp g1Miss
    dac g1W
    jsp fiWord
    SKIP_NEXT_IF_AC_ZERO
    jmp g1Many
    lac g1V                 // set just before fnParse, which clears it
    dac npVol
    lio g1W
    jsp fnParse
    jmp i g1X
g1Many, lac [mTooManyF:MSG_BANK]
    jmp i [exErr:EX_BANK]

// fiWord -- the next word at or after wdP, blanks and TABs between words.
// AC is its full address, 0 when there is none; wdP is past it. IO is
// preserved.
fiWord, dac wdX
wdS, lac i wdP
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i wdX
    SKIP_NEXT_IF_DIFFERENT [CH_SP]
    jmp wdNx
    SKIP_NEXT_IF_DIFFERENT [CH_TAB]
    jmp wdNx
    lac wdP
    dac wdB
wdE, idx wdP
    lac i wdP
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp wdR
    SKIP_NEXT_IF_DIFFERENT [CH_SP]
    jmp wdR
    SKIP_NEXT_IF_DIFFERENT [CH_TAB]
    jmp wdR
    jmp wdE
wdR, lac wdB
    jmp i wdX
wdNx, idx wdP
    jmp wdS

// fnParse -- the name at the full address in IO, a character a word ending
// at a 0, a blank or a TAB: its device into pDev (and a tape's unit into
// pUnit), the library's name into fiLib, the full form into FN_FILE. With
// npVol set (fiOneV), only a device is taken, and npVol is cleared.
// AC and IO are clobbered.
fnParse, dac npX
    dio npP
    dio npQ
    lac npVol
    dac npV
    dzm npVol
// a device before a colon?
npScan, lac i npQ
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp npNoDev
    SKIP_NEXT_IF_DIFFERENT [CH_SP]
    jmp npNoDev
    SKIP_NEXT_IF_DIFFERENT [CH_TAB]
    jmp npNoDev
    SKIP_NEXT_IF_DIFFERENT [CH_COLON]
    jmp npDev
    idx npQ
    jmp npScan
npDev, lac npQ
    sub npP
    SKIP_NEXT_IF_DIFFERENT [2]
    jmp npD2c
    SKIP_NEXT_IF_DIFFERENT [3]
    jmp npD3c
npUnk, lac [mUnkDev:MSG_BANK]
    jmp i [exErr:EX_BANK]
npD2c, jsp npGet
    dac npD1
    jsp npGet
    dac npD2
    lac npD1
    SKIP_NEXT_IF_SAME ['D']
    jmp npD2P
    lac npD2
    SKIP_NEXT_IF_SAME ['R']
    jmp npUnk
    law FK_DRUM
    jmp npDvOk
npD2P, SKIP_NEXT_IF_SAME ['P']
    jmp npD2L
    lac npD2
    SKIP_NEXT_IF_SAME ['C']
    jmp npUnk
    law FK_PC
    jmp npDvOk
npD2L, SKIP_NEXT_IF_SAME ['L']
    jmp npUnk
    lac npD2
    SKIP_NEXT_IF_SAME ['P']
    jmp npUnk
    law FK_LP
    jmp npDvOk
npD3c, jsp npGet
    SKIP_NEXT_IF_SAME ['D']
    jmp npUnk
    jsp npGet
    SKIP_NEXT_IF_SAME ['T']
    jmp npUnk
    jsp npGet
    sub ['1']
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp npUnk
    dac npD1
    sub [010]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp npUnk
    lac npD1
    add [1]
    dac pUnit
    law FK_TAPE
npDvOk, dac pDev
    lac npQ                 // the name follows the colon
    add [1]
    dac npP
    lac npV
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp npName
// a device alone: nothing may follow its colon
    lac i npP
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp npVd
    SKIP_NEXT_IF_DIFFERENT [CH_SP]
    jmp npVd
    SKIP_NEXT_IF_DIFFERENT [CH_TAB]
    jmp npVd
    jmp npBad
npVd, dzm npK
    jmp npFull
// no device: the current file's, DR: for none or PC: or LP:; none for a
// device alone
npNoDev, lac npV
    SKIP_NEXT_IF_AC_ZERO
    jmp npUnk
    law FK_DRUM
    dac pDev
    lac i [FN_CUR]
    SKIP_NEXT_IF_SAME ['D']
    jmp npName
    lac i [FN_CUR+1]
    SKIP_NEXT_IF_SAME ['T']
    jmp npName
    lac i [FN_CUR+2]
    sub ['0']
    dac pUnit
    law FK_TAPE
    dac pDev
// the name: name.ext into fiNmBuf, the dot as the library's blank
npName, dzm npK
    dzm npDot
    dzm npN1
    dzm npN2
    lac [fiNmBuf:.]
    dac npB
npNl, lac i npP
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp npNe
    SKIP_NEXT_IF_DIFFERENT [CH_SP]
    jmp npNe
    SKIP_NEXT_IF_DIFFERENT [CH_TAB]
    jmp npNe
    jsp npGet
    dac npC
    SKIP_NEXT_IF_DIFFERENT [CH_DOT]
    jmp npNDot
    sub [041]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp npBad               // a control character
    lac npC
    sub [0140]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp npBad               // past sixbit
    lac npC
    SKIP_NEXT_IF_DIFFERENT [CH_COLON]
    jmp npBad
    lac npDot
    SKIP_NEXT_IF_AC_ZERO
    jmp npE2
    idx npN1
    jmp npSt
npE2, idx npN2
npSt, lac npK
    sub [LIB_MAX]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp npLong
    lac npC
    dac i npB
    idx npB
    idx npK
    jmp npNl
npNDot, lac npDot
    SKIP_NEXT_IF_AC_ZERO
    jmp npBad
    law 1
    dac npDot
    law CH_SP
    dac npC
    jmp npSt
npLong, lac [mFnLong:MSG_BANK]
    jmp i [exErr:EX_BANK]
npBad, lac [mBadName:MSG_BANK]
    jmp i [exErr:EX_BANK]
// its end: PC: and LP: take no name; a file must have one
npNe, lac pDev
    SKIP_NEXT_IF_DIFFERENT [FK_PC]
    jmp npNoNm
    SKIP_NEXT_IF_DIFFERENT [FK_LP]
    jmp npNoNm
    lac npN1
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp npBad
    lac npDot
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp npPack
    lac npN2
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp npBad
    jmp npPack
npNoNm, lac npK
    SKIP_NEXT_IF_AC_ZERO
    jmp npBad
    jmp npFull
// the library's name, two characters a word
npPack, dzm fiLib
    dzm fiLib+1
    dzm fiLib+2
    dzm fiLib+3
    dzm fiLib+4
    lac [fiNmBuf:.]
    dac npB
    lac [fiLib:.]
    dac npL
    dzm npI
npPl, lac npI
    SKIP_NEXT_IF_DIFFERENT npK
    jmp npFull
    lac i npB
    ral 9s
    dac i npL
    idx npB
    idx npI
    SKIP_NEXT_IF_DIFFERENT npK
    jmp npFull
    lac i npB
    ior i npL
    dac i npL
    idx npB
    idx npL
    idx npI
    jmp npPl
// the full form
npFull, lac [FN_FILE]
    dac npL
    lac pDev
    SKIP_NEXT_IF_DIFFERENT [FK_DRUM]
    jmp npFDr
    SKIP_NEXT_IF_DIFFERENT [FK_PC]
    jmp npFPc
    SKIP_NEXT_IF_DIFFERENT [FK_LP]
    jmp npFLp
    lio ['D']
    jsp npPut
    lio ['T']
    jsp npPut
    lac pUnit
    add ['0']
    lia
    jsp npPut
    jmp npFC
npFDr, lio ['D']
    jsp npPut
    lio ['R']
    jmp npF2
npFPc, lio ['P']
    jsp npPut
    lio ['C']
    jmp npF2
npFLp, lio ['L']
    jsp npPut
    lio ['P']
npF2, jsp npPut
npFC, lio [CH_COLON]
    jsp npPut
    lac [fiNmBuf:.]
    dac npB
    dzm npI
npFl, lac npI
    SKIP_NEXT_IF_DIFFERENT npK
    jmp npFz
    lac i npB
    SKIP_NEXT_IF_DIFFERENT [CH_SP]
    law CH_DOT
    lia
    jsp npPut
    idx npB
    idx npI
    jmp npFl
npFz, cli
    jsp npPut
    jmp i npX

// npGet -- the character at npP, a small letter as its capital; npP past
// it. AC is the character; IO is preserved.
npGet, dac ngX
    lac i npP
    dac ngC
    idx npP
    lac ngC
    sub ['a']
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp ngR
    sub ['z'-'a'+1]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp ngR
    lac ngC
    sub [040]
    dac ngC
ngR, lac ngC
    jmp i ngX

// npPut -- the character in IO at npL, npL past it. AC is clobbered, IO
// preserved.
npPut, dac npuX
    dio i npL
    idx npL
    jmp i npuX

// --- the argument list

// fiMkArgs -- 3.7's makargs: GENBUF's words, each parsed, the new argument
// list in ARG_BUF in the full form; then erewind.
// AC and IO are clobbered.
fiMkArgs, dac maX
    dzm fiArgc0
    dzm fiArgc
    dzm maN
    lac [GENBUF]
    dac wdP
    lac [ARG_BUF]
    dac maD
maL, jsp fiWord
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp maE
    lia
    jsp fnParse
    lac [FN_FILE]
    dac maS
maC, lac maD
    sub [ARG_BUF+ARG_SIZE]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp maOvf
    lac i maS
    dac i maD
    dac maT
    idx maS
    idx maD
    lac maT
    SKIP_NEXT_IF_AC_ZERO
    jmp maC
    idx maN
    jmp maL
maE, lac maN
    dac fiArgc0
    jsp fiErew
    jmp i maX
maOvf, lac [mArgLong:MSG_BANK]
    jmp i [exErr:EX_BANK]

// fiErew -- 3.7's erewind: the list from its first name, and with more than
// one, how many there are typed. AC and IO are clobbered.
fiErew, dac erX
    lac fiArgc0
    dac fiArgc
    lac [ARG_BUF]
    dac fiArgs
    lac fiArgc
    sub [2]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp i erX
    lac fiHush
    SKIP_NEXT_IF_AC_ZERO
    jmp i erX
    lac fiArgc
    dac i [msgN:MSG_BANK]
    lio [mFilesTo:MSG_BANK]
    jsp i [msgPut:MSG_BANK]
    jsp i [newline:TERM_BANK]
    jmp i erX

// fiNext -- 3.7's next: the list's next name becomes the current one, the
// current one the alternate. AC and IO are clobbered.
fiNext, dac nxX
    lac fiArgc
    SKIP_NEXT_IF_AC_ZERO
    jmp nx1
    lac [mNoMore:MSG_BANK]
    jmp i [exErr:EX_BANK]
nx1, dac fiMorArgc
    lac fiArgs
    dac scS
    lac [FN_ALT]
    dac scD
    jsp strEq
    add [1]
    dac fiIsAlt
    lac i [FN_CUR]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp nx2
    lac [FN_CUR]
    dac scS
    lac [FN_ALT]
    dac scD
    jsp strCpy
nx2, lac fiArgs
    dac scS
    lac [FN_CUR]
    dac scD
    jsp strCpy
    lac fiArgc
    sub [1]
    dac fiArgc
nx3, lac i fiArgs           // past this name's 0
    dac nxC
    idx fiArgs
    lac nxC
    SKIP_NEXT_IF_AC_ZERO
    jmp nx3
    jmp i nxX

// fiCkaw -- 3.7's ckaw: with autowrite set, a changed buffer is written to
// the current file first. AC and IO are clobbered.
fiCkaw, dac ckX
    lac CHNG
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i ckX
    lac i [oAutoWr:EX_BANK]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i ckX
    dzm woF
    jsp fiWop
    jmp i ckX

// --- reading

// fiRop -- 3.7's rop(c), c in IO, 'e' for an edit or 'r' for a read: the
// file FN_FILE names read after addr2 (setall for an edit, setdot for a
// read), readonly set for a read-only file's edit as 3.7 sets it for a file
// it may not write, the count typed; for an edit, edited set, '' marked,
// and a +cmd run after. A file larger than the heap is read cut short.
// AC and IO are clobbered.
fiRop, dac roX
    dio roC
    lac pDev
    dac rdDev
    SKIP_NEXT_IF_DIFFERENT [FK_LP]
    jmp roPerm
    SKIP_NEXT_IF_DIFFERENT [FK_PC]
    jmp roPc
    jsp fiMount
    SKIP_NEXT_IF_AC_ZERO
    jmp fiErr
    lac [fiLib:.]
    dac opName
    lac [FD_IO]
    dac opFd
    jsp fiOpenN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp roOpen
    SKIP_NEXT_IF_SAME [FS_ENOTFOUND]
    jmp fiErr
    lac roC
    SKIP_NEXT_IF_SAME ['e']
    jmp roNoEnt
    law 1
    dac fiEdited
roNoEnt, lac [mNoEnt:MSG_BANK]
    jmp i [exErr:EX_BANK]
roPerm, lac [mPerm:MSG_BANK]
    jmp i [exErr:EX_BANK]
roPc, dzm roRo
    jsp ptStart
    jmp roMode
roOpen, lac i [FD_IO+FS_FINFO]
    and [FS_IRO]
    dac roRo
// readonly: an edit of a read-only file sets it, the next edit puts it back
roMode, lac roC
    SKIP_NEXT_IF_DIFFERENT ['r']
    jmp roRoS
    lac i [oReadOnly:EX_BANK]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp roNd
    lac fiDenied
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp roNd
    lac fiOvro
    dac i [oReadOnly:EX_BANK]
    dzm fiDenied
roNd, lac roRo
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp roRoS
    lac i [oReadOnly:EX_BANK]
    dac fiOvro
    law 1
    dac fiDenied
    dac i [oReadOnly:EX_BANK]
roRoS, lac i [oReadOnly:EX_BANK]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp roAd
    lio [mRoTag:MSG_BANK]
    jsp i [msgPut:MSG_BANK]
roAd, lac roC
    SKIP_NEXT_IF_DIFFERENT ['r']
    jmp roSd
    jsp i [setAll:EX_BANK]
    jmp roRd
roSd, jsp i [setDot:EX_BANK]
roRd, jsp fiRdInit
    jsp fiAppend
    lac fiFull
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp roSt
    jsp fiTooBig
    lac roC
    SKIP_NEXT_IF_SAME ['e']
    jmp i roX
    law 1                   // the buffer is that file cut short
    dac fiCut
    lac [FN_FILE]
    dac scS
