nvFull, law FS_ENOSPACE
    jmp nvSt

// fiAppVol -- w>>: the lines added to the end of the file at wName on
// fiHnd's volume. A last word holding one character (its low half empty) is
// filled first. The file's allocation must hold them all, or nothing is
// written. AC is 0, or the failure's message's full address; IO is
// clobbered.
fiAppVol, dac avX
    lac [fiAvBad:.]
    dac wFail
    lac wName
    dac opName
    lac [FD_IO]
    dac opFd
    jsp fiOpenN
    SKIP_NEXT_IF_AC_ZERO
    jmp avSt
    jsp fiSize
    jsp wrInit
    dzm avOdd
    lac i [FD_IO+FS_FLEN]
    dac avPos
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp avRoom
    sub [1]
    dac avP1
    lio avP1
    jsp avSeek
    SKIP_NEXT_IF_AC_ZERO
    jmp fiAvBad
    lac [FD_IO]
    dac fiPb+FS_PFDESC
    lac [STG_BUF]
    dac fiPb+FS_PBUF
    law 1
    dac fiPb+FS_PCOUNT
    lac [fiPb:.]
    farjda(fsRead:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp fiAvBad
    lac i [STG_BUF]
    and [0777]
    SKIP_NEXT_IF_AC_ZERO
    jmp avRoom
    lac i [STG_BUF]
    and [0777000]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp avRoom
    dac wW                  // the word's character: the next goes after it
    law 1
    dac wHalf
    dac avOdd
    lac avP1
    dac avPos
avRoom, lac avOdd
    add nvCh
    add [1]
    sar 1s
    add avPos
    dac avEnd
    lac i [FD_IO+FS_FALLOC]
    sal 8s
    sub avEnd
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp avFull
    lio avPos
    jsp avSeek
    SKIP_NEXT_IF_AC_ZERO
    jmp fiAvBad
    lac [fiWrCh:.]
    dac flPut
    lac [fiWrEol:.]
    dac flEol
    jsp fiLines
    jsp wrEnd
    lac [FD_IO]
    farjda(fsClose:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp avSt
    cla
    jmp i avX
avFull, lac [FD_IO]
    farjda(fsClose:*)
    law FS_ENOSPACE
    jmp avSt
fiAvBad, dac avS              // the file is the user's: closed, not deleted
    lac [FD_IO]
    farjda(fsClose:*)
    lac avS
avSt, lia
    jsp fiStMsg
    jmp i avX

// avSeek -- FD_IO to the word whose place is in IO. AC is the library's
// status; IO is clobbered.
avSeek, dac asX
    dio fiPb+FS_PPOS
    lac [FD_IO]
    dac fiPb+FS_PFDESC
    lac [fiPb:.]
    farjda(fsSeek:*)
    jmp i asX

// wrInit -- the staging buffer empty, at a word's start. AC is clobbered, IO
// preserved.
wrInit, dac wiX
    lac [STG_BUF]
    dac wP
    dzm wHalf
    jmp i wiX

// fiWrCh -- the character in IO into the staging buffer, two to a word, the
// high half first; a full buffer written to FD_IO. A failed write leaves by
// jmp i wFail with the status in AC. AC and IO are clobbered.
fiWrCh, dac wcX
    dio wcC
    lac wHalf
    SKIP_NEXT_IF_AC_ZERO
    jmp wcLo
    lac wcC
    ral 9s
    dac wW
    law 1
    dac wHalf
    jmp i wcX
wcLo, lac wcC
    ior wW
    dac i wP
    dzm wHalf
    idx wP
    sub [STG_BUF+STG_BLKS*FS_BLKW]
    SKIP_NEXT_IF_AC_ZERO
    jmp i wcX
    jsp wrFlush
    jmp i wcX

// fiWrEol -- a line's end on a volume: CR. AC and IO are clobbered.
fiWrEol, dac weX
    lio [CH_CR]
    jsp fiWrCh
    jmp i weX

// wrEnd -- the last half word kept, and what the staging buffer holds
// written. AC and IO are clobbered.
wrEnd, dac wnX
    lac wHalf
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp wn1
    lac wW
    dac i wP
    idx wP
    dzm wHalf
wn1, jsp wrFlush
    jmp i wnX

// wrFlush -- the staging buffer's words written to FD_IO; a failure leaves
// by jmp i wFail with the status in AC. AC and IO are clobbered.
wrFlush, dac wfX
    lac wP
    sub [STG_BUF]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i wfX
    dac fiPb+FS_PCOUNT
    lac [FD_IO]
    dac fiPb+FS_PFDESC
    lac [STG_BUF]
    dac fiPb+FS_PBUF
    lac [fiPb:.]
    farjda(fsWrite:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp i wFail
    lac [STG_BUF]
    dac wP
    jmp i wfX

// --- the volumes

// fiMount -- pDev's volume on its handle, fiHnd: the drum's once for each
// caller; a tape's for every command, unless a source file on that drive is
// open. AC is the library's status; IO is clobbered.
fiMount, dac mnX
    lac pDev
    SKIP_NEXT_IF_SAME [FK_DRUM]
    jmp mnTape
    lac [DR_HND]
    dac fiHnd
    lac drMnt
    SKIP_NEXT_IF_AC_ZERO
    jmp mnOk
    lac [DR_HND]
    dac fiMpb+FS_PHANDLE
    law DR_TRK0
    dac fiMpb+DR_PFIRST
    law DR_NTRK
    dac fiMpb+DR_PTRACKS
    lac [fiMpb:.]
    farjda(drMount:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp i mnX
    law 1
    dac drMnt
mnOk, cla
    jmp i mnX
mnTape, lac [MT_HND]
    dac fiHnd
    lac soOn
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp mnT1
    lac soHnd
    SKIP_NEXT_IF_SAME [MT_HND]
    jmp mnT1
    lac mtUnit
    SKIP_NEXT_IF_DIFFERENT pUnit
    jmp mnOk
mnT1, dzm mtUnit
    lac [MT_HND]
    dac fiMpb+FS_PHANDLE
    lac pUnit
    dac fiMpb+MT_PDRIVE
    lac [fiMpb:.]
    farjda(mtMount:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp i mnX
    lac pUnit
    dac mtUnit
    jmp mnOk

// fiOpenN -- the file named at opName (an ascii string's full address) on
// fiHnd's volume, opened on the descriptor at opFd. AC is the library's
// status; IO is clobbered.
fiOpenN, dac oiX
    lac fiHnd
    dac fiPb+FS_PHANDLE
    lac opName
    dac fiPb+FS_PNAME
    lac opFd
    dac fiPb+FS_PFD
    lac [fiPb:.]
    farjda(fsOpenName:*)
    jmp i oiX

// fiCreate -- the file named at crName made on fiHnd's volume, nvB blocks,
// open on FD_IO. AC is the library's status; IO is clobbered.
fiCreate, dac cvX
    lac fiHnd
    dac fiPb+FS_PHANDLE
    lac crName
    dac fiPb+FS_PNAME
    lac nvB
    dac fiPb+FS_PBLOCKS
    dzm fiPb+FS_PINFO
    lac [FD_IO]
    dac fiPb+FS_PCFD
    lac [fiPb:.]
    farjda(fsCreate:*)
    jmp i cvX

// fiErr -- a library failure, its status in AC, as an error. Reached by jmp.
fiErr, lia
    jsp fiStMsg
    jmp i [exErr:EX_BANK]

// fiStMsg -- the message for the library's status in IO (section 9).
// AC is its full address; IO is clobbered.
fiStMsg, dac smX
    dio smS
    lac smS
    SKIP_NEXT_IF_DIFFERENT [FS_ENOUNIT]
    jmp smNr
    SKIP_NEXT_IF_DIFFERENT [FS_ENOMEDIUM]
    jmp smNr
    SKIP_NEXT_IF_DIFFERENT [FS_ETIMEOUT]
    jmp smNr
    SKIP_NEXT_IF_DIFFERENT [FS_ELOCKED]
    jmp smLk
    SKIP_NEXT_IF_DIFFERENT [FS_ENOFS]
    jmp smBd
    SKIP_NEXT_IF_DIFFERENT [FS_EEXISTS]
    jmp smEx
    SKIP_NEXT_IF_DIFFERENT [FS_ENOTFOUND]
    jmp smNf
    SKIP_NEXT_IF_DIFFERENT [FS_EDIRFULL]
    jmp smDf
    SKIP_NEXT_IF_DIFFERENT [FS_ENOSPACE]
    jmp smFull
    SKIP_NEXT_IF_DIFFERENT [FS_ERANGE]
    jmp smFull
    SKIP_NEXT_IF_DIFFERENT [FS_EREADONLY]
    jmp smRo
    SKIP_NEXT_IF_DIFFERENT [FS_EXFER]
    jmp smDr
    SKIP_NEXT_IF_DIFFERENT [FS_ENAME]
    jmp smNm
    lac [mIoErr:MSG_BANK]
    jmp i smX
smNr, lac [mUnitNR:MSG_BANK]
    jmp i smX
smLk, lac [mLocked:MSG_BANK]
    jmp i smX
smBd, lac [mBadDir:MSG_BANK]
    jmp i smX
smEx, lac [mExists:MSG_BANK]
    jmp i smX
smNf, lac [mNoEnt:MSG_BANK]
    jmp i smX
smDf, lac [mDirFull:MSG_BANK]
    jmp i smX
smFull, lac pDev
    SKIP_NEXT_IF_SAME [FK_DRUM]
    jmp smTf
    lac [mDrumFull:MSG_BANK]
    jmp i smX
smTf, lac [mTapeFull:MSG_BANK]
    jmp i smX
smRo, lac [mPerm:MSG_BANK]
    jmp i smX
smDr, lac [mDrumFail:MSG_BANK]
    jmp i smX
smNm, lac [mBadName:MSG_BANK]
    jmp i smX

// --- sourcing: so and DR:EXRC

// soExrc -- the drum's EXRC, if there is one, sourced at a caller's greeting
// without a word when it is not there. AC and IO are clobbered.
soExrc, dac sxX
    law FK_DRUM
    dac pDev
    jsp fiMount
    SKIP_NEXT_IF_AC_ZERO
    jmp i sxX
    lac [nmExrc:.]
    dac opName
    dzm soRn                // nothing to put back after it
    jsp soOpen
    jmp i sxX

// soOpen -- the file at opName on fiHnd's volume opened on FD_SO, and its
// lines read as commands from the next line on. AC is the library's status;
// IO is clobbered.
soOpen, dac sooX
    lac [FD_SO]
    dac opFd
    jsp fiOpenN
    SKIP_NEXT_IF_AC_ZERO
    jmp i sooX
    lac fiHnd
    dac soHnd
    dzm soLeft
    dzm soHalf
    dzm soCR
    law 1
    dac soOn
    cla
    jmp i sooX

// soLine -- a line of the source file into the buffer at tlBuf, as tmLine
// gives one: at most tlMax characters, a character a word and a 0 word,
// tlLen its length. At the file's end, sourcing ends and ex goes on (jmp to
// exNext) with what followed so's line, put back in CMDBUF, or else the
// next line typed. AC is CH_LF, or 0 for a line too long; IO is clobbered.
soLine, dac slX
    dzm slN
    dzm slOver
    lac i [tlBuf:TERM_BANK]
    dac slP
slL, jsp soCh
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp slEof
    dac slC
    lac soCR
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp slNc
    dzm soCR
    lac slC
    SKIP_NEXT_IF_DIFFERENT [CH_LF]
    jmp slL
slNc, lac slC
    SKIP_NEXT_IF_DIFFERENT [CH_CR]
    jmp slCR
    SKIP_NEXT_IF_DIFFERENT [CH_LF]
    jmp slEnd
    lac slN
    sub i [tlMax:TERM_BANK]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp slFull
    lac slC
    dac i slP
    idx slP
    idx slN
    jmp slL
slFull, law 1
    dac slOver
    jmp slL
slCR, law 1
    dac soCR
slEnd, lac slN
    dac i [tlLen:TERM_BANK]
    dzm i slP
    lac slOver
    SKIP_NEXT_IF_AC_ZERO
    jmp slLong
    law CH_LF
    jmp i slX
slLong, cla
    jmp i slX
slEof, lac slN
    SKIP_NEXT_IF_AC_ZERO
    jmp slEnd
    dzm soOn
    law 1
    dac i [endline:EX_BANK]
    lac [SO_RST]
    dac soQ
    lac [CMDBUF]
    dac soQ2
    lac soRn
    dac soK
    dac i [cbEnd:EX_BANK]
    dzm i [cbPos:EX_BANK]
    dzm soRn
    jsp soCopy
    jmp i [exNext:EX_BANK]

// soCopy -- soK words from soQ to soQ2, full addresses. AC is clobbered,
// IO preserved.
soCopy, dac scpX
scpL, lac soK
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i scpX
    lac i soQ
    dac i soQ2
    idx soQ
    idx soQ2
    lac soK
    sub [1]
    dac soK
    jmp scpL

// soCh -- the source file's next character, as fiRdCh reads a file, a block
// at a time through SO_BUF. AC is the character, 0 at the end; IO is
// clobbered. A library failure ends sourcing with its message.
soCh, dac shX
shL, lac soHalf
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp shHi
    dzm soHalf
    lac soW
    and [0177]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp shL
    jmp i shX
shHi, lac soLeft
    SKIP_NEXT_IF_AC_ZERO
    jmp shW
    lac [FD_SO]
    dac fiSoPb+FS_PFDESC
    lac [SO_BUF]
    dac fiSoPb+FS_PBUF
    lac [FS_BLKW]
    dac fiSoPb+FS_PCOUNT
    lac [fiSoPb:.]
    farjda(fsRead:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp shErr
    dio soLeft
    lac soLeft
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i shX
    lac [SO_BUF]
    dac soP
shW, lac i soP
    dac soW
    idx soP
    lac soLeft
    sub [1]
    dac soLeft
    law 1
    dac soHalf
    lac soW
    rar 9s
    and [0177]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp shL
    jmp i shX
shErr, dzm soOn
    lia
    jsp fiStMsg
    jmp i [exErr:EX_BANK]

// --- helpers

// fiTgOpen -- :ta's tags file (subst.ac), the name at the full address in
// IO as fnParse takes it, opened for fiTgLine. A file that cannot be read,
// or is on paper tape or the printer, is passed over, as 3.7 passes over one
// it cannot open. AC is 0 when it is open, else 1; IO is clobbered.
fiTgOpen, dac ftoX
    jsp fnParse
    lac pDev
    dac rdDev
    SKIP_NEXT_IF_DIFFERENT [FK_PC]
    jmp ftoNo
    SKIP_NEXT_IF_DIFFERENT [FK_LP]
    jmp ftoNo
    jsp fiMount
    SKIP_NEXT_IF_AC_ZERO
    jmp ftoNo
    lac [fiLib:.]
    dac opName
    lac [FD_IO]
    dac opFd
    jsp fiOpenN
    SKIP_NEXT_IF_AC_ZERO
    jmp ftoNo
    jsp fiRdInit
    cla
    jmp i ftoX
ftoNo, law 1
    jmp i ftoX
ftoX, 0

// fiTgLine -- the tags file's next line into LINEBUF (fiGetLn).
// AC is 0 for a line, 1 at the end; IO is clobbered.
fiTgLine, dac ftlX
    jsp fiGetLn
    jmp i ftlX
ftlX, 0

// fiTgFile -- whether the name at the full address in IO, parsed into
// FN_FILE, is another file than the one being edited (3.7's strcmp with
// savedfile, or not edited). AC is 1 for another, 0 for the same; IO is
// clobbered.
fiTgFile, dac ftfX
    jsp fnParse
    lac fiEdited
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ftfOth
    lac [FN_FILE]
    dac scS
    lac [FN_CUR]
    dac scD
    jsp strEq
    xor [1]
    jmp i ftfX
ftfOth, law 1
    jmp i ftfX
ftfX, 0

// fiInitBuf -- 3.7's init: the buffer empty, not edited, not cut short.
// AC and IO are clobbered.
fiInitBuf, dac ibX
    jsp i [lnReset:0]
    dzm fiEdited
    dzm fiCut
    jmp i ibX

// fiNoChng -- 3.7's nochng: no change since the command began, for
// autoprint. AC is clobbered, IO preserved.
fiNoChng, dac ncX
    lac CHNG
    dac i [lchng:EX_BANK]
    jmp i ncX

// fiQName -- "name" typed, for the string at the full address in IO.
// AC and IO are clobbered.
fiQName, dac qnX
    dio i [msgS:MSG_BANK]
    lio [mQName:MSG_BANK]
    jsp i [msgPut:MSG_BANK]
    jmp i qnX

// strCpy -- the string at scS, a character a word ending in a 0 word, copied
// to scD. AC is clobbered, IO preserved; scS and scD are moved.
strCpy, dac scX
scL, lac i scS
    dac i scD
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i scX
    idx scS
    idx scD
    jmp scL

// strEq -- whether the strings at scS and scD are the same. AC is 1 or 0;
// IO is preserved; scS and scD are moved.
strEq, dac seX
seL, lac i scS
    SKIP_NEXT_IF_SAME i scD
    jmp seNo
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp seYes
    idx scS
    idx scD
    jmp seL
seYes, law 1
    jmp i seX
seNo, cla
    jmp i seX

