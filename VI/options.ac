oTimeout, 1
    0
opTty,
    nTty:EX_BANK
    aTty:EX_BANK
    O_TERM
    0
    0
    0
    nWarn:EX_BANK
    0
    O_ONOFF
    1
oWarn, 1
    0
opWin,
    nWi:EX_BANK
    aWi:EX_BANK
    O_NUM
    0d23
oWindow, 0d23
    0
    nWs:EX_BANK
    aWs:EX_BANK
    O_ONOFF
    1
oWrapScan, 1
