    O_ONOFF
    0
oIgnCase, 0
    0
opLines,
    nLines:EX_BANK
    0
    O_NUM
    0d24
oLines, 0d24
    0
    nList:EX_BANK
    0
    O_ONOFF
    0
oList, 0
    0
    nMagic:EX_BANK
    0
    O_ONOFF
    1
oMagic, 1
    0
    nNu:EX_BANK
    aNu:EX_BANK
    O_ONOFF
    0
oNumber, 0
    0
    nPara:EX_BANK
    aPara:EX_BANK
    O_STR
    0
    OPT_STR
    dPara:EX_BANK
    nPrompt:EX_BANK
    0
    O_ONOFF
