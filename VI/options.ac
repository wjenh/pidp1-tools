oReadOnly, 0
    0
    nRemap:EX_BANK
    0
    O_ONOFF
    1
oRemap, 1
    0
    nReport:EX_BANK
    0
    O_NUM
    5
oReport, 5
    0
    nScr:EX_BANK
    aScr:EX_BANK
    O_NUM
    0d11
oScroll, 0d11
    0
    nSect:EX_BANK
    aSect:EX_BANK
    O_STR
    0
    OPT_STR+OPT_SLEN
    dSect:EX_BANK
    nSw:EX_BANK
    aSw:EX_BANK
    O_NUM
    TAB_STOP
oShiftW, TAB_STOP
    0
    nSm:EX_BANK
    aSm:EX_BANK
    O_ONOFF
    0
oShowMat, 0
    0
    nSlow:EX_BANK
    aSlow:EX_BANK
    O_ONOFF
    0
oSlowOpen, 0
    0
    nTs:EX_BANK
    aTs:EX_BANK
    O_NUM
    TAB_STOP
oTabStop, TAB_STOP
    0
    nTl:EX_BANK
    aTl:EX_BANK
    O_NUM
    0
oTagLen, 0
    0
    nTags:EX_BANK
    aTags:EX_BANK
    O_STR
    0
    OPT_STR+2*OPT_SLEN
    dTags:EX_BANK
    nTerm:EX_BANK
    0
    O_TERM
    0
    0
