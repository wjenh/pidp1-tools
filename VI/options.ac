optEnd,
    assert optEnd - optTab == NOPTS*OPT_WORDS, "an entry for every option"
    assert OPT_STR + 3*OPT_SLEN <= 0130000, "the strings fit bank 10"

oTerm, TERM_DUMB            // term and ttytype: a TERM_ code

// The terminals' names, in TERM_ order, then 0.
termNames,
    tDumb:EX_BANK
    tVt100:EX_BANK
    tVt102:EX_BANK
    0
    assert TERM_DUMB == 0 && TERM_VT100 == 1 && TERM_VT102 == 2, "termNames' order"

nAi,     ascii "autoindent"
aAi,     ascii "ai"
nAp,     ascii "autoprint"
aAp,     ascii "ap"
nAw,     ascii "autowrite"
aAw,     ascii "aw"
nBf,     ascii "beautify"
aBf,     ascii "bf"
nCo,     ascii "columns"
nEd,     ascii "edcompatible"
aEd,     ascii "ed"
nEb,     ascii "errorbells"
aEb,     ascii "eb"
nHt,     ascii "hardtabs"
aHt,     ascii "ht"
nIc,     ascii "ignorecase"
aIc,     ascii "ic"
nLines,  ascii "lines"
nList,   ascii "list"
nMagic,  ascii "magic"
nNu,     ascii "number"
aNu,     ascii "nu"
nPara,   ascii "paragraphs"
aPara,   ascii "para"
