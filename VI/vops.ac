// vops.ac -- vi's changes, after 3.7's ex_vops.c, the
// change commands of ex_vmain.c and operate()'s operators (ex_voper.c): the
// operators d c y < > on every motion, x X D (vmotion.ac's), C s S r J p P
// Y & ~, u, U and ., the registers and the unnamed buffer. Insert mode is
// vinsert.ac's.
//
// A change within dot's line is made at once, as a new record for the line
// (lines.ac's lnRepl), undoable by ex's undo; 3.7 kept it in linebuf until
// the cursor left the line (vsave). So U's line comes from uSync, dot's line
// as it was before vi's first change on it since dot came there (3.7's
// *dot), when U's line is taken while that line has such changes.
//
// The unnamed buffer, 3.7's save area as put sees it, is register slot 0:
// the lines the last delete, change, yank or join of lines took, or the
// lines an undo took out; vPk, vPk0 and vPk1 say they started and ended
// within a line (3.7's pkill). A change within a line empties it (3.7's
// squish) and keeps its text in DEL, which p puts in as an insert.
//
// The last change's keys are kept for . as 3.7 keeps them: the command's key
// and an operator's motion key (vWcmd, as typed, copied to vLcmd by
// vSetLast), its count, whether it had one, and its register; an insert's
// text is INS. . replays them through vmain.ac's vGetKey (vGlob).
//
// Commands are reached by jmp from vmain.ac's table and end at viLoop;
// routines are entered by jsp and return by jmp i. In bank VI_BANK. Needs
// vi.ah, <AIDS/skipmacros.ah>, vmain.ac and vmotion.ac, lines.ac (bank 0),
// excmd.ac and options.ac (bank EX_BANK), screen.ac and vinsert.ac (bank
// SCR_BANK), termio.ac (bank TERM_BANK) and messages.ac (bank MSG_BANK).

local vcOp1, vcOi, \
    vspY, voDg, voDn, voMul, voML, voCap, voMd, voKey, voQ, voGo, vog1, xwSw, \
    xwOrd, xwWh, xwCnt, xw1, xw2, xwE, yr1, slL, slE, dm1, sdL, sdE, sdOv, \
    ctL, ctE, vrP, vyIn, vy1, vy2, vy3, vyNs, vpU, vpR, vp1, vp2, vp3, vp4, \
    vp5, vp6, vpPt, vpWh, vpNo, vpE, vrK, vrQ, vr1, tl1, tl2, vcIns, vuMi, \
    vuM, vuF, vuE, vuN, vuE1, vuE2, vdR, vdG, vnZ, vn1, svY, sv2, plF, pl0, \
    xfS, xfU, dwL, dwS, dwO, dwW, dwN, dwE, vlnX, vgdX, vlnP, xwX, xwN, yrX, \
    yrC, slX, slS, slD, awX, awC, dmX, sdlX, sbD, sbN, sbS, ctX, ctD, ctS, \
    ctN, cmX, scyX, urX, ur1, ur2, klX, ukX, vcN, vcA, vU, vyN, vpS, vpPart, \
    vpA, vpN, tlP, tlC, vuD, vnoX, svnX, svL, plcX, dwX, dwV, dwZ, dwP, dwT, \
    dwD, xfX, veM, voN, voA, vqP, jN, jM, shN

// --- the operators

// d c y < > -- an operator: a second count multiplies the first, then the
// motion's key, read as 3.7's getesc (ESC cancels, ^V and ^Q quote), names
// the other end; the operator's key again is _, the line itself.
vcOper, lac vC
    dac vOp
    jsp vKey
    dio vU
    lac vU                  // a second count, 1 to 9 first
    sub [CH_0+1]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp voKey
    sub [0d9]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp voKey
    dzm voN
voDg, lac voN               // 3.7's vgetcnt
    sub [COUNT_CAP]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp voDn
    lac voN
    ral 2s                  // times 10
    add voN
    ral 1s
    add vU
    sub [CH_0]
    dac voN
voDn, jsp vKey
    dio vU
    lac vU
    sub [CH_0]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp voMul
    sub [0d10]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp voMul
    jmp voDg
// the counts multiplied, no further than COUNT_CAP
voMul, lac vCnt
    dac voA
    dzm vCnt
voML, lac voN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp voMd
    sub [1]
    dac voN
    lac vCnt
    add voA
    dac vCnt
    sub [COUNT_CAP]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp voCap
    jmp voML
voCap, lac [COUNT_CAP]
    dac vCnt
voMd, lac vCnt
    dac vXcnt
voKey, lac vU
    SKIP_NEXT_IF_DIFFERENT [CH_ESC]
    jmp viLoop
    SKIP_NEXT_IF_DIFFERENT [CH_CTLV]
    jmp voQ
    SKIP_NEXT_IF_DIFFERENT [CH_CTLQ]
    jmp voQ
    jmp voGo
voQ, jsp vKey
    dio vU
voGo, lio vU                // mapped, as 3.7's operate maps it
    jsp i [kyMot:TERM_BANK]
    dio vU
    lac vSub                // kept for ., unless s, C or S gave it
    SKIP_NEXT_IF_AC_NOT_ZERO
    jsp vAddW
    lac vU
    dac vC
    lac vCurs
    dac vOpCur
    jmp vMotion

// vOpGo -- where a motion ends under an operator (vmotion.ac's vMove): a
// register named makes the range name a line, so that it is yanked (3.7's
// "if (vreg && wdot == 0) wdot = dot"); then the operator. Reached by jmp.
vOpGo, lac vReg
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp vog1
    lac wSet
    SKIP_NEXT_IF_AC_ZERO
    jmp vog1
    lac DOT
    dac wDot
    law 1
    dac wSet
vog1, lac vOp
    SKIP_NEXT_IF_DIFFERENT [0144]           // d
    jmp vDel
    SKIP_NEXT_IF_DIFFERENT [0143]           // c
    jmp i [vChg:SCR_BANK]
    SKIP_NEXT_IF_DIFFERENT [0171]           // y
    jmp vYank
    jmp vShift

// vXdw -- 3.7's xdw: a range that names no line, or one past the buffer, is
// the bell; else lastcmd is kept (vSetLast), the ends are put in order (dot
// and vOpCur first), a range ending at a later line's start is made to end
// at the end of the line before, or whole lines when it starts at or before
// its first line's first character that is not white; the lines are
// yanked into the register named, and for the keys d and c into "1.
// AC is the range's lines; IO is clobbered, and LINEBUF.
vXdw, dac xwX
    lac wSet
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp vFail
    lac wDot
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp .+2
    jmp vFail
    sub DOL
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp vFail
    jsp vSetLast
    lac DOT
    sub wDot
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp xwSw                // dot after wdot
    SKIP_NEXT_IF_AC_ZERO
    jmp xwOrd
    lac wCur                // the same line: the cursor after wcursor
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp xwOrd
    lac vOpCur
    sub wCur
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp xwSw
    jmp xwOrd
xwSw, lac DOT
    lio wDot
    dac wDot
    dio DOT
    lac vOpCur
    lio wCur
    dac wCur
    dio vOpCur
// wcursor at the start of a later line
xwOrd, lac vOpCur
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp xwCnt
    lac wCur
    SKIP_NEXT_IF_AC_ZERO
    jmp xwCnt
    lac wDot
    sub DOT
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp .+2
    jmp xwCnt
    lac wDot
    sub [1]
    dac wDot
    jsp vFirst
    sub vOpCur
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp xwWh
    lio wDot
    jsp vLenOf
    dac wCur
    jmp xwCnt
xwWh, lac [0777776]
    dac wCur
xwCnt, lac wDot
    sub DOT
    add [1]
    dac xwN
    lac vReg
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp xw1
    lia
    jsp vYReg
xw1, dzm vReg
    lac vOpKey
    SKIP_NEXT_IF_DIFFERENT [0144]
    jmp xw2
    SKIP_NEXT_IF_DIFFERENT [0143]
    jmp xw2
    jmp xwE
xw2, lio [CH_0+1]
    jsp vYReg
xwE, lac xwN
    jmp i xwX

// vYReg -- 3.7's YANKreg for the register in IO: lines dot to wDot, from
// column vOpCur and to wCur when both are given (a partial yank).
// AC and IO are clobbered, and LINEBUF.
vYReg, dac yrX
    dio yrC
    lac DOT
    dac LNA
    lac wDot
    dac LNB
    dzm i [rgPart:0]
    lac vOpCur
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp yr1
    dac i [rgPC:0]
    lac wCur
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp yr1
    dac i [rgPW:0]
    law REG_PART
    dac i [rgPart:0]
yr1, lio yrC
    jsp i [rgYank:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp vNoMem
    jmp i yrX

// vSetLast -- 3.7's setLAST: unless . is replaying, this command's keys,
// count, whether it had one, and its register, kept for the next .
// AC is clobbered, IO preserved.
vSetLast, dac slX
    lac vGlob
    SKIP_NEXT_IF_AC_ZERO
    jmp i slX
    lac vReg
    dac vLReg
    lac vHad
    dac vLHad
    lac vXcnt
    dac vLCnt
    lac [vWcmd:VI_BANK]
    dac slS
    lac [vLcmd:VI_BANK]
    dac slD
slL, lac slS
    SKIP_NEXT_IF_DIFFERENT vWcP
    jmp slE
    lac i slS
    dac i slD
    idx slS
    idx slD
    jmp slL
slE, dzm i slD
    jmp i slX

// vAddW -- the key in IO added to this command's keys (3.7's *lastcp++),
// seven at most. AC is clobbered, IO preserved.
vAddW, dac awX
    dio awC
    lac vWcP
    sub [vWcmd:VI_BANK]
    sub [7]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i awX
    lac awC
    dac i vWcP
    idx vWcP
    jmp i awX

// --- d

// vDel -- 3.7's vdelete: lines, or within dot's line; a range that starts
// or ends within a line is vChg's. Reached by jmp.
vDel, lac wSet
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp vdIn
    lac wCur
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i [vChgD:SCR_BANK]
vdLn, dzm vSyncLn            // whole lines (3.7's vsave)
    jsp vXdw
    dac vcN
    dac vsN
    dzm vsM
    jsp vSaveN
    lac DOT
    dac vcA
    dac LNA
    add vcN
    sub [1]
    dac LNB
    jsp i [lnDelete:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp vNoUnd
    lac vcA
    dac LNA
    jsp i [lnAppNone:0]
    jsp vKillLn
    jsp vKillU
    law VU_MANY
    dac vUndK
    lac vcN
    dac vNcnt
    lac [nmDel:MSG_BANK]
    dac vNnam
    jsp vNote
    jsp vPlace
    jmp viLoop
// within the line: the text taken out, kept in DEL
vdIn, jsp vGetDot
    lac wCur
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    dzm wCur
    lac vOpCur
    SKIP_NEXT_IF_DIFFERENT wCur
    jmp vFail
    jsp vDcMid
    jsp vSetDel
    jsp vCut
    jsp vCommit
    lac vOpCur              // the cursor there, back one at the line's end
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp vdC
    SKIP_NEXT_IF_SAME LBLEN
    jmp vdC
    sub [1]
vdC, dac vCurs
    jmp viLoop

// vDcMid -- 3.7's vdcMID: the ends in order, lastcmd kept, u's cursor the
// change's start. AC and IO are clobbered.
vDcMid, dac dmX
    jsp vSetLast
    lac wCur
    sub vOpCur
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp dm1
    lac vOpCur
    lio wCur
    dac wCur
    dio vOpCur
dm1, lac vOpCur
    dac vUcur
    jmp i dmX

// vSetDel -- 3.7's setDEL: LINEBUF from vOpCur to wCur into DEL, or DEL
// marked OVERBUF when VBSIZE cannot hold it. AC is clobbered, IO preserved.
vSetDel, dac sdlX
    lac [vDEL:SCR_BANK]
    dac sbD
    lac wCur
    sub vOpCur
    dac sbN
    sub [VBSIZE-1]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp sdOv
    lac vOpCur
    add [LINEBUF]
    dac sbS
sdL, lac sbN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sdE
    lac i sbS
    dac i sbD
    idx sbS
    idx sbD
    lac sbN
    sub [1]
    dac sbN
    jmp sdL
sdOv, law OVERBUF
    dac i sbD
    idx sbD
sdE, dzm i sbD
    jmp i sdlX

// vCut -- LINEBUF without its characters vOpCur to wCur. AC is clobbered,
// IO preserved.
vCut, dac ctX
    lac vOpCur
    add [LINEBUF]
    dac ctD
    lac wCur
    add [LINEBUF]
    dac ctS
    lac LBLEN
    sub wCur
    add [1]                 // and the 0 after
    dac ctN
ctL, lac ctN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ctE
    lac i ctS
    dac i ctD
    idx ctS
    idx ctD
    lac ctN
    sub [1]
    dac ctN
    jmp ctL
ctE, lac LBLEN
    sub wCur
    add vOpCur
    dac LBLEN
    jmp i ctX

// vCommit -- LINEBUF as dot's line, a change within it: U's line kept first
// (vSyncChk), undoable at once (lnRepl), the unnamed buffer emptied (3.7's
// squish); u's kind VU_CHNG. No room is Out of memory, or Out of memory
// saving lines for undo. AC and IO are clobbered.
vCommit, dac cmX
    jsp vSyncChk
    jsp i [putLine:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp vNoMem
    dac i [lnR:0]
    jsp i [lnRepl:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp vNoUnd
    jsp vSquish
    law VU_CHNG
    dac vUndK
    lac DOT
    dac vUdot
    jmp i cmX

// vSyncChk -- before vi's first change on dot's line since dot came there,
// the line as it is, as 3.7's *dot (uSync). AC and IO are clobbered.
vSyncChk, dac scyX
    lac vSyncLn
    SKIP_NEXT_IF_DIFFERENT DOT
    jmp i scyX
    lac DOT
    dac vSyncLn
    lio DOT
    jsp i [lnPtr:0]
    dac i [uSync:0]
    jmp i scyX

// vURec -- 3.7's vmove within a line: U's line taken, the first time the
// cursor moves within a line it has not been on since U's line was
// forgotten. AC and IO are clobbered.
vURec, dac urX
    lac i [uLnum:0]
    SKIP_NEXT_IF_DIFFERENT DOT
    jmp i urX
    lac DOT
    dac i [uLnum:0]
    lac vSyncLn
    SKIP_NEXT_IF_SAME DOT
    jmp ur1
    lac i [uSync:0]
    jmp ur2
ur1, lio DOT
    jsp i [lnPtr:0]
ur2, dac i [uLine:0]
    jmp i urX

// vKillU -- 3.7's killU: U's line forgotten. AC is clobbered, IO
// preserved.
vKillU, dac ukX
    dzm i [uLnum:0]
    jmp i ukX

// vKillLn -- the unnamed buffer undo's list, whole lines: the lines a change
// of lines took (3.7's save area); DEL emptied. AC is clobbered, IO
// preserved.
vKillLn, dac klX
    lac i [undList:0]
    dac i [REG_BASE]
    dzm i [REG_BASE+1]
    dzm vPk
    dzm i [vDEL:SCR_BANK]
    jmp i klX

// vSquish -- the unnamed buffer emptied (3.7's squish). AC is clobbered, IO
// preserved.
vSquish, dac klX
    dzm i [REG_BASE]
    dzm i [REG_BASE+1]
    dzm vPk
    jmp i klX

// --- y

// vYank -- 3.7's vyankit: lines (into the unnamed buffer, and the register
// named), or within dot's line (into DEL). Reached by jmp.
vYank, lac wSet
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp vyIn
    jsp vXdw
    dac vyN
    lac DOT
    dac LNA
    add vyN
    sub [1]
    dac LNB
    jsp i [lnSave:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp vNoUnd
    dzm i [undKind:0]       // a yank is not undone (3.7's UNDNONE)
    jsp vKillLn
    lac wCur                // 3.7's setpk
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp vy1
    law 1
    dac vPk
    dac i [REG_BASE+1]
    lac vOpCur
    dac vPk0
    lac wCur
    dac vPk1
vy1, dzm vUndK
// the note, unless the lines are all on the screen and fewer than report
    lac vyN
    dac vNcnt
    lac [nmYank:MSG_BANK]
    dac vNnam
    law 1
    dac vNsav
    lac DOT
    sub i [scTop:SCR_BANK]
    sub i [scCnt:SCR_BANK]
    add vyN
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp vyNs
    lac vyN
    sub i [oReport:EX_BANK]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp vyNs
    dzm vNsav
vyNs, jsp vNote
    lac vOpCur              // the cursor as it was, or the start's
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp vy2
    jsp vPlace
    jmp viLoop
vy2, dac vCurs
    jmp viLoop
// within the line: 3.7's takeout(DEL), the cursor to the start
vyIn, jsp vGetDot
    lac wCur
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    dzm wCur
    lac vOpCur
    SKIP_NEXT_IF_DIFFERENT wCur
    jmp vFail
    lac wCur
    sub vOpCur
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp vy3
    lac vOpCur
    lio wCur
    dac wCur
    dio vOpCur
vy3, jsp vSetDel
    lac i [vDEL:SCR_BANK]
    SKIP_NEXT_IF_DIFFERENT [OVERBUF]
    jsp i [ringBell:TERM_BANK]
    lac vOpCur
    dac vCurs
    jmp viLoop

// --- < >

// vShift -- 3.7's vshftop: the lines shifted by ex's < or >, with a count
// of them, dot then their first line (vXDone's vXKind 2). Reached by jmp.
vShift, jsp vXdw
    dac shN
    lac vOp
    dac i [CMDBUF]
    law CH_SP
    dac i [CMDBUF+1]
    lac [CMDBUF+2]
    dac vqP
    lio shN
    jsp vDecW
    law 2
    dac vXKind
    lac DOT
    dac vXDot
    jmp vExec

// --- the change commands

// x, X, D are vmotion.ac's (3.7's deleteit, which needs the scanners).

// C -- c$, or a on an empty line. s -- c and a blank, 3.7's c<space>. S --
// cc. Y -- yy. The key that follows is put back and not kept for .
vcBigC, jsp vGetDot
    lac LBLEN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp vcSmA
    law CH_DOLLAR
    jmp vcCs
vcSmS, law CH_SP
    jmp vcCs
vcBigS, law CH_USCORE
vcCs, dac vPeek
    law 1
    dac vSub
    law 0143
    dac vC
    jmp vcOper
vcBigY, law CH_USCORE
    dac vPeek
    law 0171
    dac vC
    jmp vcOper

// r -- the count's characters replaced by the next key, 3.7's vrep: insert
// mode reading one key over them; that key kept for . after the r.
vcR, jsp vGetDot
    lac LBLEN
    sub vCurs
    sub vCnt
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp vFail
    lac vGlob
    SKIP_NEXT_IF_AC_ZERO
    jmp vr1
    jsp vGetKey             // 3.7's getesc, the key then put back
    dio vU
    lac vU
    SKIP_NEXT_IF_DIFFERENT [CH_ESC]
    jmp viLoop
    SKIP_NEXT_IF_DIFFERENT [CH_CTLV]
    jmp vrQ
    SKIP_NEXT_IF_DIFFERENT [CH_CTLQ]
    jmp vrQ
    sub [KY_UP]             // an arrow, DEL or ^C: put back, nothing replaced
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp vrK
    lac vU
    SKIP_NEXT_IF_DIFFERENT [CH_DEL]
    jmp vrK
    SKIP_NEXT_IF_DIFFERENT [CH_CTLC]
    jmp vrK
    jmp vrP
vrK, lac vU
    dac vPeek
    jmp viLoop
vrQ, jsp vGetKey
    dio vU
vrP, lac vU
    dac vPeek
vr1, law VU_CHNG
    dac vUndK
    lac vCurs
    dac vUcur
    law 0162
    dac viCh
    lac vCnt
    dac viCnt
    dac viS0
    dzm viDol
    law 1
    dac viUnd
    lac [vrDone:VI_BANK]
    dac viRet
    jmp i [vaGo:SCR_BANK]
vrDone, lio i [vINS:SCR_BANK]
    jsp vAddW
    jsp vSetLast
    jmp viLoop

// ~ -- 3.7's "r", the character with its case changed, then a blank to step
// on unless it is the line's last: the count is not used.
vcTilde, jsp vSetLast
    jsp vGetDot
    lac vCurs
    SKIP_NEXT_IF_DIFFERENT LBLEN
    jmp vFail
    add [LINEBUF]
    dac tlP
    lac i tlP
    dac tlC
    and [0137]              // a letter's case changed
    sub [CH_A]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp tl1
    sub [0d26]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp tl1
    lac tlC
    xor [040]
    dac tlC
tl1, lac tlC
    dac i tlP
    lia                     // INS, as r's would be
    jsp i [vaIns1:SCR_BANK]
    lac vCurs
    dac vUcur
    jsp vCommit
    lac vCurs
    add [1]
    SKIP_NEXT_IF_DIFFERENT LBLEN
    jmp viLoop
    dac vCurs
    jsp vURec
    jmp viLoop

// J -- the count's lines joined, two at least, by ex's j (vXKind 1): the
// cursor where the first line ended, back one at the line's end.
vcJ, lac DOT
    SKIP_NEXT_IF_DIFFERENT DOL
    jmp vFail
    lac vCnt
    SKIP_NEXT_IF_DIFFERENT [1]
    law 2
    dac jN
    lac DOL
    sub DOT
    add [1]
    dac jM
    lac jN
    sub jM
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
