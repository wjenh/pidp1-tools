// vmotion.ac -- vi's motions, after 3.7's operate()
// with vmove as its operator (ex_voper.c), its scanners (ex_vops3.c: lfind,
// lnext, lskipa1, endsent, endPS, isa, lmatchp, lskipbal, lbrack) and its
// search (ex_addr.c's address with a cursor in the line; its offsets are
// vaddr.ac's, in bank FILE_BANK).
//
// A motion computes 3.7's wdot and wcursor: wDot with wSet when it names a
// line, wCur an index in that line or -1 for none (3.7's NOSTR); LINEBUF
// holds wDot's line while the scanners walk (wLoad). vMove then does what
// vmove does: a line named goes through screen.ac's scDown or scUp (scHold
// for ', `, [[ and ]], 3.7's HOLDWIG), the cursor then at wCur, or the
// column vMovCol when vMoving, or the first character that is not white;
// no line named moves the cursor in dot's line. A motion that cannot be
// made is the bell (vmain.ac's vFail). Under an operator (vops.ac's vOp not
// 0, 3.7's opf not vmove) a motion marks nothing, some end a character
// further on, and vMove hands the range to vops.ac's vOpGo; the operator's
// key again (dd) is _, the line itself. x, X and D are 3.7's deleteit.
//
// Reached by jmp from vmain.ac's loop (vMotion) with the key in vC and the
// count in vCnt and vHad; routines entered by jsp, returning by jmp i. In
// bank VI_BANK. Needs vi.ah, <AIDS/skipmacros.ah>, vmain.ac, lines.ac (bank
// 0), excmd.ac and options.ac (bank EX_BANK), regex.ac (bank RE_BANK),
// screen.ac (bank SCR_BANK) and termio.ac (bank TERM_BANK).

local mtL, mtHit, mvUd, mvDn, mvNl, mvFw, mvCur, wLoad, wAt, waZ, wCh, \
    wSpace, wsY, wBlank, wMargin, wmY, wEdge, weB, weY, wWordCh, wwY, \
    wWordOf, woN, woY, wNext, wnEnd, wnB, wnB1, wnY, wnN, wLimit, mhL, mhE, \
    mhOk, mdLn, mjk, mpm, mLine, mMk, mWd, mwL, mwE, mwLn, mE, vWord, vwF, \
    vwF2, vwF3, vwB, vwB1, vwB2, vwB3, vwB4, vwB5, vwY, vwN, vwBk, vEend, \
    veB, veW, veL, veN, veE, mfSet, mfGo, mfL, mfF, mfFix, mPs, vLfind, lf1, \
    lf2, lf3, lfBeg, lfFnd, lfCnt, lfOn, lfOn1, lfOn2, lfDone, lfRev, lfRv1, \
    lfAdv, lfA1, lfA2, lfRet, lfIc, vSkipA1, saL, sa1, sa2, saSol, saS2, \
    saS3, saY, saN, vEndSent, es1, es2, esPs, esY, esN, vEndPS, epY, vIsa, \
    isL, isY, isN, mpL, mpS, mpNx, mpGot, mpCl, mpGo, mpB, mpDn, mpUp, mpLvS, \
    mbL, mbOut, mbHit, mAp, map1, map2, map3, map4, vMarkReg, mrPrev, mrNo, \
    srN, srGo, srFw, srBk, srQ, srQe, srNope, srNb, srTry, srMiss, srBot, \
    srTop, srFnd, srF1, srF2, srF3, srDo, srD1, srD2, srD3, srD4, srAdv, \
    srCtx, scx1, mtP, wlX, waX, wT, wcX, wsX, wbX, wmX, weX, wwX, wT2, woX, \
    wnX, wiX, vwX, vbkX, veeX, mfK, mfC, lfX, lfRc, lfIC, lfID, lcX, saX, \
    esX, esP, esC, epX, isX, isC1, isC2, mpC, mpP, mpO, mpE, mpLv, mbA, mmI, \
    mmB, mrX2, mrC, mdX, miX, miA, srC, srP, srT, srIn, srA, srLast, srZ, \
    sdvX, scxX, mtNo, mvIn, mhB, mdOp, mdOl, vwF1, vwF4, mpMk, mpFw, srOl, \
    srOp, \
    mpSet, mbG, mbSec, mbEnd, vxGo, vxL, vxE, vwIc, vwId, srD0

// vMotion -- the motion of key vC, or the bell for a key that is none; under
// an operator its own key again is _ (3.7's stuttered operators).
vMotion, lac DOT
    dac wDot
    dzm wSet
    dzm vHold
    lac vCurs
    dac wCur
    law 1
    dac vDir
    jsp wLoad
    lac [vMoTab:SCR_BANK]
    dac mtP
mtL, lac i mtP
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp mtNo
    SKIP_NEXT_IF_DIFFERENT vC
    jmp mtHit
    idx mtP
    idx mtP
    jmp mtL
mtHit, idx mtP
    lac i mtP
    dac mtP
    jmp i mtP
mtNo, lac vOp
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp vFail
    lac vC
    SKIP_NEXT_IF_SAME vWcmd
    jmp vFail
    jmp vmUs

// vMove -- 3.7's vmove, as above; under an operator, vops.ac's vOpGo.
// U's line forgotten on a move to another line, and taken on the line the
// move ends on (3.7's vnline calls vmove). Reached by jmp; ends at viLoop.
vMove, lac vOp
    SKIP_NEXT_IF_AC_ZERO
    jmp vOpGo
    lac wSet
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp mvIn
    lac wDot                // the line: 1 to dol
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp .+2
    jmp vFail
    sub DOL
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp vFail
    lac wDot
    SKIP_NEXT_IF_SAME DOT
    jsp vKillU
    lac vHold
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp mvUd
    lio wDot
    jsp i [scHold:SCR_BANK]
    jmp mvNl
// vupdown(wdot - dot, wcursor)
mvUd, dzm i [scInd:SCR_BANK]
    dzm i [scScr:SCR_BANK]
    lac wDot
    sub DOT
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp mvNl
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp mvDn
    cma
    dac i [scN:SCR_BANK]
    jsp i [scUp:SCR_BANK]
    jmp mvNl
mvDn, dac i [scN:SCR_BANK]
    jsp i [scDown:SCR_BANK]
// vnline(wcursor), whose vmove takes U's line on the line arrived at
mvNl, jsp vURec
    lac wCur
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp mvCur
    lac vMoving
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp mvFw
    lac vMovCol
    dac i [scN:SCR_BANK]
    lio DOT
    jsp i [scFindCol:SCR_BANK]
    dac vCurs
    jmp viLoop
mvFw, jsp vFirst
    dac vCurs
    jmp viLoop
mvIn, jsp vURec
mvCur, lac wCur
    dac vCurs
    jmp viLoop

// --- the scanners' primitives

// wLoad -- line wDot into LINEBUF, its length in wLen. AC and IO are
// clobbered.
wLoad, dac wlX
    lio wDot
    jsp i [lnPtr:0]
    lia
    jsp i [getLine:0]
    lac LBLEN
    dac wLen
    jmp i wlX

// wAt -- LINEBUF's character IO, 0 at or past the end or before the start.
// AC is it; IO is clobbered.
wAt, dac waX
    dio wT
    lac wT
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp waZ
    sub wLen
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp waZ
    lac wT
    add [LINEBUF]
    dac wT
    lac i wT
    jmp i waX
waZ, cla
    jmp i waX

// wCh -- the character at wCur (3.7's *wcursor). AC is it; IO is
// clobbered.
wCh, dac wcX
    lio wCur
    jsp wAt
    jmp i wcX

// wSpace -- whether the character in IO is a blank or a TAB (isspace).
// AC is 1 or 0; IO preserved.
wSpace, dac wsX
    dio wT
    lac wT
    SKIP_NEXT_IF_DIFFERENT [CH_SP]
    jmp wsY
    SKIP_NEXT_IF_DIFFERENT [CH_TAB]
    jmp wsY
    cla
    jmp i wsX
wsY, law 1
    jmp i wsX

// wBlank -- 3.7's blank(): whether wCur is on a blank or a TAB. AC is 1
// or 0; IO is clobbered.
wBlank, dac wbX
    jsp wCh
    lia
    jsp wSpace
    jmp i wbX

// wMargin -- 3.7's margin(): wCur before the line or at its end. AC is 1
// or 0; IO is clobbered.
wMargin, dac wmX
    lac wCur
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp wmY
    jsp wCh
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp wmY
    cla
    jmp i wmX
wmY, law 1
    jmp i wmX

// wEdge -- 3.7's edge(): the line empty, or wCur on its last character
// going forward, its first going back. AC is 1 or 0; IO is clobbered.
wEdge, dac weX
    lac wLen
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp weY
    lac vDir
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp weB
    lac wCur
    add [1]
    lia
    jsp wAt
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp weY
    cla
    jmp i weX
weB, lac wCur
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp weY
    cla
    jmp i weX
weY, law 1
    jmp i weX

// wWordCh -- 3.7's wordch: whether the character in IO is a letter, a
// digit or _. AC is 1 or 0; IO is clobbered.
wWordCh, dac wwX
    dio wT2
    lac wT2
    SKIP_NEXT_IF_DIFFERENT [CH_USCORE]
    jmp wwY
    lio wT2
    jsp i [isAlnum:EX_BANK]
    jmp i wwX
wwY, law 1
    jmp i wwX

// wWordOf -- 3.7's wordof(wWhich, wcursor): not white, and with wKind a
// word character as wWhich says. AC is 1 or 0; IO is clobbered.
wWordOf, dac woX
    jsp wBlank
    SKIP_NEXT_IF_AC_ZERO
    jmp woN
    lac wKind
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp woY
    jsp wCh
    lia
    jsp wWordCh
    SKIP_NEXT_IF_DIFFERENT wWhich
    jmp woY
woN, cla
    jmp i woX
woY, law 1
    jmp i woX

// wNext -- 3.7's lnext: wCur a character on in vDir, into the next line
// (wDot, LINEBUF) at the end of this one, no further than line vLim; at
// vLim going forward, back onto its last character unless under an
// operator.
// AC is 1, or 0 when stopped at vLim; IO is clobbered.
wNext, dac wnX
    lac vDir
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp wnB
    jsp wCh
    SKIP_NEXT_IF_AC_ZERO
    idx wCur
    jsp wCh
    SKIP_NEXT_IF_AC_ZERO
    jmp wnY
    lac wDot
    sub vLim
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp wnEnd
    idx wDot
    jsp wLoad
    dzm wCur
    jmp wnY
wnEnd, lac vOp
    SKIP_NEXT_IF_AC_ZERO
    jmp wnN
    lac wCur
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    sub [1]
    dac wCur
    jmp wnN
wnB, lac wCur
    sub [1]
    dac wCur
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp wnY
    lac wDot
    sub vLim
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp wnB1
    dzm wCur
    jmp wnN
wnB1, lac wDot
    sub [1]
    dac wDot
    jsp wLoad
    lac wLen
    SKIP_NEXT_IF_AC_ZERO
    sub [1]
    dac wCur
wnY, law 1
    jmp i wnX
wnN, cla
    jmp i wnX

// wLimit -- vLim the buffer's end in vDir: dol forward, 1 back.
// AC is clobbered.
wLimit, dac wiX
    lac DOL
    dac vLim
    lac vDir
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i wiX
    law 1
    dac vLim
    jmp i wiX

// --- the motions

// h, BS -- left; l, SP -- right: 3.7's margin and edge; under an operator
// the edge is no bar and the end of the line is not stepped back from.
vmH, lac [0777776]
    dac vDir
vmL, jsp wMargin
    SKIP_NEXT_IF_AC_ZERO
    jmp vFail
    lac vOp
    SKIP_NEXT_IF_AC_ZERO
    jmp mhL
    jsp wEdge
    SKIP_NEXT_IF_AC_ZERO
    jmp vFail
mhL, lac vCnt
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp .+2
    jmp mhE
    jsp wMargin
    SKIP_NEXT_IF_AC_ZERO
    jmp mhE
    lac wCur
    add vDir
    dac wCur
    lac vCnt
    sub [1]
    dac vCnt
    jmp mhL
mhE, lac wCur
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp mhB
    lac vOp
    SKIP_NEXT_IF_AC_ZERO
    jmp mhOk
    jsp wMargin
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp mhOk
mhB, lac wCur
    sub vDir
    dac wCur
mhOk, dzm vMoving
    jmp vMove

// 0 -- the line's start. ^ -- its first character not white.
vm0, dzm wCur
    dzm vMoving
    jmp vMove
vmCaret, jsp vFirst
    dac wCur
    dzm vMoving
    jmp vMove

// $ -- the line's end; a count, lines down; up and down keep to the end.
// Under an operator, past the line's last character, or the start of the
// count's line, which vops.ac's vXdw takes back to the line before.
vmDollar, lac vOp
    SKIP_NEXT_IF_AC_ZERO
    jmp mdOp
    law 1
    dac vMoving
    lac [0d20000]
    dac vMovCol
    lac vCnt
    sub [1]
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp mdLn
    lac wLen
    SKIP_NEXT_IF_AC_ZERO
    sub [1]
    dac wCur
    jmp vMove
mdLn, add DOT
    dac wDot
    law 1
    dac wSet
    lac [0777776]
    dac wCur
    jmp vMove
mdOp, dzm vMoving
    lac vCnt
    sub [1]
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp mdOl
    lac wLen
    dac wCur
    jmp vMove
mdOl, lac vCnt
    add DOT
    dac wDot
    law 1
    dac wSet
    dzm wCur
    jmp vMove

// | -- the column the count names, number's columns counted.
vmBar, lac vCnt
    dac wT
    lac i [oNumber:EX_BANK]
    SKIP_NEXT_IF_AC_ZERO
    law NUM_COLS
    add wT
    dac vMovCol
    dac i [scN:SCR_BANK]
    law 1
    dac vMoving
    lio DOT
    jsp i [scFindCol:SCR_BANK]
    dac wCur
    jmp vMove

// j, ^N -- down; k, ^P -- up: the column kept (vMoving, vMovCol).
vmJ, lac DOT
    add vCnt
    jmp mjk
vmK, lac DOT
    sub vCnt
mjk, dac wDot
    law 1
    dac wSet
    lac [0777776]
    dac wCur
    lac vMoving
    SKIP_NEXT_IF_AC_ZERO
    jmp vMove
    law 1
    dac vMoving
    lac vCurs
    dac i [scIdx:SCR_BANK]
    lio DOT
    jsp i [scColOf:SCR_BANK]
    dac vMovCol
    jmp vMove

// +, CR, LF -- down; - -- up: to the first character not white.
vmPlus, lac DOT
    add vCnt
    jmp mpm
vmMinus, lac DOT
    sub vCnt
mpm, dac wDot
mLine, law 1
    dac wSet
    lac [0777776]
    dac wCur
    dzm vMoving
    jmp vMove

// _ -- the count's lines from dot's, whole: an operator's own key again.
vmUs, lac DOT
    add vCnt
    sub [1]
    jmp mpm

// H, L, M -- the window's top, bottom, middle; G -- the count's line, or
// dol: each marked as '' 's when dot moves, unless under an operator.
vmBigH, jsp vLay
    lac i [scTop:SCR_BANK]
    add vCnt
    sub [1]
    jmp mMk
vmBigL, jsp vLay
    lac i [scTop:SCR_BANK]
    add i [scCnt:SCR_BANK]
    sub vCnt
    jmp mMk
vmBigM, jsp vLay
    lac i [scCnt:SCR_BANK]
    add [1]
    rar 1s
    and [0377777]
    add i [scTop:SCR_BANK]
    sub [1]
    jmp mMk
vmBigG, lac vHad
    SKIP_NEXT_IF_AC_ZERO
    jmp .+3
    lac DOL
    jmp mMk
    lac vCnt
mMk, dac wDot
    lac vOp
    SKIP_NEXT_IF_AC_ZERO
    jmp mLine
    lio wDot
    jsp vMarkIt
    jmp mLine

// w, W, b, B, e, E -- words: 3.7's lfind(2 or 3, ...), lowercase with wKind.
vmSmB, lac [0777776]
    dac vDir
vmSmW, law 1
    dac wKind
    jmp mWd
vmBigB, lac [0777776]
    dac vDir
vmBigW, dzm wKind
mWd, jsp wLimit
mwL, lac vCnt
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp .+2
    jmp mwE
    jsp vWord
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp mwE
    lac vCnt
    sub [1]
    dac vCnt
    jmp mwL
mwE, lac mwEnd
    SKIP_NEXT_IF_AC_ZERO
    jsp vEend
    dzm mwEnd
// dot's line: no line named; nowhere moved, the bell
    lac wDot
    SKIP_NEXT_IF_SAME DOT
    jmp mwLn
    lac wCur
    SKIP_NEXT_IF_DIFFERENT vCurs
    jmp vFail
    dzm vMoving
    jmp vMove
mwLn, law 1
    dac wSet
    dzm vMoving
    jmp vMove
vmSmE, law 1
    dac wKind
    jmp mE
vmBigE, dzm wKind
mE, law 1
    dac mwEnd
    lac vCnt
    sub [1]
    dac vCnt
    jmp mWd

// vWord -- 3.7's word(vmove, cnt). AC is 1, or 0 when the buffer ended;
// IO is clobbered.
vWord, dac vwX
    lac vDir
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp vwB
    lac wCur
    dac vwIc
    lac wDot
    dac vwId
    jsp wCh
    lia
    jsp wWordCh
    dac wWhich
vwF, jsp wWordOf
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp vwF2
    lac vOp                 // an operator's last word ending its line:
    SKIP_NEXT_IF_AC_NOT_ZERO // to the line's end, not the next line
    jmp vwF1
    lac vCnt
    SKIP_NEXT_IF_SAME [1]
    jmp vwF1
    lac wCur
    add [1]
    lia
    jsp wAt
    SKIP_NEXT_IF_AC_ZERO
    jmp vwF1
    idx wCur
    jmp vwF2
vwF1, jsp wNext
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp vwN
    lac wCur
    SKIP_NEXT_IF_AC_ZERO
    jmp vwF
// a change's last word keeps the blanks after it; on a blank, it is one
vwF2, lac vOp
    SKIP_NEXT_IF_SAME [0143]
    jmp vwF4
    lac vCnt
    SKIP_NEXT_IF_SAME [1]
    jmp vwF4
    lac wCur
    SKIP_NEXT_IF_SAME vwIc
    jmp vwF3
    lac wDot
    SKIP_NEXT_IF_SAME vwId
    jmp vwF3
    lio vwIc
    jsp wAt
    SKIP_NEXT_IF_AC_ZERO
    idx wCur
    jmp vwF3
vwF4, jsp wMargin           // past the blanks
    SKIP_NEXT_IF_AC_ZERO
    jmp vwF3
    jsp wBlank
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp vwF3
    idx wCur
    jmp vwF4
vwF3, lac vOp               // a move does not end past the line
    SKIP_NEXT_IF_AC_ZERO
    jmp vwY
    jsp wMargin
    SKIP_NEXT_IF_AC_ZERO
    jsp vwBk
    jmp vwY
vwB, jsp wNext
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp vwN
vwB1, jsp wBlank
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp vwB2
    jsp wNext
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp vwN
    jmp vwB1
vwB2, jsp wMargin
    SKIP_NEXT_IF_AC_ZERO
    jmp vwB4
    jsp wCh
    lia
    jsp wWordCh
    dac wWhich
vwB3, jsp wMargin
    SKIP_NEXT_IF_AC_ZERO
    jmp vwB4
    jsp wWordOf
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp vwB4
    lac wCur
    sub [1]
    dac wCur
    jmp vwB3
vwB4, lac wCur
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp vwB5
    jsp wWordOf
    SKIP_NEXT_IF_AC_ZERO
    jmp vwY
vwB5, idx wCur
vwY, law 1
    jmp i vwX
vwN, cla
    jmp i vwX
vwBk, dac vbkX              // wCur back one
    lac wCur
    sub [1]
    dac wCur
    jmp i vbkX

// vEend -- 3.7's eend(vmove). AC and IO are clobbered.
vEend, dac veeX
    jsp wNext
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i veeX
veB, jsp wBlank
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp veW
    jsp wNext
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i veeX
    jmp veB
veW, jsp wCh
    lia
    jsp wWordCh
    dac wWhich
veL, jsp wWordOf
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp veE
    lac wCur
    add [1]
    lia
    jsp wAt
    SKIP_NEXT_IF_AC_ZERO
    jmp veN
    idx wCur
    jmp veE
veN, jsp wNext
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i veeX
    jmp veL
veE, lac vOp                // c and d take the word's last character
    SKIP_NEXT_IF_DIFFERENT [0143]
    jmp i veeX
    SKIP_NEXT_IF_DIFFERENT [0144]
    jmp i veeX
    lac wCur
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    sub [1]
    dac wCur
    jmp i veeX

// f, F, t, T -- the count'th such character in the line; ; and , repeat
// the last, , the other way.
vmSmF, law 1
    jmp mfSet
vmBigF, law 2
    jmp mfSet
vmSmT, law 3
    jmp mfSet
vmBigT, law 4
mfSet, dac mfK
    jsp vKey
    dio mfC
    lac mfC
    SKIP_NEXT_IF_DIFFERENT [CH_ESC]
    jmp viLoop
