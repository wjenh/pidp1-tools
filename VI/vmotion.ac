    lac srC
    SKIP_NEXT_IF_SAME [CH_QMARK]
    jmp srFnd
    lac [LINEBUF+LB_SIZE]   // back: the line's last match
    dac srIn
    jmp srQ
srMiss, lac srA
    SKIP_NEXT_IF_SAME DOT
    jmp srNope
    lac [mFail:RE_BANK]
    jmp i [exErr:EX_BANK]
srBot, lac [mNoBot:RE_BANK]
    jmp i [exErr:EX_BANK]
srTop, lac [mNoTop:RE_BANK]
    jmp i [exErr:EX_BANK]
// found at srA, reLoc1: the rest after the expression
srFnd, dzm srZ
    lac srT
    SKIP_NEXT_IF_DIFFERENT [CH_LF]
    jmp srDo
    lio srA                 // + - and numbers: another line (vaddr.ac)
    jsp i [srOffs:FILE_BANK]
    jsp i [getChar:EX_BANK]
    dac srT
    SKIP_NEXT_IF_SAME [0172]
    jmp srF1
    law CH_LF
    dac srZ
    jsp i [getChar:EX_BANK]
    dac srT
srF1, jsp srCtx
srF2, lac srT               // a window size, passed over
    sub [CH_0]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp srF3
    sub [0d10]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp srF3
    jsp i [getChar:EX_BANK]
    dac srT
    jmp srF2
srF3, jsp srCtx
    lac srT
    SKIP_NEXT_IF_DIFFERENT [CH_LF]
    jmp srDo
    jsp i [scExDone:SCR_BANK]
    lac vSvDot
    dac DOT
    jsp i [ringBell:TERM_BANK]
    jmp viLoop
// moved: the previous context marked; z's placing, or as j and k do
srDo, jsp i [scExDone:SCR_BANK]
    dzm vSrch
    lac i [reLoc1:RE_BANK]
    sub [LINEBUF]
    dac wCur
    lac LBLEN
    dac wLen
    lac i [srOLn:FILE_BANK]
    SKIP_NEXT_IF_AC_ZERO
    jmp srOl
    lac vOp                 // an operator's range ends at the match; .
    SKIP_NEXT_IF_AC_NOT_ZERO // repeats it as n
    jmp srD0
srOp, lac srA
    dac wDot
    law 1
    dac wSet
    lac vWcP
    sub [1]
    dac srP
    law 0156
    dac i srP
    jmp vOpGo
srOl, dac srA               // offsets: whole lines, to the line they gave
    lac [0777776]
    dac wCur
    lac vOp
    SKIP_NEXT_IF_AC_ZERO
    jmp srOp
    lio srZ
    jmp i [srLine:FILE_BANK]
srD0, lac srA               // another line or column: marked, before
    SKIP_NEXT_IF_SAME DOT   // the step back, as 3.7
    jmp srD2
    lac wCur
    SKIP_NEXT_IF_DIFFERENT vCurs
    jmp srD1
srD2, jsp vMarkDot
srD1, lac wCur
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp .+2
    jmp srD3
    lio wCur
    jsp wAt
    SKIP_NEXT_IF_AC_NOT_ZERO
    jsp vwBk                // at the end: back one
srD3, lac srZ
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp srD4
    SKIP_NEXT_IF_DIFFERENT [CH_LF]
    cla
    dac i [scCtx:SCR_BANK]
    lio srA
    jsp i [scContext:SCR_BANK]
    lac wCur
    dac vCurs
    dzm vMoving
    jmp viLoop
srD4, law 1
    dac vMoving
    lac wCur
    dac i [scIdx:SCR_BANK]
    lio srA
    jsp i [scColOf:SCR_BANK]
    dac vMovCol
    lac srA
    dac wDot
    law 1
    dac wSet
    lac [0777776]
    dac wCur
    jmp vMove

// srAdv -- 3.7's execute(1): an empty match passed over, the search on in
// the line. AC is 1 at a match, else 0; IO is clobbered.
srAdv, dac sdvX
    lac i [reLoc1:RE_BANK]
    SKIP_NEXT_IF_SAME i [reLoc2:RE_BANK]
    jmp .+3
    add [1]
    dac i [reLoc2:RE_BANK]
    law 1
    dac i [reGf:RE_BANK]
    jsp i [reExec:RE_BANK]
    jmp i sdvX

// srCtx -- one of ^ + - . taken as z's character from srT, the next read.
// AC and IO are clobbered.
srCtx, dac scxX
    lac srT
    SKIP_NEXT_IF_DIFFERENT [CH_CARET]
    jmp scx1
    SKIP_NEXT_IF_DIFFERENT [CH_PLUS]
    jmp scx1
    SKIP_NEXT_IF_DIFFERENT [CH_MINUS]
    jmp scx1
    SKIP_NEXT_IF_DIFFERENT [CH_DOT]
    jmp scx1
    jmp i scxX
scx1, dac srZ
    jsp i [getChar:EX_BANK]
    dac srT
    jmp i scxX

// x, X, D -- 3.7's deleteit: the count's characters at the cursor, before
// it, or to the line's end deleted, as d does them (vops.ac's vOpGo); at
// the line's end, or X at its start, the bell. Reached by jmp from
// vmain.ac's table.
vcBigD, lac [COUNT_CAP]
    dac vCnt
vcX, law 1
    jmp vxGo
vcBigX, lac [0777776]
vxGo, dac vDir
    lac DOT
    dac wDot
    dzm wSet
    lac vCurs
    dac wCur
    dac vOpCur
    jsp wLoad
    jsp wMargin
    SKIP_NEXT_IF_AC_ZERO
    jmp vFail
vxL, lac vCnt
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp .+2
    jmp vxE
    jsp wMargin
    SKIP_NEXT_IF_AC_ZERO
    jmp vxE
    lac wCur
    add vDir
    dac wCur
    lac vCnt
    sub [1]
    dac vCnt
    jmp vxL
vxE, dzm vMoving
    law 0144
    dac vOp
    jmp vOpGo

