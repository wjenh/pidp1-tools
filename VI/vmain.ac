vSvCur, 0
vSvChg, 0                   // the buffer's changed count as the command found it
vSrch, 0                    // 1 while a search runs: an error restores them
vLen, 0                     // vRead's line's length
vrC, 0                      // vRead's prompt
vLastFK, 0                  // the last f, F, t or T, 0 for none
vLastFC, 0                  //   and its character
vScan, 0                    // the last search's direction, / or ?
