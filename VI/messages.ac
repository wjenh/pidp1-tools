// messages.ac -- ex's messages in 3.7's text (ex_cmds.c, ex_cmds2.c,
// ex_cmdsub.c, ex_addr.c, ex_set.c, ex_subr.c, ex_get.c), and msgPut, which
// types one as 3.7's mesg and printf do (ex_subr.c):
//   'xxx@yyy' is 'xxx' when terse is set, else 'xxx yyy';
//   'xxx|yyy' is 'xxx' when terse is set, else 'yyy';
//   %s is the string at msgS, a character a word; %d the number msgN;
//   %c the character msgC.
// Each message is am1's ascii, two characters a word ending in a 0
// character; a caller names it by its full address ([mFoo:MSG_BANK]).
// In bank MSG_BANK. Needs vi.ah, <AIDS/skipmacros.ah>, termio.ac (bank
// TERM_BANK) and options.ac's oTerse (bank EX_BANK).

local mpX, mpP, mpH, mpC, mpS, mpTerse, mpScan, mpRew, mpLoop0, mpLoop, \
    mpOut, mpAt, mpPct, mpStr, mpSLoop, mpD, mpChr, mpGet, mgX, mgW, mpLow

// msgPut -- type the message at the full address in IO. No new line.
// AC and IO are clobbered.
msgPut, dac mpX
    dio mpP
    dio mpS
    lac i [oTerse:EX_BANK]
    dac mpTerse
    SKIP_NEXT_IF_AC_ZERO
    jmp mpLoop0
// verbose: the form of 'xxx|yyy' is what follows the bar
    dzm mpH
mpScan, jsp mpGet
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp mpRew               // no bar: the whole of it
    SKIP_NEXT_IF_DIFFERENT [CH_VBAR]
    jmp mpLoop
    jmp mpScan
mpRew, lac mpS
    dac mpP
mpLoop0, dzm mpH
mpLoop, jsp mpGet
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i mpX
    SKIP_NEXT_IF_DIFFERENT [CH_VBAR]
    jmp i mpX               // terse: what precedes the bar
    SKIP_NEXT_IF_DIFFERENT ['@']
    jmp mpAt
    SKIP_NEXT_IF_DIFFERENT [CH_PCT]
    jmp mpPct
mpOut, lia
    jsp i [putc:TERM_BANK]
    jmp mpLoop
mpAt, lac mpTerse
    SKIP_NEXT_IF_AC_ZERO
    jmp i mpX
    law CH_SP
    jmp mpOut
mpPct, jsp mpGet
    SKIP_NEXT_IF_DIFFERENT ['s']
    jmp mpStr
    SKIP_NEXT_IF_DIFFERENT ['d']
    jmp mpD
    SKIP_NEXT_IF_DIFFERENT ['c']
    jmp mpChr
    jmp mpOut               // %% and the like: the character itself
mpStr, lac msgS
    dac mpC
mpSLoop, lac i mpC
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp mpLoop
    lia
    jsp i [putc:TERM_BANK]
    idx mpC
    jmp mpSLoop
mpD, lio msgN
    jsp i [putDec:TERM_BANK]
    jmp mpLoop
mpChr, lio msgC
    jsp i [putc:TERM_BANK]
    jmp mpLoop

// mpGet -- the next character of the message at mpP, mpH saying which half.
// AC is the character, 0 at the end; IO is preserved.
mpGet, dac mgX
    lac mpH
    SKIP_NEXT_IF_AC_ZERO
    jmp mpLow
    law 1
    dac mpH
    lac i mpP
    rar 9s
    and [0177]
    jmp i mgX
mpLow, dzm mpH
    lac i mpP
    and [0177]
    dac mgW
    idx mpP
    lac mgW
    jmp i mgX
mgX, 0
mgW, 0
mpX, 0
mpP, 0
mpH, 0
mpC, 0
mpS, 0
mpTerse, 0
endloc

msgS, 0                     // %s: a string's full address, a character a word
msgN, 0                     // %d
msgC, 0                     // %c

