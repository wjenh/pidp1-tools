// subst.ac -- ex's s, & and ~ (3.7's substitute, compsub, comprhs,
// dosubcon, confirmed, dosub, fixcase, place, snote), g and v (global), and
// :ta (tagfind), with the stack of command lists that g and :ta run.
//
// A command list is run as 3.7 runs globp in commands(1,1): it is put in
// CMDBUF ending in CH_EOF, a continuation is pushed (rnPush), and ex's loop
// starts; when the dispatch reads CH_EOF (rnEof), dot is the address given
// before it, if any, and the continuation is popped and jumped to. g puts its
// list there once for each marked line; :ta puts e! and the tag's address.
// An error empties the stack (excmd.ac's exErr).
//
// g's lines are marked with LT_GMARK in the line table. A command g runs may
// move lines; lines.ac keeps ltLow, the lowest table word moved since g last
// looked, so the search for the next marked line starts there instead of at
// line 1, as 3.7's does. The buffer as g found it is kept as a list (gList,
// a root of the heap), and becomes undo's whole at g's end (glFix), since the
// commands g runs overwrite undo's list.
//
// Handlers are reached by jmp from ex's dispatch (cmdTab, excmd.ac) and end
// by jmp i [exNext:EX_BANK] or [exLoop:EX_BANK]; an error is jmp i
// [exErr:EX_BANK] with its message's full address in AC. Routines are
// entered by jsp with the extend window open and return by jmp i. In bank
// RE_BANK, after regex.ac. Needs vi.ah, <AIDS/skipmacros.ah>, regex.ac,
// excmd.ac, exaddr.ac, exops.ac and options.ac (bank EX_BANK), lines.ac
// (bank 0), termio.ac (bank TERM_BANK), messages.ac (bank MSG_BANK),
// files.ac (bank FILE_BANK).

#define RN_MAX       4                    // command lists within lists
#define TAGS_STR     OPT_STR+2*OPT_SLEN   // the tags option, a character a word
#define MARK_T       023                  // mark t, 't'-'a'

local sbCh, sbGo, sbNm, sbA, sbN, sbTot, sbLns, sbCnt, sbHop, sbUse, \
    sbL, sbGl, sbPt, sbNx, sb1, sbDone, sbNote, sbMemU, sbLoopE, sbFailE, \
    sbComp, cpX, cpE, cpS, cpS2, cpTil, cpChk, cpRedo, cpFl, cpG, cpC, cpR, \
    cpRes, cpNoRe, cpNoPrv, cpNoSub, \
    sbRhs, rhX, rhE, rhC, rhP, rhG, rhCp, rh0, rhL, rhBsl, rhNl, rhUn, rhMg, \
    rhMagic, rhQ, rhSt, rhOld, rhOL, rhBig, rhEnd, \
    sbCon, snX, snN, snDo, snOne, \
    sbDo, sdX, sdL, sdS, sdR, sdC, sdT, sdA, sdB, sdP, sdCase, sdUc, sdPre, \
    sdR0, sdRL, sdAmp, sdl, sdLL, sdu, sdUU, sdE, sdTr, sdPlain, sdPut, \
    sdTail, sdTL, sdCp, sdCL, sdEnd, sdOvf, \
    sdPlace, spX, spL, sdFix, sfX, sfC, sfUp, sfRet, \
    sbPut, puX, puS, puD, puN, puM, puC, puC2, puL, puE, puMem, puFull, \
    spCut, ctX, ctD, ctN, ctC, ctL, ctNl, ctZ, ctEnd, \
    sbConf, cfX, cfA, cfB, cfNo, sbUgo, ugX, ugC, ugN, ugL, ug1, \
    sbCol, clX, clE, clN, clP, clC, clL, cl2, clTab, clRet, \
    sbSnote, ssX, ss1, ss2, \
    glK, glNm, glGo, glP, glQ, glC, glT, glI, glN, glLen, glLines, glADot, \
    glRd, glSt, glBs, glBB, glBE, glBrk, glMk, glMN, glRun, glF, glFN, glCp, \
    glEnd, glNest, glNoRe, glMem, glNx, glPut, gpX, glLong, gfX, gfNone, \
    glRst, gsL, gsE, geL, geE, \
    rpX, rpC, rpT, rnE1, rnDeep, \
    tgQ, tgOMg, tgEl, tgP, tgN, tgC, tgW, tgS, tgDif, tgPth, tgCnt, tgOk, \
    tgRd, tgRE, tgOld, tgEnd, tgNxF, tgSkB, tgAdv, tgAd2, tgLn, tgHit, \
    tgH1, tgH2, tgH3, tgH4, tgH5, tgH6, tgSv, tgSv2, tgSv3, tgSv4, tgT1, \
    tgT2, tgT3, tgBld, tgB3, tgB4, tgB5, tgB6, tgB7, tgB8, tgB9, tgPush, \
    tgNone, tgBad, tgNoPrv, tgEnt, tgNoWr, tgNoF, \
    tgCmp, tcX, tcL, tcC, tcLp, tcE, tcNt1, tcNo, tcYes, \
    tgPut, tpX, tgLong

// cSubst, cAmp, cTilde -- s, & and ~: 3.7's substitute(c). The expression
// and replacement taken (sbComp), the lines saved for undo unless g is
// running, then each line's matches replaced, every one with g, those
// confirmed with c; a line holding LFs is split there.
cSubst, law 's'
    jmp sbGo
cAmp, law CH_AMP
    jmp sbNm
cTilde, law CH_TILDE
sbNm, dac sbCh              // & and ~ are named substitute
    lac [nmSubst:RE_BANK]
    dac i [pkStr:EX_BANK]
    jsp i [pkUnp:EX_BANK]
    lac sbCh
sbGo, dac sbCh
    jsp sbComp
    lac i [inGlobal:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp sb1
    lac i [addr1:EX_BANK]
    dac LNA
    lac i [addr2:EX_BANK]
    dac LNB
    jsp i [lnSave:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp sbMemU
    law UND_CHANGE
    dac i [undKind:0]
sb1, dzm sbTot
    dzm sbLns
    lac i [addr1:EX_BANK]
    dac sbA
sbL, lac sbA
    sub i [addr2:EX_BANK]
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp sbDone
    jsp i [brkChk:TERM_BANK]
    dzm sbCnt
    dzm sbHop
    dzm reGf
    lio sbA
    jsp sbCon
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sbNx
    lac sbGs
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sbPt
// g: on from the last match while the line goes on, as 3.7 does, a loop
// held at a line buffer's worth of matches
sbGl, lac i reLoc2
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sbPt
    idx sbHop
    sub [LB_SIZE+1]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp sbLoopE
    law 1
    dac reGf
    lio sbA
    jsp sbCon
    SKIP_NEXT_IF_AC_ZERO
    jmp sbGl
sbPt, lac sbCnt
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sbNx
    add sbTot
    dac sbTot
    idx sbLns
    jsp sbPut
    dac sbN
    add sbA
    dac sbA
    lac i [addr2:EX_BANK]
    add sbN
    dac i [addr2:EX_BANK]
sbNx, idx sbA
    jmp sbL
sbDone, lac sbTot
    SKIP_NEXT_IF_AC_ZERO
    jmp sbNote
    lac i [inGlobal:0]
    ior sbCf
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sbFailE
sbNote, jsp sbSnote
    lac sbTot
    SKIP_NEXT_IF_AC_NOT_ZERO
    dzm i [pflag:EX_BANK]
    jmp i [exNext:EX_BANK]
sbMemU, lac [mOutUndo:MSG_BANK]
    jmp i [exErr:EX_BANK]
sbLoopE, lac [mSubLoop:RE_BANK]
    jmp i [exErr:EX_BANK]
sbFailE, lac [mSubFail:RE_BANK]
    jmp i [exErr:EX_BANK]

// sbComp -- 3.7's compsub(sbCh): for s, the expression and the replacement,
// unless what follows is the command's end or a flag, which is &; then the
// flags g, c and r, the count and the trailing flags. The expression used
// is saved as the substitute's, or the substitute's made the last.
// AC and IO are clobbered.
sbComp, dac cpX
    lac i [oEdComp:EX_BANK]
    SKIP_NEXT_IF_AC_ZERO
    jmp cpS
    dzm sbGs
    dzm sbCf
cpS, dzm sbUse
    lac sbCh
    SKIP_NEXT_IF_DIFFERENT ['s']
    jmp cpS2
    SKIP_NEXT_IF_DIFFERENT [CH_TILDE]
    jmp cpTil
    jmp cpChk
cpS2, jsp i [pastWh:EX_BANK]
    jsp i [getChar:EX_BANK]
    dac cpE
    lia
    jsp i [endCmd:EX_BANK]
    SKIP_NEXT_IF_AC_ZERO
    jmp cpRedo
    lac cpE
    SKIP_NEXT_IF_DIFFERENT ['g']
    jmp cpRedo
    SKIP_NEXT_IF_DIFFERENT ['c']
    jmp cpRedo
    SKIP_NEXT_IF_DIFFERENT ['r']
    jmp cpRedo
    lio cpE
    jsp i [isAlnum:EX_BANK]
    SKIP_NEXT_IF_AC_ZERO
    jmp cpNoRe
    law 1
    dac reOkNl
    lio cpE
    jsp reCompile
    dac cpE
    law 1
    dac sbUse
    lio cpE
    jsp sbRhs
    dzm sbGs
    dzm sbCf
    jmp cpFl
cpTil, law 1
    dac sbUse
    jmp cpChk
cpRedo, jsp i [unGetChar:EX_BANK]
cpChk, lac i [RE_LAST+2]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp cpNoPrv
    lac i [RE_SUB+2]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp cpNoSub
cpFl, jsp i [getChar:EX_BANK]
    SKIP_NEXT_IF_DIFFERENT ['g']
    jmp cpG
    SKIP_NEXT_IF_DIFFERENT ['c']
    jmp cpC
    SKIP_NEXT_IF_DIFFERENT ['r']
    jmp cpR
    jsp i [unGetChar:EX_BANK]
    jsp i [setCount:EX_BANK]
    jsp i [newLine:EX_BANK]
    lio [RE_SUB]
    lac sbUse
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp cpRes
    jsp reSave
    jmp i cpX
cpRes, jsp reRes
    jmp i cpX
cpG, lac sbGs
    xor [1]
    dac sbGs
    jmp cpFl
cpC, lac sbCf
    xor [1]
    dac sbCf
    jmp cpFl
cpR, law 1
    dac sbUse
    jmp cpFl
cpNoRe, lac [mSubNoRe:RE_BANK]
    jmp i [exErr:EX_BANK]
cpNoPrv, lac [mNoPrevRe:RE_BANK]
    jmp i [exErr:EX_BANK]
cpNoSub, lac [mNoSubRep:RE_BANK]
    jmp i [exErr:EX_BANK]

// sbRhs -- 3.7's comprhs(seof), the delimiter in IO: the replacement up to
// it into reRhs, a character a word, RE_QUOTE on each character a \ made
// special (& with magic unless \&). ~ (\~ with nomagic) is the last
// replacement, kept in GENBUF meanwhile. An LF ends it, unless more of a
// command list follows (3.7's globp[0]); a \ before an LF keeps the LF, which
// splits the line. AC and IO are clobbered.
sbRhs, dac rhX
    dio rhE
    lac [reRhs:RE_BANK]
    dac rhP
    lac [GENBUF]
    dac rhG
rhCp, lac i rhP
    dac i rhG
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rh0
    idx rhP
    idx rhG
    jmp rhCp
rh0, lac [reRhs:RE_BANK]
    dac rhP
rhL, jsp i [getChar:EX_BANK]
    dac rhC
    SKIP_NEXT_IF_DIFFERENT rhE
    jmp rhEnd
    SKIP_NEXT_IF_DIFFERENT [CH_BSL]
    jmp rhBsl
    SKIP_NEXT_IF_DIFFERENT [CH_LF]
    jmp rhNl
    SKIP_NEXT_IF_DIFFERENT [CH_EOF]
    jmp rhUn
    SKIP_NEXT_IF_DIFFERENT [CH_TILDE]
    jmp rhMg
    SKIP_NEXT_IF_DIFFERENT [CH_AMP]
    jmp rhMg
    jmp rhSt
rhBsl, jsp i [getChar:EX_BANK]
    dac rhC
    SKIP_NEXT_IF_DIFFERENT [CH_EOF]
    jmp rhUn
    lac i [oMagic:EX_BANK]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rhMagic
    lac rhC
    SKIP_NEXT_IF_DIFFERENT [CH_AMP]
    jmp rhSt
    jmp rhQ
rhNl, lac rnDepth
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rhUn
    jsp i [peekChar:EX_BANK]
    SKIP_NEXT_IF_DIFFERENT [CH_EOF]
    jmp rhUn
    jmp rhMg
rhUn, jsp i [unGetChar:EX_BANK]
    jmp rhEnd
rhMg, lac i [oMagic:EX_BANK]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rhSt
rhMagic, lac rhC
    SKIP_NEXT_IF_DIFFERENT [CH_TILDE]
    jmp rhOld
rhQ, lac rhC
    ior [RE_QUOTE]
    dac rhC
rhSt, lac rhP
    sub [reRhs:RE_BANK]
    sub [RHS_SIZE-1]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp rhBig
    lac rhC
    dac i rhP
    idx rhP
    jmp rhL
rhOld, lac [GENBUF]
    dac rhG
rhOL, lac i rhG
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rhL
    lac rhP
    sub [reRhs:RE_BANK]
    sub [RHS_SIZE-1]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp rhBig
    lac i rhG
    dac i rhP
    idx rhP
    idx rhG
    jmp rhOL
rhBig, dzm i rhP
    lac [mRhsLong:RE_BANK]
    jmp i [exErr:EX_BANK]
rhEnd, dzm i rhP
    jmp i rhX

// sbCon -- 3.7's dosubcon(reGf, line IO): a match, and when it is
// confirmed (c), its replacement, counted in sbCnt.
// AC is 1 at a match, else 0; IO is clobbered.
sbCon, dac snX
    dio snN
    jsp reExec
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i snX
    lac sbCf
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp snDo
    lio snN
    jsp sbConf
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp snOne
snDo, jsp sbDo
    idx sbCnt
snOne, law 1
    jmp i snX

// sbDo -- 3.7's dosub: the line in LINEBUF with reLoc1 to reLoc2 replaced
// by reRhs, built in GENBUF and copied back; reLoc2 after the replacement,
// lbLen its length. AC and IO are clobbered.
sbDo, dac sdX
    lac [LINEBUF]
    dac sdL
    lac [GENBUF]
    dac sdS
sdPre, lac sdL
    sub reLoc1
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp sdR0
    lac i sdL
    dac i sdS
    idx sdL
    idx sdS
    jmp sdPre
sdR0, dzm sdCase
    lac [reRhs:RE_BANK]
    dac sdR
sdRL, lac i sdR
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sdTail
    SKIP_NEXT_IF_DIFFERENT [CH_CR]   // vi's ^V CR splits, as LF
    law CH_LF
    dac sdC
    idx sdR
    lac sdC
    and [RE_QUOTE]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sdPlain
    lac sdC
    and [RE_TRIM]
    dac sdT
    SKIP_NEXT_IF_DIFFERENT [CH_AMP]
    jmp sdAmp
    SKIP_NEXT_IF_DIFFERENT ['l']
    jmp sdl
    SKIP_NEXT_IF_DIFFERENT ['L']
    jmp sdLL
    SKIP_NEXT_IF_DIFFERENT ['u']
    jmp sdu
    SKIP_NEXT_IF_DIFFERENT ['U']
    jmp sdUU
    SKIP_NEXT_IF_DIFFERENT ['E']
    jmp sdE
    SKIP_NEXT_IF_DIFFERENT ['e']
    jmp sdE
// \1 to \9, as far as the expression has \( ... \)
    sub ['1']
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp sdTr
    sub i [RE_LAST+1]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp sdTr
    lac sdT
    sub ['1']
    dac sdT
    add [reBras:RE_BANK]
    dac sdP
    lac i sdP
    dac sdA
    lac sdT
    add [reKets:RE_BANK]
    dac sdP
    lac i sdP
    dac sdB
    jsp sdPlace
    jmp sdRL
sdAmp, lac reLoc1
    dac sdA
    lac reLoc2
    dac sdB
    jsp sdPlace
    jmp sdRL
sdl, law 1
    dac sdCase
    dzm sdUc
    jmp sdRL
sdLL, law LB_SIZE
    dac sdCase
    dzm sdUc
    jmp sdRL
sdu, law 1
    dac sdCase
    dac sdUc
    jmp sdRL
sdUU, law LB_SIZE
    dac sdCase
    law 1
    dac sdUc
    jmp sdRL
sdE, dzm sdCase
    jmp sdRL
sdTr, lac sdT
    jmp sdPut
sdPlain, lac sdC
sdPut, and [RE_TRIM]
    lia
    jsp sdFix
    dac i sdS
    idx sdS
    sub [GENBUF+LB_SIZE]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp sdOvf
    jmp sdRL
// the rest of the line after the match, then all of it back to LINEBUF
sdTail, lac reLoc2
    dac sdL
    lac sdS
    sub [GENBUF]
    add [LINEBUF]
    dac reLoc2
sdTL, lac i sdL
    dac i sdS
    dac sdT
    idx sdL
    idx sdS
    lac sdT
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sdCp
    lac sdS
    sub [GENBUF+LB_SIZE]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp sdOvf
    jmp sdTL
sdCp, lac [GENBUF]
    dac sdS
    lac [LINEBUF]
    dac sdL
sdCL, lac i sdS
    dac i sdL
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sdEnd
    idx sdS
    idx sdL
    jmp sdCL
sdEnd, lac sdL
    sub [LINEBUF]
    dac LBLEN
    jmp i sdX
sdOvf, lac [mSubOvf:RE_BANK]
    jmp i [exErr:EX_BANK]

// sdPlace -- 3.7's place: the characters from sdA up to sdB to sdS, each
// case-fixed. AC and IO are clobbered.
sdPlace, dac spX
spL, lac sdA
    sub sdB
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i spX
    lio i sdA
    idx sdA
    jsp sdFix
    dac i sdS
    idx sdS
    sub [GENBUF+LB_SIZE]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp sdOvf
    jmp spL

// sdFix -- 3.7's fixcase: the character in IO in the case \u \l \U \L ask
// for, while sdCase counts down. AC is the character; IO is clobbered.
sdFix, dac sfX
    dio sfC
    lac sdCase
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sfRet
    sub [1]
    dac sdCase
    lac sdUc
    SKIP_NEXT_IF_AC_ZERO
    jmp sfUp
    lac sfC
    sub [CH_A]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp sfRet
    sub [0d26]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp sfRet
    lac sfC
    ior [040]
    jmp i sfX
sfUp, lac sfC
    sub [CH_LA]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp sfRet
    sub [0d26]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp sfRet
    lac sfC
    xor [040]
    jmp i sfX
sfRet, lac sfC
    jmp i sfX

// sbPut -- 3.7's putmark and append(getsub): LINEBUF, line sbA as
// substituted, in its place up to its first LF; each piece after an LF a new
// line after it, dot the last. AC is how many lines were added; IO is
// clobbered.
sbPut, dac puX
    lac [LINEBUF]
    dac puS
    lac [GENBUF]
    dac puD
puC, lac i puS
    dac i puD
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp puC2
    idx puS
    idx puD
    jmp puC
puC2, lac [GENBUF]
    dac puS
    dzm puN
    jsp spCut
    dac puM
    jsp i [putLine:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp puMem
    dac i [lnR:0]
    lio sbA
    jsp i [lnPutMark:0]
    lac sbA
    dac LNA
    lio [1]
    jsp i [lnAppStart:0]
puL, lac puM
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp puE
    jsp spCut
    dac puM
    jsp i [putLine:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp puMem
    lia
    jsp i [lnInsert:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp puFull
    idx puN
    jmp puL
puE, lac puN
    jmp i puX
puMem, lac [mOutMem:MSG_BANK]
    jmp i [exErr:EX_BANK]
puFull, lac [mTooMany:MSG_BANK]
    jmp i [exErr:EX_BANK]

// spCut -- the text at puS up to an LF or its end into LINEBUF, lbLen its
// length; puS past the LF. AC is 1 when an LF ended it, else 0; IO is
// clobbered.
spCut, dac ctX
    lac [LINEBUF]
    dac ctD
    dzm ctN
ctL, lac i puS
    dac ctC
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ctZ
    idx puS
    lac ctC
    SKIP_NEXT_IF_DIFFERENT [CH_LF]
    jmp ctNl
    dac i ctD
    idx ctD
    idx ctN
    jmp ctL
ctNl, law 1
    jmp ctEnd
ctZ, cla
ctEnd, dac ctC
    dzm i ctD
    lac ctN
    dac LBLEN
    lac ctC
    jmp i ctX

// sbConf -- 3.7's confirmed: line IO typed as LINEBUF holds it, the match
// marked with ^ under it at 3.7's columns, then a line read; yes when it
// starts with y. AC is 1 or 0; IO is clobbered.
sbConf, dac cfX
    jsp i [pLine:EX_BANK]
    lio reLoc1
    jsp sbCol
    dac cfA
    lio reLoc2
    jsp sbCol
    sub cfA
    dac cfB                 // the carets
    lac i [listf:EX_BANK]   // 3.7's column() counts list's $ too
    SKIP_NEXT_IF_AC_ZERO
    law 1
    add cfA
    dac ugN                 // the blanks
    lio [CH_SP]
    jsp sbUgo
    lac cfB
    dac ugN
    lio [CH_CARET]
    jsp sbUgo
    lac [GENBUF]
    dac i [tlBuf:TERM_BANK]
    law 0d80
    dac i [tlMax:TERM_BANK]
    jsp i [tmLine:TERM_BANK]
    lac i [GENBUF]
    SKIP_NEXT_IF_SAME ['y']
    jmp cfNo
    law 1
    jmp i cfX
cfNo, cla
    jmp i cfX

// sbUgo -- 3.7's ugo: the character in IO typed ugN times. AC and IO are
// clobbered.
sbUgo, dac ugX
    dio ugC
ugL, lac ugN
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp ug1
    jmp i ugX
ug1, lio ugC
    jsp i [putc:TERM_BANK]
    lac ugN
    sub [1]
    dac ugN
    jmp ugL

// sbCol -- the column pLine reaches typing LINEBUF up to the full address in
// IO: the number's columns when numbered, a TAB to the next tabstop (^I in
// list's form), a control character or DEL two. AC is the column; IO is
// clobbered.
sbCol, dac clX
    dio clE
    lac i [numbf:EX_BANK]
    SKIP_NEXT_IF_AC_ZERO
    law NUM_COLS
