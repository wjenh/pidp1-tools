// c11Rb -- ]q, pop the list's last entry into q's number and text; the
// arguments pass through.
// An empty list is PES.
// :]q does it if it can, -1 if it did, 0 if not.
// Reads colon11.
// For :]q, the -1 or 0 is passed on as an operand (opnd).
// Does not preserve AC or IO.
// Entered by jmp from the dispatch, ends by jmp rsLoop.
c11Rb, lac i [colon11:0]
    dac cgCol
    dzm i [colon11:0]
    jsp q11Name
    lac lqSP
    SKIP_NEXT_IF_AC_ZERO
    jmp crT
    lac cgCol
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp crPes
    cli
    jmp cqOut
crT, sub [1]
    dac lqSP
    add [NQREG+LQ_NSET*NQREG]
    lia
    jsp qRecOf
    dac cbR
    jsp i [qFree:0]         // q's text, qRec being q's
    // the kind and number words; the text's block changes owner
    lac cbR
    dac cbS
    lac qR
    dac ntP
    law i 4
    dac cgK
crNum, lac i cbS
    dac i ntP
    idx cbS
    idx ntP
    isp cgK
    jmp crNum
    lac i cbR
    SKIP_NEXT_IF_SAME [QK_TEXT]
    jmp crV
    lac cbR
    add [QR_BLK]
    dac cbS
    lac i cbS
    dac cbS                 // the block
    lac i cbS
    and [QR_HOLDS]
    ior i [qIdx:0]
    dac i cbS
    lac qR
    add [QR_BLK]
    dac ntP
    lac cbS
    dac i ntP
crV, dzm i cbR
    lac cgCol
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i [rsLoop:0]
    lio [-1]
    jmp cqOut
crPes, ERR11(EC_PES)

