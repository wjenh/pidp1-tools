// fiEG -- :EGcmd args$, TECO-11's hook for the system.
// :EGDIR dev:$ types the unit's directory as EL does, and :EGDEL spec$ deletes the file
// at once (ED, then the writing EC does), each -1.
// Any other function is 0.
// EG without the colon, which leaves for the system, is IEC.
// Reads the argument state and the text argument.
// The value goes to opnd.
// Does not preserve AC or IO.
// Entered by jmp from c11E, ends by jmp rsLoop.
fiEG, lac i [colon11:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp egGo
    law 0107
    dac i [eArg:0]
    ERR11(EC_IEC)
egGo, dac fxCol
    jsp i [txSv:P11_BANK]
    cli
    jsp i [argOr:0]
    lio [CH_ESC]
    jsp i [txArg:P11_BANK]
    dac fsN
    lac i [srcPos:0]
    sub fsN
    sub [1]
    dac fsP
    // the function, three letters, then a blank before its argument
    lac fsN
    sub [3]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp fiZrC
    dac fsN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp egFn
    sub [1]
    dac fsN
    lac fsP
    add [3]
    lia
    jsp fiUp
    SKIP_NEXT_IF_SAME [040]
    jmp fiZrC
egFn, lio fsP
    jsp fiUp
    SKIP_NEXT_IF_SAME [0104]
    jmp fiZrC
    lac fsP
    add [1]
    lia
    jsp fiUp
    dac eg2
    lac fsP
    add [2]
    lia
    jsp fiUp
    dac eg3
    lac fsP
    add [4]
    dac fsP
    jsp fiSpec
    lac fsK
    SKIP_NEXT_IF_AC_ZERO
    jmp egK
    lac fiUnit
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp fsBadD
    dac fsU
    law FK_FILE
    dac fsK
egK, SKIP_NEXT_IF_SAME [FK_FILE]
    jmp fsBadD
    lac eg2
    SKIP_NEXT_IF_SAME [0111]
    jmp egDl
    lac eg3
    SKIP_NEXT_IF_SAME [0122]
    jmp fiZrC
    lio fsU
    jsp i [elGo:MT_BANK]
    jmp fiM1C
egDl, SKIP_NEXT_IF_SAME [0105]
    jmp fiZrC
    lac eg3
    SKIP_NEXT_IF_SAME [0114]
    jmp fiZrC
    jsp fiName
    lio fsU
    jsp i [edGo:MT_BANK]
    jsp i [mtPendW:MT_BANK]
    jmp fiM1C

// fiGSt -- G* and :G* insert at the pointer the specification of the last
// file command (ER, EW, EB, EI, EN), ^S its length, or, with the colon, type it.
// AC is the colon, the * passed.
// No return value.
// Does not preserve AC or IO.
// Entered by jmp from c11G (qreg11.ac), ends by jmp rsLoop.
fiGSt, dac gsCol
    dzm gsI
    SKIP_NEXT_IF_AC_ZERO
    jmp gsL
    lio fiSpN
    jsp i [bRoom:0]
gsL, lac gsI
    SKIP_NEXT_IF_DIFFERENT fiSpN
    jmp gsE
    add [fiSpB:.]
    dac gsP
    lio i gsP
    lac gsCol
    SKIP_NEXT_IF_AC_ZERO
    jmp gsT
    jsp i [bIns1:0]
    jmp gsN
gsT, jsp i [putc:1]
gsN, idx gsI
    jmp gsL
gsE, lac gsCol
    SKIP_NEXT_IF_AC_ZERO
    jmp i [rsLoop:0]
    lac fiSpN
    dac i [lsLen:0]
    jmp i [rsLoop:0]

