// search11.ac -- the second command set's searches, S N _ E_ with n,
// -nS, m,nS and 0,nS, ::S, FB FC FS FN F_, :, the remembered string and G_, ES, and a
// failing search in an iteration; EV's lines before the prompt, as ES's.
//
// The text is built into the search string, sbBuf, a character a word.
// ^Q and ^R take the next character as it is, ^V and ^W the next in lower or upper case,
// ^EQq puts q's text, ^EUq the character q's number is the code of, and ^x is the
// control character x unless ED&1.
// A built character carries SB_LIT; a match construct (^X, ^S, ^N, ^E and its
// letter, ^EG's register name) is kept as typed, without it, and is read again at each
// comparison.
// A text that builds to nothing leaves the last string.
//
// A search tries each start from one index toward another, comparing the string with the
// text through bGet (sMat).
// When the string's first element is a plain character, a forward search looks for it a
// word of the gap buffer at a time first (sScan), as the 1965 set's does, for it and,
// while ^X is 0, for its other case.
// With ^X 0, a letter matches its other case, and ` { | } ~ match @ [ \ ] ^, as the
// manual has it.
//
// The handlers are reached from the dispatch (dTab11, c11E and c11F in interp11.ac, c11G
// in qreg11.ac), the routines with the extend window open.
// The file goes in bank 14 (P11_BANK).
// Needs teco.ah, <AIDS/skipmacros.ah>, interp11.ac (clr11, up11, v11Int, e3Str, the
// flags), in bank 9 data11.ac (sbBuf, eTab), in bank 0 interp.ac, expr.ac, buffer.ac,
// edit.ac (scanTo, lnTo, tyRange), search.ac (srFail, srCol, srUp), control.ac (cSemi,
// itDepth), in bank 1 termio.ac, lpt.ac (lpEnd), and in bank 15 files11.ac (fiPgN,
// fiPgU), qreg11.ac (q11Name, qText, qRecOf, lqSet).

// The search being done (s11K), for S, N, _ and E_, FB and FC.
#define SK_S         0
#define SK_N         1
#define SK_U         2
#define SK_FB        3

// eTab's entry for ^E and its letter says what the match construct accepts.
// It is the classes of chCls in EK_CLS (EK_NOT for a character in none of them), any
// character, a line's end, a run of spaces and tabs, or one of a register's characters.
#define EK_CLS       017
#define EK_NOT       0400
#define EK_SEP       (EK_NOT+7)
#define EK_ANY       01000
#define EK_EOL       02000
#define EK_SP        04000
#define EK_REG       010000

local s11G, s11G1, s11Rp, s11Nn, s11One, s11FBf, s11MN, s11Mf, s11Cnt, s11Sc, s11Fw, \
    s11Mb, s11Wb, s11Txt, s11Ill, s11Isa, s11Pos, s11Pb, sLoop, sNext, sNx1, sNx2, sNxB, \
    sMiss, sMs1, sMsY, sFound, sFd1, sFail, sFl1, sEnd, sDone, sSrh, spX, spV, snX, \
    soX, soF0, soF1, soFL, soSl, soBk, soB0, soBL, soYes, soNo, ssX, ss1, ss2, ss3, \
    ssRun, srnX, ssH, ssL, ssN, ssNone, ssGH, ssGL, ssT, ssC, smX, smL, smEl, smSep, \
    smKind, smInv, smNot, smEol, smSp, smSpL, smReg, smRg1, smRgL, smLit, smR0, smR1, \
    smRes, smYes, smNo, isX, isNo, ccX, ccUp, ccDg, ccSym, ccNo, rcX, rcG, prX, prH, \
    sbX, sbL, sbQ, sbV, sbW, sbVo, sbE5, sbEQ, sbQL, sbEU, sbG1, sbLit, sbCon, sbDn, \
    sbIce, chX, chLit, chBad, moX, moIss, puX, puStl, t2X, siX, siL, siYes, siNo, seX, \
    seVer, seMN, seGo, seAf, seCh, sePut, rpX, gsT, gsI, gsE, s11Mu, \
    s11K, s11R, s11C, s11At, s11Cm, s11M, s11N, s11Bd, s11Cn, s11A, s11B, s11D, s11W, \
    s11Dl, s11P2, s11L2, soA, soB, soD, soZ1, soFast, ssA, ssB, ssPA, ssPB, ssOff, ssLo, \
    ssHi, ssK, ssWP, ssPl, smI, smJ, smE, smP, smC, smT, smNeg, smLoc, smK, smQ, sFold, \
    sC1, sC2, sC1h, sC2h, sDt, ccC, rcN, rcF, sbE, sbN, sbLN, sbT, sbI, sbK, chC, puC, \
    puP, siI, siCo, seL, seC, seP, seF, gsCo, gsK, gsP, s11E, s11Z

// c11S, c11N, c11Un -- S, N, and _ or E_, each with its text.
// c11FS, c11FN and c11FU are the same, the match then given up for a second text.
// c11FB and c11FC are the bounded search, and with a second text.
// c11EUn is E_, which is _ but for yank protection (s11E).
// Does not preserve AC or IO.
// Entered by jmp from the dispatch, c11E or c11F, ends by jmp rsLoop (or through v11Int
// or cSemi).
c11FC, law 1
    jmp .+2
c11FB, cla
    dac s11R
    law SK_FB
    jmp s11G
c11FS, law SK_S
    jmp s11Rp
c11FN, law SK_N
    jmp s11Rp
c11FU, dzm s11E
    law SK_U
s11Rp, dac s11K
    law 1
    dac s11R
    jmp s11G1
c11S, law SK_S
    jmp s11Z
c11N, law SK_N
    jmp s11Z
c11EUn, law 1
    jmp .+2
c11Un, cla
    dac s11E
    law SK_U
s11Z, dzm s11R
s11G, dac s11K
    // the modifiers, then the arguments, which argOr clears with them
s11G1, lac i [colon11:0]
    dac s11C
    lac i [at11:0]
    dac s11At
    dzm i [srCol:0]
    dzm i [srUp:0]
    dzm s11Bd
    lac i [comma:0]
    dac s11Cm
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp s11Nn
    lac i [mval:0]
    dac i [ra:0]
    lac i [mval:0+1]
    dac i [ra:0+1]
    lac i [mval:0+2]
    dac i [ra:0+2]
    jsp i [toInt:0]
    dac s11M
s11Nn, lio [1]
    jsp i [argOr:0]
    dac s11N
    law i 1
    dac s11Cn               // one occurrence, but for the counted searches
    lac s11C
    SKIP_NEXT_IF_SAME [2]
    jmp s11One
    // ::S, a compare at the pointer, as .,.:FB
    lac s11K
    ior s11R
    SKIP_NEXT_IF_AC_ZERO
    jmp s11Ill
    law 1
    dac s11Bd
    lac i [dot:0]
    dac s11A
    dac s11B
    dzm s11D
    jmp s11Txt
s11One, lac s11K
    SKIP_NEXT_IF_SAME [SK_FB]
    jmp s11Cnt
    // FB, bounded, the pointer kept on failure
    law 1
    dac s11Bd
    lac s11Cm
    SKIP_NEXT_IF_AC_ZERO
    jmp s11MN
    // nFB, a start in the next n lines; 0 or less, back over this line's start and -n
    // more
    lio s11N
    jsp i [lnTo:0]
    dac s11B
    lac s11N
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp s11FBf
    lac i [dot:0]
    sub [1]
    dac s11A
    law 1
    dac s11D
    jmp s11Txt
s11FBf, lac s11B
    sub [1]
    dac s11B
    lac i [dot:0]
    dac s11A
    dzm s11D
    jmp s11Txt
    // m,nFB, a start between positions m and n, forward when m is below n, else back;
    // with m equal to n, only at m
s11MN, lio s11M
    jsp s11Pos
    lio s11N
    jsp s11Pos
    dzm s11D
    lac s11M
    dac s11A
    lac s11N
    sub s11M
    SKIP_NEXT_IF_AC_ZERO
    jmp s11Mf
    lac s11M
    dac s11B
    jmp s11Txt
s11Mf, SKIP_NEXT_IF_AC_NEGATIVE
    jmp s11Mu
    law 1                   // m above n, m-1 back to n
    dac s11D
    lac s11M
    sub [1]
    dac s11A
    lac s11N
    dac s11B
    jmp s11Txt
s11Mu, lac s11N             // m below n, m to n-1
    sub [1]
    dac s11B
    jmp s11Txt
    // the counted searches, n occurrences, back for n below 0; N and _ forward only, with
    // no m,n
s11Cnt, lac s11N
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp s11Isa
    lac s11K
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp s11Sc
    lac s11Cm
    SKIP_NEXT_IF_AC_ZERO
    jmp s11Ill
    lac s11N
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp s11Isa
s11Sc, lac s11N
    SKIP_NEXT_IF_AC_NEGATIVE
    cma
    dac s11Cn               // -|n|, for isp
    lac s11N
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp s11Fw
    law 1
    dac s11D
    lac i [dot:0]
    sub [1]
    dac s11A
    dzm s11B
    jmp s11Mb
s11Fw, dzm s11D
    lac i [dot:0]
    dac s11A
    lac i [zz:0]
    dac s11B
    // m,nS, the start at most |m|-1 places from the pointer; 0,nS unbounded; with
    // either, the pointer kept on failure
s11Mb, lac s11Cm
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp s11Txt
    law 1
    dac s11Bd
    lac s11M
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp s11Txt
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    cma
    sub [1]
    dac s11W
    lac s11D
    SKIP_NEXT_IF_AC_ZERO
    jmp s11Wb
    lac i [dot:0]
    add s11W
    dac s11B
    jmp s11Txt
s11Wb, lac i [dot:0]
    sub s11W
    dac s11B
    // the text, the second text, and the string's first character for sScan
s11Txt, jsp sBld
    lac s11R
    SKIP_NEXT_IF_AC_ZERO
    jsp sTx2
    jsp sPrep
    lac s11A
    dac soA
    lac s11B
    dac soB
    lac s11D
    dac soD
sLoop, jsp sOne
    SKIP_NEXT_IF_AC_ZERO
    jmp sMiss
    isp s11Cn
    jmp sNext
    jmp sFound
    // the next occurrence, forward from the match's end, or with ED&64 from its first
    // character's next; back from its first character's left
sNext, lac soD
    SKIP_NEXT_IF_AC_ZERO
    jmp sNxB
    lac flED+2
    and [0100]
    SKIP_NEXT_IF_AC_ZERO
    jmp sNx1
    lac smE
    jmp sNx2
sNx1, lac smI
    add [1]
sNx2, dac soA
    jmp sLoop
sNxB, lac smI
    sub [1]
    dac soA
    jmp sLoop
    // not in this page, so N writes it out as P does, _ gives it up as Y does, E_ as EY
    // does (files11.ac); each then reads the next and searches it from its start
sMiss, lac s11K
    SKIP_NEXT_IF_SAME [SK_N]
    jmp sMs1
    jsp i [fiPgN:EX_BANK]
    jmp sMsY
sMs1, SKIP_NEXT_IF_SAME [SK_U]
    jmp sFail
    lio s11E
    jsp i [fiPgU:EX_BANK]
sMsY, SKIP_NEXT_IF_AC_ZERO
    jmp sFail
    dzm soA
    lac i [zz:0]
    dac soB
    jmp sLoop
    // found, the pointer goes after the match, or with ED&64 after its first character
    // (not for a replace, nor back); then ^S is its length, ES runs, and the second text
    // goes in its place
sFound, jsp sNpr
    dzm i [srFail:0]
    lac smE
    sub smI
    dac i [lsLen:0]
    lac smE
    dac sDt
    lac soD
    ior s11R
    SKIP_NEXT_IF_AC_ZERO
    jmp sFd1
    lac flED+2
    and [0100]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sFd1
    lac smI
    add [1]
    dac sDt
sFd1, lac sDt
    dac i [dot:0]
    jsp sEs
    lac s11R
    SKIP_NEXT_IF_AC_ZERO
    jsp sRepl
    lio [-1]
    jmp sEnd
    // failed, the pointer goes to 0 unless the search was bounded or ED&16; with
    // :, the value is 0; in an iteration with ; next, that ; leaves it (srFail); in one
    // without, %Search fail in iter is typed and the iteration left; else SRH
sFail, jsp sNpr
    law 1
    dac i [srFail:0]
    lac s11Bd
    SKIP_NEXT_IF_AC_ZERO
    jmp sFl1
    lac flED+2
    and [020]
    SKIP_NEXT_IF_AC_NOT_ZERO
    dzm i [dot:0]
sFl1, cli
    lac s11C
    SKIP_NEXT_IF_AC_ZERO
    jmp sEnd
    lac i [itDepth:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sSrh
    jsp sSemi
    SKIP_NEXT_IF_AC_ZERO
    jmp sDone
    lio [msFail:.]
    jsp e3Str
    jsp i [newline:1]
    jsp clr11
    law 1
    dac i [have:0]
    dzm i [val:0]
    dzm i [val:0+1]
    dzm i [val:0+2]
    jmp i [cSemi:0]
    // the value in IO, after :
sEnd, lac s11C
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sDone
    jsp clr11
    jmp v11Int
sDone, jsp clr11
    jmp i [rsLoop:0]
sSrh, ERR11(EC_SRH)
s11Isa, ERR11(EC_ISA)
s11Ill, lac i [curC:0]      // ILL names the command as m,n and its letter
    ior [0200]
    dac i [eArg:0]
    ERR11(EC_ILL)

// s11Pos -- POP unless IO is a position in the text, 0 to Z.
// No return value.
// AC is not preserved, IO is preserved.
// Called via jsp.
s11Pos, dac spX
    dio spV
    lac spV
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp s11Pb
    lac i [zz:0]
    sub spV
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i spX
s11Pb, lac i [curC:0]
    ior [0200]
    dac i [eArg:0]
    ERR11(EC_POP)

// sNpr -- after N, put the printer at a line's start, as after P.
// Has no arguments and no return values.
// AC is not preserved, IO is preserved.
// Called via jsp.
sNpr, dac snX
    lac s11K
    SKIP_NEXT_IF_DIFFERENT [SK_N]
    jsp i [lpEnd:1]
    jmp i snX

// sOne -- look for the search string starting at an index from soA to soB, toward soB
// (soD 0 forward, 1 back); a start at Z or past it, or below 0, is none.
// Takes soA, soB and soD.
// Found, AC is 0, smI the match's first index and smE the index after it.
// Not found, AC is 1.
// soA is moved on.
// AC is the result, IO is not preserved.
// Called via jsp.
sOne, dac soX
    lac sbLen
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp soNo
    lac i [zz:0]
    sub [1]
    dac soZ1
    lac soD
    SKIP_NEXT_IF_AC_ZERO
    jmp soBk
    lac soB
    sub soZ1
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp soF0
    jmp soF1
soF0, lac soZ1
    dac soB
soF1, lac soFast
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp soSl
    // forward, the first character found by the word, the rest compared there
soFL, lac soB
    sub soA
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp soNo
    lac soA
    dac ssA
    lac soB
    dac ssB
    jsp sScan
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp soNo
    dac smI
    add [1]
    dac soA
    jsp sMat
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp soYes
    jmp soFL
    // forward, a place at a time
soSl, lac soB
    sub soA
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp soNo
    lac soA
    dac smI
    idx soA
    jsp sMat
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp soYes
    jmp soSl
    // back, a place at a time, from Z-1 at most
soBk, lac soA
    sub soZ1
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp soB0
    jmp soBL
soB0, lac soZ1
    dac soA
soBL, lac soA
    sub soB
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp soNo
    lac soA
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp soNo
    dac smI
    sub [1]
    dac soA
    jsp sMat
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp soYes
    jmp soBL
soYes, cla
    jmp i soX
soNo, law 1
    jmp i soX

// sScan -- find the first index from ssA to ssB, both below Z, whose character is sC1 or
// sC2.
// Takes ssA and ssB.
// AC is the index, -1 with none; IO is preserved.
// Called via jsp.
sScan, dac ssX
    // before the gap, ssA to min(gs-1, ssB), at places equal to them
    lac ssA
    dac ssPA
    lac i [gs:0]
    sub [1]
    dac ssPB
    sub ssB
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp ss1
    jmp ss2
ss1, lac ssB
    dac ssPB
ss2, dzm ssOff
    jsp ssRun
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i ssX
    // after it, max(ssA, gs) to ssB, ge-gs places above their indexes
    lac i [ge:0]
    sub i [gs:0]
    dac ssOff
    lac ssA
    sub i [gs:0]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp ss3
    lac i [gs:0]
    jmp .+2
ss3, lac ssA
    dac ssPA
    lac ssB
    dac ssPB
    jsp ssRun
    jmp i ssX

// ssRun -- sScan in one run, indexes ssPA to ssPB at places ssOff above them.
// Takes ssPA, ssPB and ssOff.
// AC is the index found, or -1; IO is preserved.
// Called via jsp.
ssRun, dac srnX
    lac ssPB
    sub ssPA
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp ssNone
    lac ssPA
    add ssOff
    dac ssLo                // the first place
    lac ssPB
    add ssOff
    dac ssHi                //   and the last
    rar 1s
    and [PK_WORD]
    dac ssK
    lac ssLo
    rar 1s
    and [PK_WORD]
    dac ssWP
    // the words from ssLo's through ssHi's, as -(count) for isp
    lac ssK
    sub ssWP
    add [1]
    cma
    dac ssK
    lac ssWP
    add [BUF_BASE]
    dac ssWP
    // both halves of each word are compared; a half outside the run, which may be the
    // gap's, is passed over
ssH, lac i ssWP
    and [PK_HI]
    SKIP_NEXT_IF_DIFFERENT sC1h
    jmp ssGH
    SKIP_NEXT_IF_DIFFERENT sC2h
    jmp ssGH
ssL, lac i ssWP
    and [PK_LO]
    SKIP_NEXT_IF_DIFFERENT sC1
    jmp ssGL
    SKIP_NEXT_IF_DIFFERENT sC2
    jmp ssGL
ssN, idx ssWP
    isp ssK
    jmp ssH
ssNone, law i 1
    jmp i srnX
ssGH, lac ssWP
    sub [BUF_BASE]
    ral 1s                  // twice the word's offset, which is below 2^16
    jmp ssT
ssGL, lac ssWP
    sub [BUF_BASE]
    ral 1s
    add [1]
    // the character is at place ssPl; before ssLo it is passed over, past ssHi the run
    // is done
ssT, dac ssPl
    sub ssLo
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp ssC
    lac ssHi
    sub ssPl
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp ssNone
    lac ssPl
    sub ssOff
    jmp i srnX
    // on with the low half after a high one, else the next word
ssC, lac ssPl
    and [1]
    SKIP_NEXT_IF_AC_ZERO
    jmp ssN
    jmp ssL

// sMat -- match the search string against the text from index smI.
// Takes smI.
// Returns AC 0 when it matches, smE then the index after the match, else AC 1.
// Each element takes one character of the text, but ^ES all the spaces and tabs in a
// row; ^N before an element takes any character it does not.
// AC is the result, IO is not preserved.
// Called via jsp.
sMat, dac smX
    lac smI
    dac smJ
    lac [sbBuf:D11_BANK]
    dac smP
smL, lac smP
    sub sbEnd
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp smYes
    lac smJ
    sub i [zz:0]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp smNo
    lio smJ
    jsp i [bGet:0]
    dio smC
    dzm smNeg
smEl, lac i smP
    dac smT
    idx smP
    lac smT
    and [SB_LIT]
    SKIP_NEXT_IF_AC_ZERO
    jmp smLit
    lac smT
    SKIP_NEXT_IF_DIFFERENT [CH_CTLN]
    jmp smNot
    SKIP_NEXT_IF_DIFFERENT [CH_CTLX]
    jmp smR1
    SKIP_NEXT_IF_DIFFERENT [CH_CTLS]
    jmp smSep
    // ^E, its letter's entry in eTab (sBld stores no other construct)
    lio i smP
    idx smP
    lai
    sub [0101]
    add [eTab:D11_BANK]
    dac smT
    lac i smT
    jmp smKind
smSep, law EK_SEP
smKind, dac smT
    and [EK_ANY]
    SKIP_NEXT_IF_AC_ZERO
    jmp smR1
    lac smT
    and [EK_EOL]
    SKIP_NEXT_IF_AC_ZERO
    jmp smEol
    lac smT
    and [EK_SP]
    SKIP_NEXT_IF_AC_ZERO
    jmp smSp
    lac smT
    and [EK_REG]
    SKIP_NEXT_IF_AC_ZERO
    jmp smReg
    // a class, in one of smT's, or with EK_NOT in none
    lio smC
    jsp chCls
    and smT
    and [EK_CLS]
    SKIP_NEXT_IF_AC_ZERO
    law 1
    dac smK
    lac smT
    and [EK_NOT]
    SKIP_NEXT_IF_AC_ZERO
    jmp smInv
    lac smK
    jmp smRes
smInv, lac smK
    xor [1]
    jmp smRes
smNot, lac smNeg
    xor [1]
    dac smNeg
    jmp smEl
smEol, lac smC
    SKIP_NEXT_IF_DIFFERENT [CH_LF]
    jmp smR1
    SKIP_NEXT_IF_DIFFERENT [CH_VT]
    jmp smR1
    SKIP_NEXT_IF_DIFFERENT [CH_FF]
    jmp smR1
    jmp smR0
    // ^ES, a space or a tab, and every one after it; under ^N, one character alone
smSp, jsp isSp
