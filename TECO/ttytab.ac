// ttytab.ac -- the typewriter's character tables for TECO's termio.ac.
// The tables are generated from the emulator's ASCII and FIO-DEC (concise) conversion
// (Tools/UtilLibs/flexoConversion.c) and are not to be edited by hand.
// The keys ` | ~ # stand for ALT MODE ; : %, typed and printed, and the
// center dot @ is a prefix (termio.ac).
// Include it in bank 1, where it is not executed.

// ttyOut holds, for each ASCII character 0 to 0177, its concise code with
// TTLOWER or TTUPPER for the case it needs, neither for a code with no case,
// TTNONE for a character not typed, and TTPFX when the center dot is typed
// first. CR and LF are termio.ac's.
ttyOut,
    1120                    // control 000 lower, as @0
    1261                    // control 001 upper, as @A
    1262                    // control 002 upper, as @B
    1263                    // control 003 upper, as @C
    1264                    // control 004 upper, as @D
    1265                    // control 005 upper, as @E
    1266                    // control 006 upper, as @F
    1267                    // control 007 upper, as @G
    1270                    // backspace upper, as @H
    0036                    // tab no case
    0400                    // LF none
    1242                    // control 013 upper, as @K
    1243                    // control 014 upper, as @L
    0400                    // CR none
    1245                    // control 016 upper, as @N
    1246                    // control 017 upper, as @O
    1247                    // control 020 upper, as @P
    1250                    // control 021 upper, as @Q
    1251                    // control 022 upper, as @R
