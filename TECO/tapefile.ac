// The handles' addresses in bank 13 (teco.ah).
mtHAdrT,
    HND0
    HND0+FS_HANDLEW
    HND0+(2*FS_HANDLEW)
    HND0+(3*FS_HANDLEW)
    assert . - mtHAdrT == MT_NHND, "an address for each handle"
endloc

