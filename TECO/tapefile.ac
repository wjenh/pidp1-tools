// mtCh -- give the next character of the file, its eighth bit dropped.
// Whole buffers are read, MT_RDW words at a time.
// Has no arguments.
// AC is 0 with IO the character, or 1 at the file's end.
// AC is the result, IO is not preserved at the file's end.
// A failure leaves by mtFail, and a break leaves through tmErr (brkChk).
// Called via jsp.
mtCh, dac mcX
mcAgain, lac rbIdx
    sub rbLen
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp mcFill
    lac rbIdx
    add [RDBUF]
    dac mcP
    lac i mcP
    dac mcW
    lac rbHalf
    SKIP_NEXT_IF_AC_ZERO
    jmp mcLo
    law 1
    dac rbHalf
    lac mcW
    rar 9s
    jmp mcOut
mcLo, dzm rbHalf
    idx rbIdx
    lac mcW
mcOut, and [0177]
    lia
    cla
    jmp i mcX
    // the buffer is used up, so read the next words from where it ended
mcFill, jsp i [brkChk:1]
    jsp i [clkTick:0]
    lac rbStart
    add rbLen
    dac rbStart
    dzm rbIdx
    dzm rbLen
    lac [FD_IN]
    dac mtPb+FS_PFDESC
    lac [RDBUF]
    dac mtPb+FS_PBUF
    lac [MT_RDW]
    dac mtPb+FS_PCOUNT
    lac [mtPb:.]
    mtcall(fsRead:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp mtFail
    dio rbLen
    lac rbLen
    SKIP_NEXT_IF_AC_ZERO
    jmp mcAgain
    law 1
    jmp i mcX

// mtBack -- give back to the tape what a full buffer did not take.
// With IO not 0, the line cut short and the character go back, to the line's start.
// With IO 0, the character alone goes back.
// The reader's place moves back, within its buffer or by a seek.
// IO chooses, as above.
// No return value.
// Does not preserve AC or IO.
// A failure leaves by mtFail with the library's message.
// Reached from any bank with the extend window open.
// Called via jsp.
mtBack, dac mkX
    lac [mtCpP:.]
    SKIP_NEXT_IF_IO_IS_ZERO
    lac [mtCpL:.]
    dac mkP
    lac i mkP
    dac mkPos
    idx mkP
    lac i mkP
    dac rbHalf
    idx mkP
    lac i mkP
    dac rbLF
    idx mkP
    lac i mkP
    dac rbCR
    lac mkPos
    sub rbStart
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp mkSeek
    dac mkI
    sub rbLen
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp mkSeek
    lac mkI
    dac rbIdx
    jmp i mkX
mkSeek, lac [FD_IN]
    dac mtPb+FS_PFDESC
    lac mkPos
    dac mtPb+FS_PPOS
    lac [mtPb:.]
    farjda(fsSeek:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp mtFail
    lac mkPos
    dac rbStart
    dzm rbLen
    dzm rbIdx
    jmp i mkX

// cpSave -- save the reader's place to the four words at the 16-bit address in IO.
// The words are the word in the file, the half, a line feed owed, and a CR just read.
// IO is the address.
// No return value.
// AC is not preserved, IO is preserved.
// Called via jsp.
cpSave, dac csX
    dio csP
    lac rbStart
    add rbIdx
    dac i csP
    idx csP
    lac rbHalf
    dac i csP
    idx csP
    lac rbLF
    dac i csP
    idx csP
    lac rbCR
    dac i csP
    jmp i csX

