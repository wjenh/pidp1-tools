// tapefile.ac -- files on Type 550 Microtape, on the file system library
// (Am1Includes/FILESYSTEM and MICROTAPE).
// It holds ER and /Q, the tape's text for Y, A, N and P through rdStart and rdGet
// (ptape.ac), EL, ET, EK, ED, EC, u,0EC and u,vEC, and the directory as TECO shows it.
// The output, EI, EF, EN, /W and /V, is tapeout.ac's, in bank 1, where there is room.
// Unit DR_UNIT is the drum's volume, mounted and formatted by additions.ac's
// drvMount and drvFormat, in bank 15, which choose the device.
// Every other call is the same on it.
//
// The library's code and this file are in bank 12.
// The handles, the descriptors, the changes pending and the buffers are in bank 13
// (teco.ah).
// Four units' directories are held at once, a handle each.
// A fifth unit takes the place of one with no change pending and no file open, which is
// only forgotten, as EK forgets it.
//
// Text on tape is fstool's text form.
// That is two 8-bit characters a word, the first in the high half, a line ending in CR
// alone, and a zero half padding the end.
// Reading gives CR as CR LF, drops an LF that follows a CR on the tape, drops the eighth
// bit, and passes over NUL and DEL, as the paper tape reader does.
//
// A full buffer gives back to the tape by moving the reader's place.
// The place moves back to the start of the line cut short, or, with no whole line read,
// to the character that did not fit.
// So a page cut short is read on from there, with no reader's buffer between.
//
// ED and EN change only the directory in memory.
// A deletion or a rename is pending until EC or EF writes it, EL shows it, and EK
// forgets it.
// A name is found as TECO shows the directory (mtFindN).
// A pending rename's new name finds its file, its old name and a pending deletion's name
// find nothing, and the output's scratch file is not shown.
//
// A failure the library reports types its message in place of ?, as the memo's i-o
// routines did.
// errTxt is the message, and errIdle (teco.am1) types it.
// The rest is as any error, the string dropped and TECO idle.
// The messages, and EL's type-out, are tapemsg.ac's, in bank 15.
//
// An error is jmp i [err:0], and a library failure jmp mtFail with its status in AC.
// The file goes in bank 12, after the library's calls, and its data words follow its
// code.
// A library call that may move the tape is made through mtcall (teco.ah), so WAIT shows
// meanwhile.
// One that does not is farjda.
// entGet, elS, nmUnp, nmLen and nmSp are global, for /U (display.ac) and the second
// set's EN.
// erOpn, edGo and elGo, cER's, cED's and cEL's work as routines, are global with nrN,
// mtPackN, fnSoft and mfS, for the second set's files (files11.ac).
// Requires the file system library's version 2.1, whose handle and descriptor sizes
// teco.ah's bank 13 layout takes (the asserts below).
// Needs teco.ah, <AIDS/skipmacros.ah>, <MICROTAPE/microtape.ah>, fsio.ac, mtmount.ac,
// mtformat.ac and fsdelete.ac.
// Needs nextCh, argOr, toInt, fromInt, fmtNum, the argument state and clkTick in bank 0.
// Needs putc, newline, brkChk, tapeout.ac and display.ac's mtCall in bank 1.
// Needs additions.ac's drvMount, drvFormat and drvHnd in bank 15.

assert FS_HANDLEW == 01047, "teco.ah's bank 13 layout takes a handle as 01047 words"
assert FS_FILEW == 012, "teco.ah's bank 13 layout takes a descriptor as 012 words"
assert FD_IN == HND0 + (MT_NHND*FS_HANDLEW), "teco.ah's descriptors follow the handles"
assert MT_PEND == FD_OUT + FS_FILEW, "teco.ah's pending deletions follow the descriptors"
assert MT_PENDW >= FS_NENT, "teco.ah's pending deletions take a word a directory slot"
assert MT_NAMEC == FS_DENAMEW*3, "teco.ah's name is the directory's, 3 sixbit characters a word"
assert MT_NSTRW == (MT_NAMEC+1)/2+1, "teco.ah's name string is two characters a word and a zero"
assert MTWDS == 0400, "entGet's sar 8s divides by a block's words"
assert FS_DENAMEW == 3, "a pending rename keeps a name as 3 sixbit words"

local miX, ceC, ceD, cER, cEL, cET, cEK, cED, cEC, erU, erOk, \
    elN, elPB, elK, el1, el1s, el1p, el1n, egPd, el2, el2s, el2n, elStar, elMc, \
    elTwo, elT, elBk, ekGo, ekOut, edU, edS, edI, edP, edRo, ecS, ecP, ecL, ecDel, ecN, \
    ecTwo, ecU, ecV, ecE, ecFmt, uoX, uoArg, uuX, ucX, ucHi, \
    nrX, nrL, nrBl, nrPut, nrEnd, nrPk, nrW1, nrZ, nrC, nrSp, nrTwo, erX, edX, elX, fnSf, \
    nrI, nrQ, nrW, nrAdd, naX, naP, hFind, hfX, hfL, hfHit, hfU, hfI, \
    hfP, hgX, hgU, hgE, hTake, htX, htF, htE, htP0, htP1, htNx, htUse, htU, htI, htP, \
    hsX, hsP, hzX, hzP, pendAny, paX, paL, paP, paK, zeroW, zwX, zwL, \
    zP, zN, onX, icX, uDrop, udX, udH, udO, udU, udP, cp400, cwX, cwL, \
    cpS, cpD, cwK, mfP, mfQ, mtCh, mcX, mcAgain, mcLo, mcOut, \
    mcFill, mcP, mcW, mgX, mgLoop, mgTape, mgIsLf, mgCr, mgLf, mgOut, mgC, msX, \
    mkX, mkP, mkPos, mkI, mkSeek, cpSave, csX, csP, \
    egX, egShow, egPend, egR, egT, nuX, nu3, n3X, n3W, nuPut, npX, npP, \
    nuC, nuI, nuL, nuT, nuS, erP, \
    nuM, pkX, fnX, fnK, fnR, fnNo, fnS, fnHid, fnTape, enmX, enmI, enmL, enmP, enmEnd, \
    trfX, trfP, trfK, trfL, trfH, trfN, trfQ, trfNx, trfHit, trClr, trcX, trcL, trcP, \
    trcH, trcN, trsX, trsL, trsP, trsH, trsN, trsQ, trsNx, pwX, paH, paR

// mtInit -- forget every tape and every pending change and take input from paper tape,
// every handle, descriptor and pending deletion as when TECO is loaded (not mounted,
// not open), so the restart starts clean.
// Has no arguments and no return values.
// AC is not preserved, IO is preserved.
// Reached from any bank with the extend window open.
// Called via jsp.
mtInit, dac miX
    lac [MT_DATA]
    dac zP
    lac [MT_DEND-MT_DATA]
    dac zN
    jsp zeroW
    dzm hUnit
    dzm hUnit+1
    dzm hUnit+2
    dzm hUnit+3
    dzm inMt
    dzm inOpen
    dzm mtUnit
    dzm errTxt
    jsp i [outInit:1]
    jmp i miX

// cE -- dispatch E and its letter, a lower-case letter as its upper case.
// Any other letter is an error.
// Reads the letter (nextCh).
// No return value.
// Does not preserve AC or IO.
// Entered by jmp from the dispatch, and goes by jmp to the letter's handler.
cE, jsp i [nextCh:0]
    lai
    and [0177]
    dac ceC
    sub [0141]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp ceD
    sub [0d26]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp ceD
    lac ceC
    sub [040]
    dac ceC
ceD, lac ceC
    SKIP_NEXT_IF_DIFFERENT [0122]
    jmp cER
    SKIP_NEXT_IF_DIFFERENT [0114]
    jmp cEL
    SKIP_NEXT_IF_DIFFERENT [0124]
    jmp cET
    SKIP_NEXT_IF_DIFFERENT [0113]
    jmp cEK
    SKIP_NEXT_IF_DIFFERENT [0104]
    jmp cED
    SKIP_NEXT_IF_DIFFERENT [0103]
    jmp cEC
    // the output's, tapeout.ac's; any other letter is no command
    SKIP_NEXT_IF_DIFFERENT [0111]
    jmp i [cEI:1]
    SKIP_NEXT_IF_DIFFERENT [0106]
    jmp i [cEF:1]
    SKIP_NEXT_IF_DIFFERENT [0116]
    jmp i [cEN:1]
    jmp i [err:0]

// cER -- oERnm$ makes file nm on unit o, as TECO shows the directory, the
// input, and takes input from the tape (/Q).
// The file read before is closed, even when nm is not found.
// Reads the argument state (unitO) and the name (nmRead).
// No return value.
// Does not preserve AC or IO.
// Entered by jmp from cE, ends by jmp rsLoop.
cER, jsp unitO
    dac erU
    jsp nmRead
    lio erU
    jsp erOpn
    jmp i [rsLoop:0]

// erOpn -- do cER's work, making file mtNmStr on unit IO the input, from the tape.
// For the second set's ER and EB too (files11.ac).
// IO is the unit; mtNmStr is read.
// No return value.
// Does not preserve AC or IO.
// A failure leaves by mtFail with the library's message.
// Reached from any bank with the extend window open.
// Called via jsp.
erOpn, dac erX
    jsp hGet
    jsp inClose
    jsp mtFindN
    dac mtPb+FS_PINDEX
    lac hAdr
    dac mtPb+FS_PHANDLE
    lac [FD_IN]
    dac mtPb+FS_PFD
    lac [mtPb:.]
    farjda(fsOpenIndex:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp mtFail
erOk, law 1
    dac inOpen
    dac inMt
    lac hIdx
    dac inHnd
    dzm rbStart
    dzm rbLen
    dzm rbIdx
    dzm rbHalf
    dzm rbLF
    dzm rbCR
    jmp i erX

// cSelQ -- /Q takes input from the tape, the file ER opened, read on from where
// it was.
// With none open, it is an error.
// Reads the argument state (argOr).
// No return value.
// Does not preserve AC or IO.
// Entered by jmp from the dispatch, ends by jmp rsLoop.
cSelQ, cli
    jsp i [argOr:0]
    lac inOpen
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i [err:0]
    law 1
    dac inMt
    jmp i [rsLoop:0]

// cET -- uET reads unit u's directory into memory, if it is not there.
// Reads the argument state (unitU).
// No return value.
// Does not preserve AC or IO.
// Entered by jmp from cE, ends by jmp rsLoop.
cET, jsp unitU
    lia
    jsp hGet
    jmp i [rsLoop:0]

// cEK -- uEK forgets unit u's directory, its pending changes with it.
// The tape is not touched.
// It is an error while the input file or the output's file is on u.
// Reads the argument state (unitU).
// No return value.
// Does not preserve AC or IO.
// Entered by jmp from cE, ends by jmp rsLoop.
cEK, jsp unitU
    lia
    jsp hFind
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp i [rsLoop:0]
    lac inOpen
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ekOut
    lac inHnd
    SKIP_NEXT_IF_DIFFERENT hIdx
    jmp i [err:0]
ekOut, lac i [outOpen:1]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ekGo
    lac i [outHnd:1]
    SKIP_NEXT_IF_DIFFERENT hIdx
    jmp i [err:0]
ekGo, jsp hForget
    jmp i [rsLoop:0]

// cED -- oEDnm$ makes file nm's deletion pending on unit o, written by EC or EF.
// A rename pending for it is dropped.
// A read-only file is refused at once.
// Reads the argument state (unitO) and the name (nmRead).
// No return value.
// Does not preserve AC or IO.
// Entered by jmp from cE, ends by jmp rsLoop.
cED, jsp unitO
    dac edU
    jsp nmRead
    lio edU
    jsp edGo
    jmp i [rsLoop:0]

// edGo -- do cED's work, making file mtNmStr's deletion pending on unit IO, whose
// handle is left selected.
// For the second set's :EGDEL too (files11.ac).
// IO is the unit; mtNmStr is read.
// No return value.
// Does not preserve AC or IO.
// Changes elS.
// A failure leaves by mtFail with the library's message.
// Reached from any bank with the extend window open.
// Called via jsp.
edGo, dac edX
    jsp hGet
    jsp mtFindN
    dac edS
    dac elS
    jsp entGet
    lac mtEnt+FS_DEINFO
    and [FS_IRO]
    SKIP_NEXT_IF_AC_ZERO
    jmp edRo
    lac edS
    add hPend
    dac edP
    law 1
    dac i edP
    lio edS
    jsp trFind
    SKIP_NEXT_IF_AC_ZERO
    dzm i trfP
    jmp i edX
edRo, law FS_EREADONLY
    jmp mtFail

// cEC -- uEC writes unit u's pending changes to the tape (mtPendW).
// u,0EC writes an empty directory on u.
// u,vEC writes v's directory on u, as v's tape holds it.
// Reads the argument state (comma, mval, have, argOr, unitU).
// No return value.
// Does not preserve AC or IO.
// Entered by jmp from cE, ends by jmp rsLoop.
cEC, lac i [comma:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp ecTwo
    jsp unitU
    lia
    jsp hGet
    jsp mtPendW
    jmp i [rsLoop:0]

// mtPendW -- write the selected handle's pending changes to the tape.
// The deletions go first, the input file closed first if it is one of them, then the
// renames (rnApply, tapeout.ac).
// A failure leaves by mtFail with the library's message, and what was written stays
// written.
// Has no arguments and no return values.
// Does not preserve AC or IO.
// Reached from any bank with the extend window open.
// Called via jsp.
mtPendW, dac pwX
    dzm ecS
ecL, lac ecS
    add hPend
    dac ecP
    lac i ecP
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ecN
    lac inOpen
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ecDel
    lac inHnd
    SKIP_NEXT_IF_SAME hIdx
    jmp ecDel
    lac i [FD_IN+FS_FSLOT]
    SKIP_NEXT_IF_SAME ecS
    jmp ecDel
    jsp inClose
ecDel, lac hAdr
    dac mtPb+FS_PHANDLE
    lac ecS
    dac mtPb+FS_PINDEX
    lac [FD_X]
    dac mtPb+FS_PFD
    lac [mtPb:.]
    farjda(fsOpenIndex:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp mtFail
    lac [FD_X]
    mtcall(fsDelete:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp mtFail
    dzm i ecP
ecN, idx ecS
    SKIP_NEXT_IF_SAME [FS_NENT]
    jmp ecL
    jsp i [rnApply:1]
    jmp i pwX
    // u,v takes u from the first argument, v from the second
ecTwo, lac i [mval:0]
    dac i [ra:0]
    lac i [mval:0+1]
    dac i [ra:0+1]
    lac i [mval:0+2]
    dac i [ra:0+2]
    jsp i [toInt:0]
    dac ecU
    lac i [have:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i [err:0]
    cli
    jsp i [argOr:0]
    dac ecV
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ecFmt
    lio ecV
    jsp unitChk
    lio ecU
    jsp unitChk
    lac ecU
    SKIP_NEXT_IF_DIFFERENT ecV
    jmp i [rsLoop:0]        // a tape's own directory, so nothing changes
    // no copy between the drum and a tape
    SKIP_NEXT_IF_DIFFERENT [DR_UNIT]
    jmp i [err:0]
    lac ecV
    SKIP_NEXT_IF_DIFFERENT [DR_UNIT]
    jmp i [err:0]
    lio ecV
    jsp hGet
    // v's directory twice, for u's blocks 1 and 2
    lac hAdr
    add [FS_HDIR]
    dac cpS
    lac [SCRBUF]
    dac cpD
    jsp cp400
    lac hAdr
    add [FS_HDIR]
    dac cpS
    jsp cp400
    lio ecU
    jsp uDrop
    lac ecU
    dac mtPb+MTB_PDRIVE
    law FS_DIRBLK
    dac mtPb+MTB_PBLOCK
    law 2
    dac mtPb+MTB_PCOUNT
    lac [SCRBUF]
    dac mtPb+MTB_PBUF
    lac [mtPb:.]
    mtcall(mtbWrite:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp mtFail
    jmp i [rsLoop:0]
    // u,0 writes an empty directory, as the library formats.
    // A tape holding another program's data in blocks 1 and 2 is refused.
ecFmt, lio ecU
    jsp unitChk
    lio ecU
    jsp uDrop
    lio ecU
    jsp hTake
    lac hAdr
    dac i [drvHnd:EX_BANK]
    lio ecU
    jsp i [drvFormat:EX_BANK]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i [rsLoop:0]
    dac ecE
    jsp hForget
    lac ecE
    jmp mtFail

// cEL -- oEL types unit o's directory as TECO holds it (entGet), with pending
// deletions gone, pending renames under their new names and the output's scratch file
// hidden.
// It types the free directory entries and the free blocks, then a line for each file
// with its mode's character, its subnames (@ for the first when it has one) and its
// blocks.
// The columns are PDP-6 TECO's, every 8, and the numbers decimal.
// Reads the argument state (unitO).
// No return value.
// Does not preserve AC or IO.
// Entered by jmp from cE, ends by jmp rsLoop.
cEL, jsp unitO
    lia
    jsp elGo
    jmp i [rsLoop:0]

// elGo -- do cEL's work, typing unit IO's directory.
// For the second set's :EGDIR too (files11.ac).
// IO is the unit.
// No return value.
// Does not preserve AC or IO.
// A failure leaves by mtFail with the library's message.
// Reached from any bank with the extend window open.
// Called via jsp.
elGo, dac elX
    jsp hGet
    dzm elN
    dzm elPB
    dzm elS
el1, jsp entGet
    SKIP_NEXT_IF_DIFFERENT [1]
    jmp el1s
    SKIP_NEXT_IF_DIFFERENT [2]
    jmp el1p
    jmp el1n
el1s, idx elN
    jmp el1n
el1p, lac elPB
    add mtEnt+FS_DEALLOC
    dac elPB
el1n, idx elS
    SKIP_NEXT_IF_SAME [FS_NENT]
    jmp el1
    lac hAdr
    dac mtPb+FS_PHANDLE
    dzm mtPb+FS_PNEED
    lac [mtPb:.]
    farjda(fsFree:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp mtFail
    jsp i [newline:1]
    dzm i [elCol:EX_BANK]
    lio [mtHdrF:EX_BANK]
    jsp i [elStr:EX_BANK]
    jsp i [elTab:EX_BANK]
    law FS_NENT
    sub elN
    lia
    jsp i [elNum:EX_BANK]
    jsp i [elTab:EX_BANK]
    lio [mtHdrB:EX_BANK]
    jsp i [elStr:EX_BANK]
    jsp i [elTab:EX_BANK]
    lac mtPb+FS_PTOTAL
    add elPB
    lia
    jsp i [elNum:EX_BANK]
    jsp i [newline:1]
    dzm elS
el2, jsp entGet
    SKIP_NEXT_IF_DIFFERENT [1]
    jmp el2s
    jmp el2n
el2s, dzm i [elCol:EX_BANK]
    // the mode is the type, 0 to 3, as the memo's characters, blank ! " #.
    // Any other type a program gave its file is *.
    lac mtEnt+FS_DEINFO
    and [FS_ITYPE]
    dac elT
    sub [4]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp elStar
    lac elT
    add [040]
    jmp elMc
elStar, law 052
elMc, lia
    jsp i [elPut:EX_BANK]
    jsp i [elTab:EX_BANK]
    jsp nmUnp
    lac nmSp
    SKIP_NEXT_IF_SAME nmLen
    jmp elTwo
    // one subname types @, then it
    lio [CH_AT]
    jsp i [elPut:EX_BANK]
    jsp i [elTab:EX_BANK]
    dzm i [erA:EX_BANK]
    lac nmLen
    dac i [erB:EX_BANK]
    jsp i [elRng:EX_BANK]
    jmp elBk
elTwo, dzm i [erA:EX_BANK]
    lac nmSp
    dac i [erB:EX_BANK]
    jsp i [elRng:EX_BANK]
    jsp i [elTab:EX_BANK]
    lac nmSp
    add [1]
    dac i [erA:EX_BANK]
    lac nmLen
    dac i [erB:EX_BANK]
    jsp i [elRng:EX_BANK]
elBk, jsp i [elTab:EX_BANK]
    lio mtEnt+FS_DEALLOC
    jsp i [elNum:EX_BANK]
    jsp i [newline:1]
el2n, idx elS
    SKIP_NEXT_IF_SAME [FS_NENT]
    jmp el2
    jmp i elX

// entGet -- read slot elS of the selected handle's directory into mtEnt, as TECO shows
// it, with a pending rename's new name, and its mode when it gives one.
// elS is the slot.
// AC is 0 for a free slot, 1 for a file, and 2 for one not shown, whose blocks count as
// free.
// One not shown is a file whose deletion is pending, or the output's scratch file, its
// allocation in mtEnt then the blocks not yet written.
// AC is the result, IO is not preserved.
// A failure leaves by mtFail with the library's message.
// Reached from any bank with the extend window open.
// Called via jsp.
entGet, dac egX
    lac hAdr
    dac mtPb+FS_PHANDLE
    lac elS
    dac mtPb+FS_PINDEX
    lac [mtEnt:.]
    dac mtPb+FS_PDEST
    lac [mtPb:.]
    farjda(fsEntry:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp mtFail
    lac mtEnt
    SKIP_NEXT_IF_AC_ZERO
    jmp egShow
    jmp i egX
egShow, lac i [outOpen:1]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp egR
    lac i [outHnd:1]
    SKIP_NEXT_IF_SAME hIdx
    jmp egR
    lac i [FD_OUT+FS_FSLOT]
    SKIP_NEXT_IF_SAME elS
    jmp egR
    // its words written, those in the output's block, and a half word
    lac i [FD_OUT+FS_FLEN]
    add i [wrIdx:1]
    add i [wrHalf:1]
    add [MTWDS-1]
    sar 8s
    dac egT
    lac mtEnt+FS_DEALLOC
    sub egT
    dac mtEnt+FS_DEALLOC
    law 2
    jmp i egX
egR, lio elS
    jsp trFind
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp egPd
    add [RN_SIX]
    dac egPend
    lac i egPend
    dac mtEnt
    idx egPend
    lac i egPend
    dac mtEnt+1
    idx egPend
    lac i egPend
    dac mtEnt+2
    lac trfP
    add [RN_MODE]
    dac egPend
    lac i egPend
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp egPd
    sub [1]
    dac egT
    lac mtEnt+FS_DEINFO
    and [FS_IRO+FS_IAPP]           // all but the type
    ior egT
    dac mtEnt+FS_DEINFO
egPd, lac elS
    add hPend
    dac egPend
    lac i egPend
    SKIP_NEXT_IF_AC_ZERO
    jmp .+3
    law 1
    jmp i egX
    law 2
    jmp i egX

// nmUnp -- unpack mtEnt's name, 9 sixbit characters, into mtNmCh, one a word.
// Reads mtEnt.
// nmLen is the characters before the trailing blanks, and nmSp the first blank before
// them, or nmLen when there is none.
// Does not preserve AC or IO.
// Reached from any bank with the extend window open.
// Called via jsp.
nmUnp, dac nuX
    dzm nuI
    lio mtEnt
    jsp nu3
    lio mtEnt+1
    jsp nu3
    lio mtEnt+2
    jsp nu3
    law MT_NAMEC
    dac nmLen
nuL, lac nmLen
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp nuS
