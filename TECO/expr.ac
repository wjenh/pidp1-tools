// cAt -- /@, TECO's running time in 60ths of a second, from the
// clock's total of milliseconds, ckHi and ckLo, times 60 over 1,000.
// Does not preserve AC or IO.
// Entered by jmp from the dispatch, ends by jmp rsLoop.
cAt, jsp clkTick
    lac ckLo
    and [07777]
    dac ra+2
    lac ckLo
    rar 9s
    rar 3s
    and [077]
    dac atT
    lac ckHi
    ral 6s
    and [07700]
    ior atT
    dac ra+1
    lac ckHi
    rar 6s
    and [07777]
    dac ra
    dzm rb
    dzm rb+1
    law AT_HZ
    dac rb+2
    jsp mul36
    law CLK_HZ
    dac rb+2
    jsp div36
    jsp opnd
    jmp rsLoop

