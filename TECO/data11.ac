// data11.ac -- the second command set's data, at D11_DATA, bank 9's top 1,024 words,
// taken from q-register text (teco.ah's QR_END).
// It holds the set's dispatch, its error messages, VT100 mode's greeting, its search
// string and the ^E constructs' table.
// Nothing here is code, and every word is read through a full address
// ([name:D11_BANK]), so it need not share bank 14 with the code that reads it.
// Assembled after bank 14, with teco.ah and search11.ac's EK_ defines in force.
// Every handler named is tagged with its bank.

    assert . == D11_DATA-D11_BANK*010000, "the second set's data starts at D11_DATA"

// The error messages, by code, EC_ILL first.
// They are TECO C's, with a % where the argument goes.
msgTab, mILL:D11_BANK
    mUTC:D11_BANK
    mPOP:D11_BANK
    mDTB:D11_BANK
    mSRH:D11_BANK
    mNAC:D11_BANK
    mNAE:D11_BANK
    mNAU:D11_BANK
    mIQN:D11_BANK
    mIIA:D11_BANK
    mILN:D11_BANK
    mIRA:D11_BANK
    mIEC:D11_BANK
    mIFC:D11_BANK
    mIUC:D11_BANK
    mNAB:D11_BANK
    mMEM:D11_BANK
    mPDO:D11_BANK
    mXAB:D11_BANK
    mBNI:D11_BANK
    mSNI:D11_BANK
    mNAS:D11_BANK
    mNAQ:D11_BANK
    mIQC:D11_BANK
    mTAG:D11_BANK
    mMAP:D11_BANK
    mUTM:D11_BANK
    mNAP:D11_BANK
    mPES:D11_BANK
    mISA:D11_BANK
    mICE:D11_BANK
    mISS:D11_BANK
    mSTL:D11_BANK
    mNFI:D11_BANK
    mNFO:D11_BANK
    mOFO:D11_BANK
    mYCA:D11_BANK
    mNYA:D11_BANK
    mIFN:D11_BANK
    mDEV:D11_BANK
    mNPA:D11_BANK
    mFNF:D11_BANK
    mFUL:D11_BANK
    mWLO:D11_BANK
    mFER:D11_BANK
    mUNA:D11_BANK
    assert . - msgTab == EC_LAST, "a message for every error code"
mILL, ascii "ILL   Illegal command \042%\042"
    0
mUTC, ascii "UTC   Unterminated command"
    0
mPOP, ascii "POP   Attempt to move pointer off page with \042%\042"
    0
mDTB, ascii "DTB   Delete too big"
    0
mSRH, ascii "SRH   Search failure \042%\042"
    0
mNAC, ascii "NAC   No argument before ,"
    0
mNAE, ascii "NAE   No argument before ="
    0
mNAU, ascii "NAU   No argument before U"
    0
mIQN, ascii "IQN   Illegal Q-register name \042%\042"
    0
mIIA, ascii "IIA   Illegal insert argument"
    0
mILN, ascii "ILN   Illegal number"
    0
mIRA, ascii "IRA   Illegal radix argument to ^R"
    0
mIEC, ascii "IEC   Illegal character \042%\042 after E"
    0
mIFC, ascii "IFC   Illegal character \042%\042 after F"
    0
mIUC, ascii "IUC   Illegal character \042%\042 following ^"
    0
mNAB, ascii "NAB   No argument before ^_ "
    0
mMEM, ascii "MEM   Memory overflow"
    0
mPDO, ascii "PDO   Push-down list overflow"
    0
mXAB, ascii "XAB   Execution aborted"
