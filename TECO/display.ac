// The WAIT program, the word in the screen's center, drawn by the 340 on its own while
// a library call keeps the CPU.
// Its jump reaches banks 0 and 1 only, so it stays here.
// The invisible vectors only pace it, so it steals few cycles.
wtProg, scale(2) intensity(DPY_INTEN) charsets(2) lpoff next(point)
    y(DPY_WAITY) next(point)
    x(DPY_WAITX) next(character)
    type340 "\UWAIT"
    scale(0) next(vector)
    up deltay(0d127)
    down deltay(0d127)
    up deltay(0d127)
    down deltay(0d127)
    up deltay(0d127)
    down deltay(0d127)
    up deltay(0d127)
    down deltay(0d127) end
    next(subroutine)
    jump (wtProg|thisbank) next(parameter)
endloc

dpyHlt, halt                // where the 340 is sent to stop
dpySize, 0                  // n/D, 0 to 3
dpyLines, 0                 // n/N, the lines each side of the pointer at idle
dpyHeld, 0                  // DH_V or DH_U while the string has ended with V or /U
dpyA, 0                     // V's range, and the idle display's
dpyB, 0
dpyUnit, 0                  // /U's unit
dpyOn, 0                    // not 0 while dpyTick starts the list again
dpyNo, 0                    // no display and no WAIT, 1 after the second set's 0W, ior
                            // VT_DPYNO while its screen is split (vt11.ac), ior
                            // VT_SWNO for a session in VT100 mode (switch 2)
dpyBar, 0                   // the bar's vector word, a full address; 0 for none
tcArg, 0                    // mtCall's argument

