    lac tcArg
    dac i tcFn
    jsp i tcGo
    eem
    dac tcA
    dio tcI
    dzm dpyOn               // not again until idle
    lio [dpyHlt:.]
    dla
    lac tcA
    lio tcI
    jmp i tcRet

