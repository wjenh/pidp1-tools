    sub dPitch
    dac dYc
    jmp ruK
ruTop, lac dYtop
    dac dYc
ruK, jsp kCalc
    jmp i ruX

// colUp -- move the cursor a column right; its x follows from dCol (dXcOf).
// Has no arguments and no return values.
// AC is not preserved, IO is preserved.
// Called via jsp.
colUp, dac cuX
    idx dCol
    jmp i cuX

// kCalc -- set dKeep to 1 while the list has room and the cursor's row is one drawn,
// dFirst to dFirst+dRows-1, else to 0.
// Has no arguments and no return values.
// AC is not preserved, IO is preserved.
// Called via jsp.
kCalc, dac kcX
    dzm dKeep
    lac dFull
    SKIP_NEXT_IF_AC_ZERO
    jmp i kcX
    lac dRow
    sub dFirst
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp i kcX
    sub dRows
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i kcX
