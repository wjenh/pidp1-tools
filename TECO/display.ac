    jmp i nmX

// dDig -- draw the digit of nmV in a place and take it off nmV.
// The digit is not drawn while it would be a leading zero (nmZ 0).
// IO is the place, 100, 10 or 1.
// No return value; nmV and nmZ are changed.
// Does not preserve AC or IO.
// Called via jsp.
dDig, dac ngX
    dio ngP
    dzm ngK
    lac nmV
    sub ngP
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp .+4
    dac nmV
    idx ngK
    jmp .-6
    lac ngK
    ior nmZ
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i ngX
    law 1
    dac nmZ
    lac ngK
    add [CH_ZERO]
    lia
    jsp dChar
    jmp i ngX

