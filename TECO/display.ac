duChart, jsp dNl
duPad, lac dRow
    sub [DPY_UCHART]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp duLst
    lio [CH_LF]
    jsp dChar
    jmp duPad
duLst, dzm duF
    dzm duS
duL2, lac duS
    dac i [elS:MT_BANK]
    jsp i [entGet:MT_BANK]
    SKIP_NEXT_IF_SAME [1]
    jmp duN2
    idx duF
    lia
    jsp dNum
    lio [040]
    jsp dChar
    lio duF
    jsp duCh
    lia
    jsp dChar
    lio [CH_TAB]
    jsp dChar
