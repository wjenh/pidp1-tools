duStar, law 052
duMc, lia
    jsp dChar
    lio [CH_TAB]
    jsp dChar
    jsp i [nmUnp:MT_BANK]
    lac i [nmSp:MT_BANK]
    SKIP_NEXT_IF_SAME i [nmLen:MT_BANK]
    jmp duTwo
    lio [CH_AT]
    jsp dChar
    lio [CH_TAB]
    jsp dChar
    dzm duA
    lac i [nmLen:MT_BANK]
