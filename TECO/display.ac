// display.ac -- the Type 340 display.
// It builds the list in bank 11 from the buffer at every idle (dpyShow), and every wait
// starts the list again once it stops (dpyTick).
// It also holds V, VW, n/N, n/D and /U, and the WAIT program a Microtape call shows
// (mtCall).
// Sense switch 5 (SW_DPY) on turns the 340 off, so no list is built and none is started.
// The switch is read at every idle, in every wait and before VW and WAIT.
// The second set's 0W (dpy11.ac), its split screen and VT100 mode (vt11.ac) set dpyNo,
// which idle (teco.am1) and mtCall read alike.
//
// The list is character mode, both sets (charsets(2)).
// A row starts with a parameter word, a y point word and an x point word that enters
// character mode, then the codes three to a word, a shift before each change of set,
// and the end code.
// A row is the screen's, from DPY_LEFT in, and a line too long goes on in the
// next one.
// The pointer's bar is a vector after its point words, one scale step left of the
// character after the pointer, in the gap between two characters or, in column 0, in
// the margin.
// dpyTick turns its visible bit on and off with the clock's half second.
// The list ends in a halt.
//
// Characters are as the memo has them.
// Space, TAB, CR and LF act as such.
// Every other non-printing character, BELL, @ and DEL among them (in neither set), is a
// down arrow and its code in octal as a subscript.
// 0136 and 0137 are 1965 ASCII's up and left arrows, from set 2.
// The grave is set 2's accent over a space, so it keeps its place.
//
// Handlers are entered by jmp from the dispatch (interp.ac, in bank 0) and end by
// jmp i [rsLoop:0]; an error is jmp i [err:0].
// Routines are called via jsp with the extend window open and return by jmp i.
// Addresses kept in words are full 16-bit ones.
// The file goes in bank 1, where the WAIT program's jump can reach it.
// Its data words follow its code, and the resume points of a build (dRec) are in bank
// 13 (DPY_RING).
// Needs teco.ah, <AIDS/skipmacros.ah>, <TYPE340/type340defs.ah>,
// <MICROTAPE/microtape.ah>, pollc and brkChk (termio.ac); in bank 0 dot, zz, gs, ge,
// range and its a2M and a2N, argOr, have, fromInt, opnd, peekCh, srcPos, clkTick and
// ckLo; in bank 12 unitO, hGet, hAdr, entGet, elS, mtEnt, nmUnp, mtNmCh, nmLen and nmSp
// (tapefile.ac).

local diX, dsX, dtX, dtW, dtSet, dtGo, dwX, dwV, dwU, dwGo, dbX, dbB, dbT, dbS, \
    dbF, dbR, dbNx, dbDr, dbJ, dbK, dbQ, dbP, dkX, dkEv, dkRe, dkH, dkL, dkGo, dkUn, \
    dkPk, dkSet, dkSl, dkI, dkSeg, dkN, dkNx, dkStp, mnX, mnC, paX, paI, paT, paB, \
    atX, atH, sbX, sbI, sbC, sbL, sbR, sbE, sbTr, xcX, hlX, reX, reI, reP, \
    dpX, dpS, dpD, dmX, dmP, dmQ, dmK, dmL, dgX, dgS, dgW, dnX, \
    lpX, cpX, cpC, roX, rcX, rcPad, gpX, gpE, gpGo, gpC, gpSp, dcX, dcC, dcP, dcE, \
    dcW, dcK, dcG, dcJ, dcCtl, dcTab, dcCr, dcLf, dcGrv, dcGn, dcD2, dcD1, dcD0, \
    dcCa, dcCu, wrX, wrW, wrNew, ruX, ruTop, ruK, kcX, cuX, nlX, duB, duC, \
    duX, duP, duN, duK, duZ, duZe0, duBig, duF, duS, duL, duM, duNx, duE, duQ, \
    duCell, duFree, duDir, duPut, duChart, duPad, duLst, duL2, duN2, duTwo, duBk, \
    duMode, duStar, duMc, duA, duZe, dhX, dhN, dhL, drX, drL, nmX, nmV, nmZ, ngX, ngP, ngK, \
    cvV, cvW, cvK, cdT, cnBig, tcRet, tcFn, tcGo, tcA, tcI, wtProg

// dpyInit -- set the display as at the start, at size 1 with DPY_LINES lines a side,
// nothing held and the 340 stopped.
// Has no arguments and no return values.
// Does not preserve AC or IO.
// Called via jsp, from any bank with the extend window open.
dpyInit, dac diX
    law 1
    dac dpySize
    law DPY_LINES
    dac dpyLines
    dzm dpyHeld
    jsp dpyStop
    jmp i diX

// dpyStop -- send the 340 to a halt word, and clear dpyOn so dpyTick does not start
// the list again.
// Has no arguments and no return values.
// Does not preserve AC or IO.
// Called via jsp, from any bank with the extend window open.
dpyStop, dac dsX
    dzm dpyOn
    lio [dpyHlt:.]
    dla
    jmp i dsX

// dpyTick -- once the list has stopped, at its halt or at an edge, start it again,
// with the pointer's bar drawn in the first half of each 1,024 ms of the clock's total
// and not in the second.
// The clock is not read here, as its readers time their intervals.
// With the display's switch on, it never starts the list again, which runs to its halt
// and stays there.
// Has no arguments and no return values.
// Does not preserve AC or IO.
// Called via jsp, in every wait (termio.ac).
dpyTick, dac dtX
    szs SW_DPY*010          // skip if the display's switch is off
    dzm dpyOn
    lac dpyOn
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i dtX
    dss dsv dsh             // skip once the list has stopped
    jmp i dtX
    lac dpyBar
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dtGo
    lac i dpyBar
    and [0577777]           // visible off
    dac dtW
    lac i [ckLo:0]
    and [DPY_FLASH]
    SKIP_NEXT_IF_AC_ZERO
    jmp dtSet
    lac dtW
    ior [visible]
    dac dtW
dtSet, lac dtW
    dac i dpyBar
dtGo, lio [DPY_BASE]
    dla
    jmp i dtX

// dpyShow -- at every idle, build in bank 11 and start the display the last command
// string leaves.
// That is V's range or /U's directory when the string ended with one, else dpyLines
// lines each side of the pointer and the pointer's line, the range lnTo would give,
// which dpyBuf finds as it goes.
// The hold is used up.
// With the display's switch on, nothing is built or started, and dpyTick stops what
// still runs.
// Has no arguments and no return values.
// Does not preserve AC or IO.
// Called via jsp, from any bank with the extend window open.
dpyShow, dac dwX
    lac dpyHeld
    dzm dpyHeld
    szs SW_DPY*010          // skip if the display's switch is off
    jmp i dwX
    SKIP_NEXT_IF_DIFFERENT [DH_U]
    jmp dwU
    dzm dLfN
    SKIP_NEXT_IF_DIFFERENT [DH_V]
    jmp dwV
    dzm dpyA
    lac i [zz:0]
    dac dpyB
    lac dpyLines
    add [1]
    dac dLfN
dwV, jsp dpyBuf
    jmp dwGo
dwU, jsp dpyDir
dwGo, law 1
    dac dpyOn
    lio [DPY_BASE]
    dla
    jmp i dwX

// dpyBuf -- build the list of the buffer from dpyA up to dpyB at size dpySize, with the
// pointer's bar where it falls.
// With dLfN not 0, it shows only dLfN line feeds each side of the pointer within those
// bounds, as lnTo counts them.
// When there are more rows than the screen holds, it shows as many as it holds,
// centered on the pointer's row, or the last screenful when that is further up, and
// with no pointer in the range, the first rows.
// Its arguments are dpyA, dpyB, dpySize and dLfN.
// No return value.
// Does not preserve AC or IO.
// Called via jsp.
dpyBuf, dac dbX
    lio dpySize
    jsp dGeom
    dzm dFirst
    dzm dbF
    lac dpyA
    dac dbS
    // the pointer in the range and before the buffer's end has a row to center on
    dzm sbTr
    lac i [dot:0]
    sub i [zz:0]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp dbB
    lac i [dot:0]
    sub dpyA
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp dbB
    lac dpyB
    sub i [dot:0]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp dbB
    law 1
    dac sbTr
dbB, lac sbTr
    ior dLfN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dbDr                // V's range with no pointer in it, so from dpyA
    jsp dBack
    dac dbS
    lac sbTr
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dbDr                // the pointer at the buffer's end, so the first rows
    // a pointer to center on takes two walks; the first counts rows, drawing nothing,
    // from where the screen cannot be changed by starting further back (dBack) to as
    // far past the pointer as dFirst needs; the second draws from the last resume
    // point (dRec) at or above row dFirst to the screen's last row
    // the count, its start the first resume point
    lac dbS
    dac i [DPY_RING]
    dzm i [DPY_RING+1]
    law 1
    dac dRngI
    dac dRngN
    dac dCnt
    lac [0377777]
    dac dFirst              // no row drawn
    dac dStop
    dzm dRow
    dzm dRun
    dzm dKeep
    dzm dFull
    dzm dLfB
    lac dbS
    dac dkI
    jsp dWalk
    dzm dCnt
    dzm dFirst
    lac dRow
    sub dRows
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp dbDr                // every row fits
    lac dPRow
    sub dHalf
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp .+2
    jmp dbDr                // the pointer's row in the first half, so the first rows
    dac dFirst
    // no further than the last screenful, of dRow+1 rows in all
    lac dRow
    sub dRows
    add [1]
    dac dbT
    lac dFirst
    sub dbT
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp .+3                 // dFirst short of the last screenful is kept
    lac dbT
    dac dFirst
    // the newest resume point at or above row dFirst; the count's start if none is
    // left in the ring
    lac dRngN
    cma
    dac dbK
    lac dRngI
    dac dbJ
dbR, lac dbJ
    SKIP_NEXT_IF_AC_NOT_ZERO
    lac [DPY_RINGN]
    sub [1]
    dac dbJ
    add dbJ
    add [DPY_RING]
    dac dbP
    add [1]
    dac dbQ
    lac i dbQ
    sub dFirst
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp dbNx
    lac i dbQ
    dac dbF
    lac i dbP
    dac dbS
    jmp dbDr
dbNx, isp dbK
    jmp dbR
dbDr, lio [DPY_END]
    jsp dBegin
    lac dbF
    dac dRow
    jsp kCalc
    lac dFirst
    add dRows
    dac dStop               // the first row not drawn ends the walk (rowUp)
    lac dbS
    dac dkI
    jsp dWalk
    jsp dEnd
    jmp i dbX

// dBack -- find where the walk starts, back from the pointer to just after the
// dLfN-th line feed before it (none when 0), or dpyA, as lnTo finds the start.
// With a pointer's row to center on (sbTr), it stops sooner, just after a CR LF at
// least dRows+1 line feeds back.
// The column is 0 there however far back the walk starts, and with the pointer's line
// at least dRows rows down, the rows dpyBuf draws are the same.
// Its arguments are dpyA, dLfN, sbTr and dRows.
// AC is the result, IO is not preserved.
// Called via jsp.
dBack, dac sbX
    lac i [dot:0]
    dac sbI
    dzm sbC
sbL, lac sbI
    sub dpyA
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp sbR
    lac dpyA
    jmp i sbX
sbR, lac sbI
    sub [1]
    dac sbI
    lia
    jsp dAt
    lai
    SKIP_NEXT_IF_SAME [CH_LF]
    jmp sbL
    idx sbC
    SKIP_NEXT_IF_DIFFERENT dLfN
    jmp sbE                 // the dLfN-th
    lac sbTr
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sbL
    lac sbC
    sub dRows
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp .+2
    jmp sbL                 // not dRows+1 back yet
    lac sbI
    sub dpyA
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp .+2
    jmp sbL                 // nothing before it in the range
    lac sbI
    sub [1]
    lia
    jsp dAt
    lai
    SKIP_NEXT_IF_SAME [CH_CR]
    jmp sbL
sbE, lac sbI
    add [1]
    jmp i sbX

// dWalk -- draw the text from index dkI up to dpyB through dChar, the cursor in row
// dRow at column 0 at the start.
// A glyph that fits in its row goes the short way here, as dChar and gPut would draw
// it.
// It ends sooner when rowUp or a line feed asks (dHalt).
// Its arguments are dkI and dRow.
// No return value.
// Does not preserve AC or IO.
// Called via jsp.
dWalk, dac dkX
    dzm dkStp
    dzm dCol
    // the text is read in runs, each to its next event, which is the pointer, where
    // dPtr is called, the gap, which the reading jumps, or the end; dkN counts a run's
    // characters up to 0
dkEv, lac dkStp             // an event at dkI, its character not yet read
    SKIP_NEXT_IF_AC_ZERO
    jmp i dkX
    lac dkI
    SKIP_NEXT_IF_DIFFERENT i [dot:0]
    jsp dPtr
    lac dkStp
    SKIP_NEXT_IF_AC_ZERO
    jmp i dkX
    lac dkI
    sub dpyB
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i dkX               // the end
    lac dpyB
    dac dkSeg
    lio i [gs:0]
    jsp dkMin
    lio i [dot:0]
    jsp dkMin
    lac dkI
    sub dkSeg
    sub [1]
    dac dkN
    lio dkI
    jsp dPlace
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp dkH
    jmp dkL
dkH, isp dkN                // an even place, the word's high half
    jmp .+2
    jmp dkRe
    lac i dRdP
    rar 9s
    and [0177]
    lia
    lac [dkL|thisbank]
    dac dkNx
    jmp dkGo
dkL, isp dkN                // an odd place, the low half, then the next word
    jmp .+2
    jmp dkRe
    lac i dRdP
    and [0177]
    lia
    idx dRdP
    lac [dkH|thisbank]
    dac dkNx
dkGo, dio dcC
    lai
    add [dsTab:DT_BANK]
    dac dcP
    lac i dcP
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp dkSl                // TAB, CR, LF, the grave, a control
    dac dcE
    lac dCol
    sub dCols
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp dkSl                // a new row first
    lac dKeep
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dkUn
    lac dRun
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dkSl                // no run open
    lac dcE
    and [0300]
    SKIP_NEXT_IF_AC_ZERO
    jmp dkSet
dkPk, lac dcE               // as cPut packs it, three to a word
    and [077]
    dac cpC
    lac dW
    ral 6s
    ior cpC
    dac dW
    idx dN
    SKIP_NEXT_IF_SAME [3]
    jmp dkUn
    lio dW
    jsp lPut
    dzm dW
    dzm dN
dkUn, idx dCol
    jmp i dkNx
dkSet, sar 6s               // the glyph's set is the run's, or dChar shifts
    SKIP_NEXT_IF_SAME dShift
    jmp dkSl
    jmp dkPk
dkSl, lio dcC
    jsp dChar
    jmp i dkNx
dkRe, lac dkSeg             // the run's end
    dac dkI
    jmp dkEv

// dkMin -- make dkSeg IO when IO is past dkI and short of dkSeg.
// IO is an index.
// No return value.
// AC is not preserved, IO is preserved.
// Called via jsp.
dkMin, dac mnX
    dio mnC
    lac dkI
    sub mnC
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i mnX
    lac mnC
    sub dkSeg
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i mnX
    dio dkSeg
    jmp i mnX

// dPlace -- set dRdP to the word of the text holding index IO.
// IO is the index.
// AC is negative when the character is the word's low half (an odd place), as
// buffer.ac's gch has it.
// AC is the result, IO is preserved.
// Called via jsp.
dPlace, dac paX
    dio paI
    lac paI
    sub i [gs:0]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp paB
    add i [ge:0]
    jmp .+2
paB, lac paI
    rar 1s
    dac paT
    and [PK_WORD]
    add [BUF_BASE]
    dac dRdP
    lac paT
    jmp i paX

// dAt -- read the character at an index of the text, as bGet has it, without the far
// call.
// IO is the index.
// IO is the character on return, AC is not preserved.
// Called via jsp.
dAt, dac atX
    jsp dPlace
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp atH
    lac i dRdP
    and [0177]
    lia
    jmp i atX
atH, lac i dRdP
    rar 9s
    and [0177]
    lia
    jmp i atX

// dHalt -- end the walk at its next event, by making the run's count its last.
// Has no arguments and no return values.
// AC is not preserved, IO is preserved.
// Called via jsp.
dHalt, dac hlX
    law 1
    dac dkStp
    lac [-1]
    dac dkN
    jmp i hlX

// dRec -- in the count (dCnt), after a line feed, when the column is 0, record the
// next index and its row as a resume point, the newest of DPY_RINGN kept in bank 13.
// Its arguments are the walk's dkStp, dkSeg, dkN, dCol and dRow.
// No return value.
// AC is not preserved, IO is preserved.
// Called via jsp.
dRec, dac reX
    lac dkStp
    ior dCol
    SKIP_NEXT_IF_AC_ZERO
    jmp i reX
    lac dkSeg               // the line feed's index is dkSeg plus dkN
    add dkN
    add [1]
    dac reI
    lac dRngI
    add dRngI
    add [DPY_RING]
    dac reP
    lac reI
    dac i reP
    idx reP
    lac dRow
    dac i reP
    lac dRngI
    add [1]
    and [DPY_RINGN-1]
    dac dRngI
    lac dRngN
    sub [DPY_RINGN]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i reX
    idx dRngN
    jmp i reX
    assert (DPY_RINGN & (DPY_RINGN-1)) == 0, "the ring of resume points is a power of 2"
    // more rows than that, size 0's, can leave none at or above dFirst, and the walk
    // then starts at the count's start, slower, the same rows drawn
    assert DPY_RINGN > DG_ROWS(2), "the ring keeps a point above size 1's first row"
    assert DPY_RING >= WRBUF+0400 && DPY_RING+2*DPY_RINGN <= 0160000, "the ring is in bank 13's free end"

// dPtr -- at the pointer, unless it is at the buffer's end, record its row and arm the
// range's end dLfN line feeds on (dcLf).
// In the count, it sets the row where counting may stop, or stops the walk now when
// the pointer's row is in the first half.
// Otherwise it draws the bar at the cursor.
// Has no arguments and no return values.
// Does not preserve AC or IO.
// Called via jsp.
dPtr, dac dpX
    lac i [dot:0]
    sub i [zz:0]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i dpX
    lac dRow
    dac dPRow
    lac dLfN
    SKIP_NEXT_IF_AC_ZERO
    cma
    dac dLfB
    lac dCnt
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dpD
    lac dRow
    sub dHalf
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp dpS
    jsp dHalt
    jmp i dpX
dpS, add dRows              // dpyBuf's dFirst is fixed once dRow-dRows+1 reaches it
    sub [1]
    dac dStop
    jmp i dpX
dpD, lac dKeep
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i dpX
    jsp rClose
    lio [next(point)]
    jsp lPut
    lac dYc
    ior [y(0)|next(point)]
    lia
    jsp lPut
    // a scale step left of the next character, in the gap after the last or, in
    // column 0, in the margin, which is wider than any step
    jsp dXcOf
    sub dF
    ior [next(vector)]
    lia
    jsp lPut
    lac dP
    dac dpyBar
    lio [visible|up|deltay(DPY_BARH)]
    jsp lPut
    lio [down|deltay(DPY_BARH)|end]
    jsp lPut
    jmp i dpX

// dXcOf -- compute the cursor's x, the margin and dCol characters.
// Its arguments are dCol and dChW.
// AC is the result, IO is not preserved.
// Called via jsp.
dXcOf, dac xcX
    lac dCol
    mul dChW
    scr 1s                  // mul leaves the product shifted left one in AC:IO
    lai
    add [DPY_LEFT]
    jmp i xcX

// dGeom -- load the geometry of a size into dSize and dF to dHalf (dgTab).
// IO is the size, 0 to 3.
// No return value.
// AC is not preserved, IO is preserved.
// Called via jsp.
dGeom, dac dmX
    dio dSize
    lac dSize
    sal 3s
    sub dSize               // 7 words a size
    add [dgTab:DT_BANK]
    dac dmP
    lac [dF:.]
    dac dmQ
    law 7
    cma
    dac dmK
dmL, lac i dmP
    dac i dmQ
    idx dmP
    idx dmQ
    isp dmK
    jmp dmL
    jmp i dmX

// dBegin -- begin a new list, with the emitter at row 0, column 0, no run and no bar,
// and the list's first word the parameter word of size dSize.
// dYc is row 0's y, right when dFirst is 0 (rowUp sets it at dFirst).
// dpyTick does not start the list again until the build that clears dpyOn here sets
// it, so a list a break leaves unfinished (rowUp) is never started.
// IO is the full address the list's words end below.
// No return value.
// Does not preserve AC or IO.
// Called via jsp.
dBegin, dac dgX
    dzm dpyOn
    dio dHard
    lac dHard
    sub [1]
    dac dHard
    sub [DPY_ROOM]
    dac dLim
    lac [DPY_BASE]
    dac dP
    dzm dFull
    dzm dW
    dzm dN
    dzm dRun
    dzm dShift
    dzm dRow
    dzm dCol
    dzm dCnt
    dzm dLfB
    lac [0377777]
    dac dStop
    dzm dpyBar
    lac [-1]
    dac dPRow
    lac dYtop
    dac dYc
    jsp kCalc
    // size 0 dimmer (DPY_INTEN0), as its glyphs are smaller and closer, so brighter
    // to the eye
    lac dSize
    SKIP_NEXT_IF_AC_ZERO
    jmp dgS
    lac [0100|intensity(DPY_INTEN0)|charsets(2)|lpoff]
    jmp dgW
dgS, sal 4s
    ior [0100|intensity(DPY_INTEN)|charsets(2)|lpoff]
dgW, lia
    jsp lPut
    jmp i dgX

// dEnd -- end the list, closing the run, then adding the halt, which always has its
// word.
// Has no arguments and no return values.
// Does not preserve AC or IO.
// Called via jsp.
dEnd, dac dnX
    jsp rClose
    lio [halt]
    dio i dP
    jmp i dnX

// lPut -- put a word into the list.
// Past dLim the list is full, and nothing more is drawn, though what is open is still
// closed; past dHard nothing is stored.
// IO is the word.
// No return value.
// AC is not preserved, IO is preserved.
// Called via jsp.
lPut, dac lpX
    lac dP
    sub dHard
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i lpX
    dio i dP
    idx dP
    sub dLim
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp i lpX
    law 1
    dac dFull
    dzm dKeep
    jmp i lpX

// cPut -- pack a character code into the word being packed, three to a word, the first
// in the high bits; a full word goes to the list.
// IO is the code, 0 to 077.
// No return value.
// Does not preserve AC or IO.
// Called via jsp.
cPut, dac cpX
    dio cpC
    lac dW
    ral 6s                  // below 2^12, so nothing wraps round
    ior cpC
    dac dW
    idx dN
    SKIP_NEXT_IF_SAME [3]
    jmp i cpX
    lio dW
    jsp lPut
    dzm dW
    dzm dN
    jmp i cpX

// rOpen -- begin a run of characters at the cursor, unless one is open.
// The beam is placed by point words, y first, which costs nothing unlit, then x into
// character mode, and the shift is unknown.
// Has no arguments and no return values.
// Does not preserve AC or IO.
// Called via jsp.
rOpen, dac roX
    lac dRun
    SKIP_NEXT_IF_AC_ZERO
    jmp i roX
    lio [next(point)]
    jsp lPut
    lac dYc
    ior [y(0)|next(point)]
    lia
    jsp lPut
    jsp dXcOf
    ior [next(character)]
    lia
    jsp lPut
    law 1
    dac dRun
    dzm dShift
    jmp i roX

// rClose -- end the open run, if any, with the end code, and pad the last word out.
// The 340 is then in parameter mode.
// Has no arguments and no return values.
// Does not preserve AC or IO.
// Called via jsp.
rClose, dac rcX
    lac dRun
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i rcX
    dzm dRun
    lio [037]
    jsp cPut
rcPad, lac dN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i rcX
    cli
    jsp cPut
    jmp rcPad

// gPut -- draw a glyph at the cursor, when the cursor's row is drawn, with a shift
// first when the set changes.
// A space with no run open is not drawn, and the next run starts past it.
// The cursor does not move.
// IO is the glyph's dsTab entry, its set in bits 0300 and its code in 077.
// No return value.
// Does not preserve AC or IO.
// Called via jsp.
gPut, dac gpX
