    jmp i nlX

// dNum -- draw a count in decimal at the cursor, with no leading zeros.
// IO is the count, 0 to 999.
// No return value.
// Does not preserve AC or IO.
// Called via jsp.
dNum, dac nmX
    dio nmV
    dzm nmZ
    lio [0d100]
