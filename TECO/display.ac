    jsp duCh
    jmp duPut
duFree, law 040
    jmp duPut
duDir, law DPY_UDIR
duPut, lia
    jsp dChar
    idx duB
    idx duC
    SKIP_NEXT_IF_SAME [DPY_UCELLS]
    jmp duCell
    dzm duC
    jsp dNl
    jmp duCell
