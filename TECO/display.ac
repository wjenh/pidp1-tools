    jmp gpC                 // in both sets
    SKIP_NEXT_IF_DIFFERENT dShift
    jmp gpC
    dac dShift
    add [034]               // set 1 is the upper shift, 035; set 2 the lower, 036
    lia
    jsp cPut
gpC, lac gpE
    and [077]
    lia
    jsp cPut
    jmp i gpX
gpSp, lac dRun
    SKIP_NEXT_IF_AC_ZERO
    jmp gpGo
    jmp i gpX

