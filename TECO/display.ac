    dac i [elS:MT_BANK]
    jsp i [entGet:MT_BANK]
    SKIP_NEXT_IF_SAME [1]
    jmp duNx
    idx duF
    lac duE
    add [FS_DEFIRST]
    dac duQ
    lac i duQ
    dac duB
    lac duE
    add [FS_DEALLOC]
    dac duQ
    lac i duQ
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp duNx
    cma
    dac duK
duM, lac duB
    sub duN
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp duNx                // past the tape's end
    lac duB
    add [DPY_MAP]
    dac duQ
    lac duF
    dac i duQ
    idx duB
    isp duK
    jmp duM
